<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>ch.obya.psd2</groupId>
    <artifactId>psd2-sandbox</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>bank-xs2a</artifactId>
  <name>Bank XS2A application</name>
  <!-- The runnable Bank. Wires the gateway filters, consent management, TPP
       identification and the mock ledger into one process, because the walking
       skeleton needs 4 processes, not 11. Each part is already its own module, so
       splitting one out later is a packaging change rather than a rewrite. -->

  <dependencies>
    <dependency>
      <groupId>ch.obya.psd2</groupId>
      <artifactId>mtls</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>ch.obya.psd2</groupId>
      <artifactId>bank-xs2a-gateway</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>ch.obya.psd2</groupId>
      <artifactId>bank-consent</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>ch.obya.psd2</groupId>
      <artifactId>bank-account-information</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>ch.obya.psd2</groupId>
      <artifactId>pki</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- Boot 4 no longer pulls Jackson in through starter-web. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-json</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
