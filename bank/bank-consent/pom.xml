<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>ch.obya.psd2</groupId>
    <artifactId>psd2-sandbox</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>bank-consent</artifactId>
  <name>Consent management</name>
  <!-- The "Consent management" bounded context: Consent and Authorisation.

       It depends on authorisation-kernel and NOT on bank-payment. The context map
       makes the two a shared kernel - "neither context can be downstream of the
       other" - so the ScaStatus vocabulary and the forward-only transition rule
       come from the kernel, and a bank-consent -> bank-payment dependency is a
       build failure by design. -->

  <dependencies>
    <dependency>
      <groupId>ch.obya.psd2</groupId>
      <artifactId>spec-primitives</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>ch.obya.psd2</groupId>
      <artifactId>authorisation-kernel</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
    </dependency>
  </dependencies>
</project>
