// Model of the PSU account-list journey: PSU, TPP application A,
// OidcProvider (OpenID Connect provider F), Bank B (ASPSP) and the Bank B mobile app.
// Mirrors docs/design/psu-account-list-journey.md sections 3 and 4.

model {

  // ==== people ================================================================

  psu = actor 'PSU' {
    description '
      Payment service user. Holds payment accounts at Bank B and has
      enrolled at least one device with the Bank B app.
    '
  }

  // ==== TPP application A ====================================================

  tppA = softwareSystem 'TPP application A' {
    #tpp-a
    description '
      Third-party provider licensed as AISP and PISP. OAuth2 confidential
      client authenticated by mTLS with its eIDAS QWAC. Creates the consent
      at Bank B, drives the authorization-code flow at F and reads account
      data through the XS2A API.
    '

    frontend = webApp 'Web front end' {
      technology 'SPA / SSR'
      description 'Bank picker, connection status, account list, account details, waiting page while SCA is pending.'
    }

    backend = container 'Back end' {
      technology 'service'
      description 'Consent orchestrator, OAuth2 client and XS2A client behind the front end.'

      bankRegistry = component 'Bank registry' {
        technology 'configuration'
        description 'Registered ASPSPs: id, display name, XS2A base URL, OAuth2 metadata URL, supported consent models, signing requirement.'
      }
      consentOrchestrator = component 'Consent orchestrator' {
        description 'Creates the consent, tracks its status, keeps consentId, authorisationId and the steering hyperlinks per (PSU, bank).'
      }
      oauthClient = component 'OAuth2 client' {
        technology 'RFC 6749, 7636, 8414, 8705'
        description 'Reads AS metadata, generates state and PKCE verifier, exchanges the code with mTLS client authentication, refreshes tokens.'
      }
      xs2aClient = component 'XS2A client' {
        technology 'NextGenPSD2 XS2A 1.3.16'
        description 'Adds X-Request-ID, Consent-ID, Authorization, PSU context headers and optional Digest / Signature.'
      }

      consentOrchestrator -> bankRegistry 'looks up bank endpoints'
      consentOrchestrator -> xs2aClient 'creates consent, reads status'
      consentOrchestrator -> oauthClient 'starts authorization, exchanges code'
    }

    tokenVault = database 'Token vault' {
      technology 'encrypted store'
      description 'Access and refresh tokens keyed by (PSU, bank, consentId).'
    }

    keyMaterial = database 'Key material' {
      technology 'HSM / KMS'
      description 'Private keys of the QWAC (TLS client auth) and QSEAL (request signing).'
    }

    frontend -> backend 'calls' 'HTTPS'
    backend.oauthClient -> tokenVault 'stores and reads tokens'
    backend.oauthClient -> keyMaterial 'uses QWAC for mTLS'
    backend.xs2aClient -> keyMaterial 'uses QWAC for mTLS, QSEAL for signing'
  }

  // ==== OidcProvider (OpenID Connect provider F) ====================

  OidcProvider = softwareSystem 'OidcProvider' {
    #oidc-f
    description '
      Authorization server (RFC 6749) and OpenID Provider towards A.
      Issues certificate-bound access tokens scoped to one consent
      (scope AIS:<consentId>) and brokers PSU authentication to Bank B.
    '

    asMetadata = container 'Metadata and JWKS' {
      technology 'RFC 8414'
      description '/.well-known/oauth-authorization-server, /.well-known/openid-configuration, /jwks. Advertises tls_client_auth, certificate-bound tokens, PKCE S256.'
    }
    authorize = container 'Authorization endpoint' {
      technology '/authorize'
      description 'Validates client_id, redirect_uri and PKCE; parses scope AIS:/PIS:/PIIS:; checks the named resource with Bank B consent management.'
    }
    broker = container 'Identity broker' {
      technology 'OIDC relying party'
      description 'Redirects the PSU to Bank B CIAM with the consent context and acr_values=urn:bank-b:psd2:sca; validates the returned ID token (acr, amr, consent_id).'
    }
    tokenService = container 'Token service' {
      technology '/token /revoke /introspect'
      description 'JWT access tokens with aud, scope, cnf thumbprint (RFC 8705); refresh tokens capped by the consent validUntil; admin revocation per consent.'
    }
    clientRegistry = database 'Client registry' {
      description 'One client per TPP: client_id = QWAC organizationIdentifier, certificate binding, redirect URIs in the QWAC domain, PSD2 roles.'
    }

    authorize -> clientRegistry 'validates client and redirect URI'
    authorize -> broker 'starts brokered authentication'
    tokenService -> clientRegistry 'authenticates client by certificate'
    broker -> tokenService 'hands over the authenticated identity'
  }

  // ==== Bank B ==================================================================

  bankB = softwareSystem 'Bank B' {
    #bank-b
    description '
      ASPSP. Resource server (XS2A API), identity provider and CIAM:
      customer identities carry enrolled devices, and the possession
      element of SCA is a key held by one of those devices.
    '

    xs2aGateway = apiGateway 'XS2A gateway' {
      #xs2a
      technology 'reverse proxy'
      description 'mTLS termination with client certificate; QWAC validation (chain, revocation, PSD2 roles); optional HTTP signature check; JWT validation against F JWKS; rate limiting; X-Request-ID logging.'
    }

    xs2aService = container 'XS2A service' {
      #xs2a
      technology 'REST, NextGenPSD2 XS2A 1.3.16'
      description 'Consents, authorisations, accounts, balances, transactions, payments. Produces the _links steering (§4.15).'
    }

    consentMgmt = container 'Consent management' {
      #xs2a
      description 'Consent store and state machine (§14.15), authorisation sub-resources with scaStatus (§14.16), accessible accounts, per-account daily usage counters, side effects on new recurring consents.'
    }

    ciam = container 'CIAM' {
      #sca
      description 'Customer identity and access management: identities, devices, authentication journeys, SCA engine, risk engine, consent UI. Acts as OpenID Provider towards F.'

      orchestration = component 'Authentication orchestration' {
        technology 'OpenID Provider'
        description 'Journey engine: identify, first factor, risk, account selection and consent screen, SCA challenge, result. Issues the ID token to F.'
      }
      consentUi = webApp 'Consent UI' {
        description 'Login page, account selection, consent summary, QR page with live status.'
      }
      scaEngine = component 'SCA engine' {
        description 'Creates challenges with dynamic linking, renders QR payloads, sends push, verifies device signatures, enforces expiry and retry limits.'
      }
      riskEngine = component 'Risk engine' {
        description 'Scores the session from PSU context data (§4.8) and device signals.'
      }
      identityStore = database 'Identity store' {
        description 'PSU-ID, PSU-ID-Type, credential hashes, status.'
      }
      deviceRegistry = database 'Device registry' {
        description 'Enrolled devices per PSU: device id, app instance id, public key (P-256, hardware-backed), attestation, push token, status.'
      }

      consentUi -> orchestration 'journey steps'
      orchestration -> identityStore 'verifies credentials'
      orchestration -> riskEngine 'assesses the session'
      orchestration -> scaEngine 'issues and checks challenges'
      scaEngine -> deviceRegistry 'reads public keys and push tokens'
    }

    dashboard = webApp 'PSU consent dashboard' {
      description 'Bank-side page where the PSU sees and revokes consents.'
    }

    coreAdapter = container 'Core banking adapter' {
      description 'Accounts, balances, transactions for a PSU. Issues opaque resourceId values so IBANs never appear in paths.'
    }

    coreBanking = externalSystem 'Core banking' {
      #external
      description 'The ledger. Existing system, wrapped by the adapter.'
    }

    pushService = externalSystem 'Push notification service' {
      #external
      technology 'APNs / FCM'
    }

    xs2aGateway -> xs2aService 'forwards with the client certificate'
    xs2aService -> consentMgmt 'creates and checks consents, counts usage'
    xs2aService -> coreAdapter 'reads accounts'
    coreAdapter -> coreBanking 'reads the ledger'
    ciam.orchestration -> consentMgmt 'records authorisation result and accessible accounts' 'internal API'
    ciam.orchestration -> coreAdapter 'lists payment accounts for selection'
    ciam.scaEngine -[push]-> pushService
    dashboard -> consentMgmt 'revokes consents'
  }

  // ==== Bank B mobile app =====================================================

  bankBApp = mobileApp 'Bank B mobile app' {
    #bank-b #sca
    description '
      Registered device. Key pair in secure hardware, enrolled through
      Bank B own channel. Scans the QR, shows the approval details,
      asks for biometric or PIN, signs the challenge with the device key.
    '
  }

  // ==== cross-system relationships ============================================

  psu -> tppA.frontend 'uses' 'browser'
  psu -> OidcProvider.authorize 'is redirected to' 'browser'
  psu -> bankB.ciam.consentUi 'logs in, selects accounts, reviews consent, sees the QR' 'browser'
  psu -> bankB.dashboard 'reviews and revokes consents' 'browser'
  psu -> bankBApp 'scans the QR and approves'

  tppA.backend.xs2aClient -[mtls]-> bankB.xs2aGateway 'POST /v1/consents, GET /v1/accounts, GET /v1/accounts/{id}'
  tppA.backend.oauthClient -[https]-> OidcProvider.asMetadata 'reads AS metadata'
  tppA.backend.oauthClient -[mtls]-> OidcProvider.tokenService 'POST /token (code, refresh)'
  tppA.backend.oauthClient -[redirect]-> OidcProvider.authorize 'response_type=code, scope=AIS:<consentId>, state, PKCE'

  OidcProvider.authorize -[internal]-> bankB.consentMgmt 'validates scope AIS:<consentId>: exists, received, owned by client'
  OidcProvider.broker -[redirect]-> bankB.ciam.consentUi 'OIDC brokering with consent context'
  bankB.ciam.orchestration -[https]-> OidcProvider.broker 'ID token (sub, acr, amr, consent_id)' 'back channel'
  OidcProvider.authorize -[redirect]-> tppA.frontend 'code and state to the redirect URI'
  bankB.consentMgmt -[internal]-> OidcProvider.tokenService 'revokes tokens of a revoked or expired consent'

  bankB.xs2aGateway -[https]-> OidcProvider.asMetadata 'fetches JWKS to validate access tokens'

  bankBApp -[https]-> bankB.ciam.scaEngine 'fetches the challenge, posts the signed response' 'device-authenticated API'
  bankB.pushService -[push]-> bankBApp
}
