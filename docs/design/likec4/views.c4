// Views of the PSU account-list journey.
// Static views: landscape, then one per system and one for the CIAM.
// Dynamic views: the five sequences of docs/design/psu-account-list-journey.md
// section 6 (open them in the sequence variant of the LikeC4 viewer).

views {

  // ==== static views ============================================================

  view index {
    title 'Landscape: PSU reads accounts at Bank B through TPP application A'
    description '''
      System context (C4 level 1). The access token is issued by F,
      the consent lives at Bank B, the second factor is approved on the
      Bank B app of a registered device.
    '''
    include *
    include bankBApp
    style psu {
      color amber
    }
  }

  view tppA of tppA {
    title 'Containers: TPP application A'
    include *, backend.*
    include psu, OidcProvider, bankB
    exclude keyMaterial -> *
    style OidcProvider, bankB {
      color muted
    }
  }

  view tppABackend of tppA.backend {
    title 'Components: TPP application A back end'
    include *
    include tppA.tokenVault, tppA.keyMaterial, OidcProvider.*, bankB.xs2aGateway
  }

  view oidcProvider of OidcProvider {
    title 'Containers: OidcProvider (OpenID Connect provider F)'
    include *
    include psu, tppA.backend.oauthClient, bankB.consentMgmt, bankB.ciam, bankB.xs2aGateway, tppA.frontend
    style tppA.backend.oauthClient, tppA.frontend, bankB.consentMgmt, bankB.ciam, bankB.xs2aGateway {
      color muted
    }
  }

  view bankB of bankB {
    title 'Containers: Bank B (ASPSP)'
    include *
    include psu, bankBApp, tppA.backend.xs2aClient, OidcProvider.authorize, OidcProvider.broker, OidcProvider.tokenService, OidcProvider.asMetadata
    style tppA.backend.xs2aClient, OidcProvider.authorize, OidcProvider.broker, OidcProvider.tokenService, OidcProvider.asMetadata {
      color muted
    }
  }

  view bankBCiam of bankB.ciam {
    title 'Components: Bank B CIAM'
    include *
    include psu, bankBApp, bankB.consentMgmt, bankB.coreAdapter, bankB.pushService, OidcProvider.broker
    style bankB.consentMgmt, bankB.coreAdapter, OidcProvider.broker {
      color muted
    }
  }

  // ==== dynamic views (journey sequences) ====================================

  dynamic view deviceEnrolment {
    title '6.1 Device enrolment (prerequisite, Bank B channel only)'
    description 'The PSU enrols a device in Bank B own channel. Never through the TPP.'
    psu -> bankBApp 'install, activate this device'
    bankBApp -> bankBApp 'generate P-256 key pair in secure hardware, obtain attestation'
    bankBApp -> bankB.ciam.orchestration 'POST /devices {publicKey, attestation, appInstanceId, pushToken}'
    bankB.ciam.orchestration -> psu 'existing SCA: activation code by letter, or current device'
    psu -> bankBApp 'enter activation code'
    bankBApp -> bankB.ciam.orchestration 'POST /devices/{id}/activate {code}'
    bankB.ciam.orchestration -> bankB.ciam.deviceRegistry 'store device (active, enrolledAt)'
    bankB.ciam.orchestration -> bankBApp '201 device active'
    include psu, bankBApp, bankB.ciam.orchestration, bankB.ciam.deviceRegistry
  }

  dynamic view consentAndAuthorizationStart {
    title '6.2 Consent creation and start of the authorization-code flow'
    psu -> tppA.frontend 'select Bank B, click Connect'
    tppA.frontend -> tppA.backend.consentOrchestrator 'POST /banks/B/connect'
    tppA.backend.consentOrchestrator -> tppA.backend.xs2aClient 'create bank-offered consent'
    tppA.backend.xs2aClient -> bankB.xs2aGateway 'POST /v1/consents (mTLS QWAC): access {accounts:[], balances:[]}, recurring, validUntil, TPP-Redirect-URI, PSU-IP-Address' {
      notes 'NextGenPSD2 §6.3.1.2 bank-offered consent; PSU context headers §4.8.'
    }
    bankB.xs2aGateway -> bankB.xs2aService 'validated QWAC (AISP role), forwards'
    bankB.xs2aService -> bankB.consentMgmt 'create consent (received) and authorisation (received)'
    bankB.xs2aService -> tppA.backend.xs2aClient '201 consentId, ASPSP-SCA-Approach: REDIRECT, _links scaOAuth, scaStatus, self, status, confirmation'
    tppA.backend.consentOrchestrator -> tppA.backend.oauthClient 'start authorization-code flow'
    tppA.backend.oauthClient -> OidcProvider.asMetadata 'GET /.well-known/oauth-authorization-server'
    tppA.backend.oauthClient -> tppA.backend.oauthClient 'generate state and PKCE verifier, bind to session and consentId'
    tppA.backend.oauthClient -> OidcProvider.authorize '302 /authorize?response_type=code&client_id=PSDDE-BAFIN-123456&scope=AIS:{consentId} offline_access&state&redirect_uri&code_challenge' {
      notes 'Redirect travels through the PSU browser (§13.1, §7.6.1).'
    }
    OidcProvider.authorize -> OidcProvider.clientRegistry 'validate client_id, redirect_uri, PKCE method'
    OidcProvider.authorize -> bankB.consentMgmt 'consent {consentId} owned by client and status received?'
    OidcProvider.authorize -> OidcProvider.broker 'start brokered authentication'
    OidcProvider.broker -> bankB.ciam.consentUi '302 Bank B CIAM /authorize: acr_values=urn:bank-b:psd2:sca, consent context'
    include psu, tppA.frontend, tppA.backend.consentOrchestrator, tppA.backend.xs2aClient, tppA.backend.oauthClient
  }

  dynamic view scaAtBankB {
    title '6.3 Authentication and SCA at Bank B: password + QR on the registered device'
    bankB.ciam.consentUi -> psu 'login page'
    psu -> bankB.ciam.consentUi 'PSU-ID + password'
    bankB.ciam.consentUi -> bankB.ciam.orchestration 'POST /login'
    bankB.ciam.orchestration -> bankB.ciam.identityStore 'verify first factor'
    bankB.ciam.orchestration -> bankB.ciam.riskEngine 'assess session from PSU context data'
    bankB.ciam.orchestration -> bankB.consentMgmt 'authorisation scaStatus = psuAuthenticated; load consent'
    bankB.ciam.orchestration -> bankB.coreAdapter 'list payment accounts of the PSU'
    bankB.ciam.consentUi -> psu 'account selection + consent summary (TPP, access, validity, frequency)'
    psu -> bankB.ciam.consentUi 'tick accounts, Continue'
    bankB.ciam.orchestration -> bankB.ciam.scaEngine 'create challenge: dynamic link over consentId, TPP, accounts, validUntil' {
      notes 'EBA RTS art. 5 dynamic linking. Challenge expires after 3 minutes.'
    }
    bankB.ciam.orchestration -> bankB.consentMgmt 'authorisation scaStatus = started'
    bankB.ciam.consentUi -> psu 'QR page (polls challenge status)'
    opt 'push notification' {
      bankB.ciam.scaEngine -> bankB.pushService 'push to active devices'
      bankB.pushService -> bankBApp 'notification'
    }
    psu -> bankBApp 'open app, scan QR'
    bankBApp -> bankB.ciam.scaEngine 'GET /sca/challenges/{id} (device-authenticated)'
    bankBApp -> psu 'show: A wants to read accounts X, Y until date. Approve?'
    psu -> bankBApp 'approve (biometric / PIN)'
    bankBApp -> bankBApp 'sign challenge hash with the device key'
    bankBApp -> bankB.ciam.scaEngine 'POST /sca/challenges/{id}/response {signature, deviceId}'
    bankB.ciam.scaEngine -> bankB.ciam.deviceRegistry 'public key of the device; device active and belongs to the PSU?'
    bankB.ciam.scaEngine -> bankB.ciam.orchestration 'challenge approved'
    bankB.ciam.orchestration -> bankB.consentMgmt 'authorisation scaStatus = unconfirmed; accessible accounts = selection'
    bankB.ciam.consentUi -> OidcProvider.broker '302 broker callback with code'
    OidcProvider.broker -> bankB.ciam.orchestration 'POST /token (back channel)'
    bankB.ciam.orchestration -> OidcProvider.broker 'ID token {sub, acr, amr:[pwd,hwk], consent_id, consent_status: authorised}'
    OidcProvider.broker -> OidcProvider.authorize 'consent_id == requested scope? acr ok? issue code'
    OidcProvider.authorize -> tppA.frontend '302 redirect_uri?code&state'
    include psu, bankBApp, bankB.ciam.consentUi, bankB.ciam.orchestration, bankB.ciam.scaEngine
  }

  dynamic view tokenAndAccountRead {
    title '6.4 Token exchange, confirmation, account list and account details'
    tppA.frontend -> tppA.backend.oauthClient 'GET /callback?code&state'
    tppA.backend.oauthClient -> tppA.backend.oauthClient 'state matches session? (else abort)'
    tppA.backend.oauthClient -> OidcProvider.tokenService 'POST /token (mTLS QWAC): grant_type=authorization_code, code, redirect_uri, code_verifier'
    OidcProvider.tokenService -> OidcProvider.clientRegistry 'certificate matches client? PKCE ok?'
    OidcProvider.tokenService -> tppA.backend.oauthClient 'access_token (JWT, scope AIS:{consentId}, cnf.x5t#S256), refresh_token, expires_in'
    tppA.backend.oauthClient -> tppA.tokenVault 'store tokens'
    tppA.backend.consentOrchestrator -> tppA.backend.xs2aClient 'confirm authorisation'
    tppA.backend.xs2aClient -> bankB.xs2aGateway 'PUT /v1/consents/{id}/authorisations/{authId}, Authorization: Bearer' {
      notes 'Confirmation call §7.6.4, integrated OAuth variant.'
    }
    bankB.xs2aGateway -> bankB.xs2aService 'validated QWAC and JWT'
    bankB.xs2aService -> bankB.consentMgmt 'token.consent_id == id and client == owner: authorisation finalised, consent valid'
    bankB.xs2aService -> tppA.backend.xs2aClient '200 {scaStatus: finalised}'
    tppA.backend.xs2aClient -> bankB.xs2aGateway 'GET /v1/consents/{id}/status'
    bankB.xs2aService -> tppA.backend.xs2aClient '200 {consentStatus: valid}'
    tppA.frontend -> psu 'Bank B connected'
    psu -> tppA.frontend 'open accounts at Bank B'
    tppA.frontend -> tppA.backend.xs2aClient 'GET /banks/B/accounts'
    tppA.backend.xs2aClient -> bankB.xs2aGateway 'GET /v1/accounts?withBalance=true: Consent-ID, Authorization: Bearer, X-Request-ID, PSU-IP-Address'
    bankB.xs2aGateway -> bankB.xs2aGateway 'QWAC (AISP); JWT signature, exp, aud; cnf == client cert'
    bankB.xs2aGateway -> bankB.xs2aService 'forward'
    bankB.xs2aService -> bankB.consentMgmt 'scope consentId == Consent-ID? consent valid? access rights? frequency (PSU present: not counted)'
    bankB.xs2aService -> bankB.coreAdapter 'accounts of psuId within accessible accounts'
    bankB.xs2aService -> tppA.backend.xs2aClient '200 {accounts: [{resourceId, iban, currency, name, balances, _links}]}'
    tppA.frontend -> psu 'account list'
    psu -> tppA.frontend 'click an account'
    tppA.frontend -> tppA.backend.xs2aClient 'GET /banks/B/accounts/{resourceId}'
    tppA.backend.xs2aClient -> bankB.xs2aGateway 'GET /v1/accounts/{resourceId}?withBalance=true'
    bankB.xs2aService -> bankB.consentMgmt 'resourceId in accessible accounts of this consent?'
    bankB.xs2aService -> bankB.coreAdapter 'account details + balances'
    bankB.xs2aService -> tppA.backend.xs2aClient '200 {account: {...}}'
    tppA.frontend -> psu 'account details'
    include psu, tppA.frontend, tppA.backend.oauthClient, tppA.backend.consentOrchestrator, tppA.backend.xs2aClient
  }

  dynamic view laterAccess {
    title '6.5 Later access and token refresh'
    tppA.backend.xs2aClient -> bankB.xs2aGateway 'GET /v1/accounts (expired access token)'
    bankB.xs2aGateway -> tppA.backend.xs2aClient '401 TOKEN_EXPIRED'
    tppA.backend.oauthClient -> OidcProvider.tokenService 'POST /token (mTLS): grant_type=refresh_token'
    OidcProvider.tokenService -> bankB.consentMgmt 'consent still valid?'
    OidcProvider.tokenService -> tppA.backend.oauthClient 'new access_token (+ rotated refresh_token)'
    tppA.backend.xs2aClient -> bankB.xs2aGateway 'GET /v1/accounts (new token, no PSU-IP-Address)'
    bankB.xs2aGateway -> bankB.xs2aService 'forward'
    bankB.xs2aService -> bankB.consentMgmt 'usage today per account < frequencyPerDay?'
    alt {
      when 'within frequency' {
        bankB.xs2aService -> tppA.backend.xs2aClient '200 accounts'
      }
      else 'exceeded' {
        bankB.xs2aService -> tppA.backend.xs2aClient '429 ACCESS_EXCEEDED'
      }
    }
    include tppA.backend.xs2aClient, tppA.backend.oauthClient, OidcProvider.tokenService, bankB.xs2aGateway, bankB.xs2aService, bankB.consentMgmt
  }
}
