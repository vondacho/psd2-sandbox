// Views of the PSU account-list journey.
// Static views: landscape, then one per system and one for the CIAM.
// Dynamic views: the five sequences of docs/design/psu-account-list-journey.md
// section 6 (open them in the sequence variant of the LikeC4 viewer).

views {

  // ==== static views ============================================================

  view index {
    title 'Landscape: PSU reads accounts at the Bank through the TPP'
    description '''
      System context (C4 level 1). The access token is issued by the OIDC-provider,
      the consent lives at the Bank, the second factor is approved on the
      the Bank app of a registered device.
    '''
    include *
    include bankApp
    style psu {
      color amber
    }
  }

  view tpp of tpp {
    title 'Containers: the TPP'
    include *, backend.*
    include psu, OidcProvider, bank
    exclude keyMaterial -> *
    style OidcProvider, bank {
      color muted
    }
  }

  view tppBackend of tpp.backend {
    title 'Components: the TPP back end'
    include *
    include tpp.tokenVault, tpp.keyMaterial, OidcProvider.*, bank.xs2aGateway
  }

  view oidcProvider of OidcProvider {
    title 'Containers: OidcProvider (the OIDC-provider)'
    include *
    include psu, tpp.backend.oauthClient, bank.consentMgmt, bank.ciam, bank.xs2aGateway, tpp.frontend
    style tpp.backend.oauthClient, tpp.frontend, bank.consentMgmt, bank.ciam, bank.xs2aGateway {
      color muted
    }
  }

  view bank of bank {
    title 'Containers: the Bank (ASPSP)'
    include *
    include psu, bankApp, tpp.backend.xs2aClient, OidcProvider.authorize, OidcProvider.broker, OidcProvider.tokenService, OidcProvider.asMetadata
    style tpp.backend.xs2aClient, OidcProvider.authorize, OidcProvider.broker, OidcProvider.tokenService, OidcProvider.asMetadata {
      color muted
    }
  }

  view bankBCiam of bank.ciam {
    title 'Components: the Bank CIAM'
    include *
    include psu, bankApp, bank.consentMgmt, bank.coreAdapter, bank.pushService, OidcProvider.broker
    style bank.consentMgmt, bank.coreAdapter, OidcProvider.broker {
      color muted
    }
  }

  // ==== dynamic views (journey sequences) ====================================

  dynamic view deviceEnrolment {
    title '6.1 Device enrolment (prerequisite, the Bank channel only)'
    description 'The PSU enrols a device in the Bank own channel. Never through the TPP.'
    psu -> bankApp 'install, activate this device'
    bankApp -> bankApp 'generate P-256 key pair in secure hardware, obtain attestation'
    bankApp -> bank.ciam.orchestration 'POST /devices {publicKey, attestation, appInstanceId, pushToken}'
    bank.ciam.orchestration -> psu 'existing SCA: activation code by letter, or current device'
    psu -> bankApp 'enter activation code'
    bankApp -> bank.ciam.orchestration 'POST /devices/{id}/activate {code}'
    bank.ciam.orchestration -> bank.ciam.deviceRegistry 'store device (active, enrolledAt)'
    bank.ciam.orchestration -> bankApp '201 device active'
    include psu, bankApp, bank.ciam.orchestration, bank.ciam.deviceRegistry
  }

  dynamic view consentAndAuthorizationStart {
    title '6.2 Consent creation and start of the authorization-code flow'
    psu -> tpp.frontend 'select the Bank, click Connect'
    tpp.frontend -> tpp.backend.consentOrchestrator 'POST /banks/bank/connect'
    tpp.backend.consentOrchestrator -> tpp.backend.xs2aClient 'create bank-offered consent'
    tpp.backend.xs2aClient -> bank.xs2aGateway 'POST /v1/consents (mTLS QWAC): access {accounts:[], balances:[]}, recurring, validUntil, TPP-Redirect-URI, PSU-IP-Address' {
      notes 'NextGenPSD2 §6.3.1.2 bank-offered consent; PSU context headers §4.8.'
    }
    bank.xs2aGateway -> bank.xs2aService 'validated QWAC (AISP role), forwards'
    bank.xs2aService -> bank.consentMgmt 'create consent (received) and authorisation (received)'
    bank.xs2aService -> tpp.backend.xs2aClient '201 consentId, ASPSP-SCA-Approach: REDIRECT, _links scaOAuth, scaStatus, self, status, confirmation'
    tpp.backend.consentOrchestrator -> tpp.backend.oauthClient 'start authorization-code flow'
    tpp.backend.oauthClient -> OidcProvider.asMetadata 'GET /.well-known/oauth-authorization-server'
    tpp.backend.oauthClient -> tpp.backend.oauthClient 'generate state and PKCE verifier, bind to session and consentId'
    tpp.backend.oauthClient -> OidcProvider.authorize '302 /authorize?response_type=code&client_id=PSDDE-BAFIN-123456&scope=AIS:{consentId} offline_access&state&redirect_uri&code_challenge' {
      notes 'Redirect travels through the PSU browser (§13.1, §7.6.1).'
    }
    OidcProvider.authorize -> OidcProvider.clientRegistry 'validate client_id, redirect_uri, PKCE method'
    OidcProvider.authorize -> bank.consentMgmt 'consent {consentId} owned by client and status received?'
    OidcProvider.authorize -> OidcProvider.broker 'start brokered authentication'
    OidcProvider.broker -> bank.ciam.consentUi '302 Bank CIAM /authorize: acr_values=urn:bank:psd2:sca, consent context'
    include psu, tpp.frontend, tpp.backend.consentOrchestrator, tpp.backend.xs2aClient, tpp.backend.oauthClient
  }

  dynamic view scaAtBankB {
    title '6.3 Authentication and SCA at the Bank: password + QR on the registered device'
    bank.ciam.consentUi -> psu 'login page'
    psu -> bank.ciam.consentUi 'PSU-ID + password'
    bank.ciam.consentUi -> bank.ciam.orchestration 'POST /login'
    bank.ciam.orchestration -> bank.ciam.identityStore 'verify first factor'
    bank.ciam.orchestration -> bank.ciam.riskEngine 'assess session from PSU context data'
    bank.ciam.orchestration -> bank.consentMgmt 'authorisation scaStatus = psuAuthenticated; load consent'
    bank.ciam.orchestration -> bank.coreAdapter 'list payment accounts of the PSU'
    bank.ciam.consentUi -> psu 'account selection + consent summary (TPP, access, validity, frequency)'
    psu -> bank.ciam.consentUi 'tick accounts, Continue'
    bank.ciam.orchestration -> bank.ciam.scaEngine 'create challenge: dynamic link over consentId, TPP, accounts, validUntil' {
      notes 'EBA RTS art. 5 dynamic linking. Challenge expires after 3 minutes.'
    }
    bank.ciam.orchestration -> bank.consentMgmt 'authorisation scaStatus = started'
    bank.ciam.consentUi -> psu 'QR page (polls challenge status)'
    opt 'push notification' {
      bank.ciam.scaEngine -> bank.pushService 'push to active devices'
      bank.pushService -> bankApp 'notification'
    }
    psu -> bankApp 'open app, scan QR'
    bankApp -> bank.ciam.scaEngine 'GET /sca/challenges/{id} (device-authenticated)'
    bankApp -> psu 'show: the TPP wants to read accounts X, Y until date. Approve?'
    psu -> bankApp 'approve (biometric / PIN)'
    bankApp -> bankApp 'sign challenge hash with the device key'
    bankApp -> bank.ciam.scaEngine 'POST /sca/challenges/{id}/response {signature, deviceId}'
    bank.ciam.scaEngine -> bank.ciam.deviceRegistry 'public key of the device; device active and belongs to the PSU?'
    bank.ciam.scaEngine -> bank.ciam.orchestration 'challenge approved'
    bank.ciam.orchestration -> bank.consentMgmt 'authorisation scaStatus = unconfirmed; accessible accounts = selection'
    bank.ciam.consentUi -> OidcProvider.broker '302 broker callback with code'
    OidcProvider.broker -> bank.ciam.orchestration 'POST /token (back channel)'
    bank.ciam.orchestration -> OidcProvider.broker 'ID token {sub, acr, amr:[pwd,hwk], consent_id, consent_status: authorised}'
    OidcProvider.broker -> OidcProvider.authorize 'consent_id == requested scope? acr ok? issue code'
    OidcProvider.authorize -> tpp.frontend '302 redirect_uri?code&state'
    include psu, bankApp, bank.ciam.consentUi, bank.ciam.orchestration, bank.ciam.scaEngine
  }

  dynamic view tokenAndAccountRead {
    title '6.4 Token exchange, confirmation, account list and account details'
    tpp.frontend -> tpp.backend.oauthClient 'GET /callback?code&state'
    tpp.backend.oauthClient -> tpp.backend.oauthClient 'state matches session? (else abort)'
    tpp.backend.oauthClient -> OidcProvider.tokenService 'POST /token (mTLS QWAC): grant_type=authorization_code, code, redirect_uri, code_verifier'
    OidcProvider.tokenService -> OidcProvider.clientRegistry 'certificate matches client? PKCE ok?'
    OidcProvider.tokenService -> tpp.backend.oauthClient 'access_token (JWT, scope AIS:{consentId}, cnf.x5t#S256), refresh_token, expires_in'
    tpp.backend.oauthClient -> tpp.tokenVault 'store tokens'
    tpp.backend.consentOrchestrator -> tpp.backend.xs2aClient 'confirm authorisation'
    tpp.backend.xs2aClient -> bank.xs2aGateway 'PUT /v1/consents/{id}/authorisations/{authId}, Authorization: Bearer' {
      notes 'Confirmation call §7.6.4, integrated OAuth variant.'
    }
    bank.xs2aGateway -> bank.xs2aService 'validated QWAC and JWT'
    bank.xs2aService -> bank.consentMgmt 'token.consent_id == id and client == owner: authorisation finalised, consent valid'
    bank.xs2aService -> tpp.backend.xs2aClient '200 {scaStatus: finalised}'
    tpp.backend.xs2aClient -> bank.xs2aGateway 'GET /v1/consents/{id}/status'
    bank.xs2aService -> tpp.backend.xs2aClient '200 {consentStatus: valid}'
    tpp.frontend -> psu 'Bank connected'
    psu -> tpp.frontend 'open accounts at the Bank'
    tpp.frontend -> tpp.backend.xs2aClient 'GET /banks/bank/accounts'
    tpp.backend.xs2aClient -> bank.xs2aGateway 'GET /v1/accounts?withBalance=true: Consent-ID, Authorization: Bearer, X-Request-ID, PSU-IP-Address'
    bank.xs2aGateway -> bank.xs2aGateway 'QWAC (AISP); JWT signature, exp, aud; cnf == client cert'
    bank.xs2aGateway -> bank.xs2aService 'forward'
    bank.xs2aService -> bank.consentMgmt 'scope consentId == Consent-ID? consent valid? access rights? frequency (PSU present: not counted)'
    bank.xs2aService -> bank.coreAdapter 'accounts of psuId within accessible accounts'
    bank.xs2aService -> tpp.backend.xs2aClient '200 {accounts: [{resourceId, iban, currency, name, balances, _links}]}'
    tpp.frontend -> psu 'account list'
    psu -> tpp.frontend 'click an account'
    tpp.frontend -> tpp.backend.xs2aClient 'GET /banks/bank/accounts/{resourceId}'
    tpp.backend.xs2aClient -> bank.xs2aGateway 'GET /v1/accounts/{resourceId}?withBalance=true'
    bank.xs2aService -> bank.consentMgmt 'resourceId in accessible accounts of this consent?'
    bank.xs2aService -> bank.coreAdapter 'account details + balances'
    bank.xs2aService -> tpp.backend.xs2aClient '200 {account: {...}}'
    tpp.frontend -> psu 'account details'
    include psu, tpp.frontend, tpp.backend.oauthClient, tpp.backend.consentOrchestrator, tpp.backend.xs2aClient
  }

  dynamic view laterAccess {
    title '6.5 Later access and token refresh'
    tpp.backend.xs2aClient -> bank.xs2aGateway 'GET /v1/accounts (expired access token)'
    bank.xs2aGateway -> tpp.backend.xs2aClient '401 TOKEN_EXPIRED'
    tpp.backend.oauthClient -> OidcProvider.tokenService 'POST /token (mTLS): grant_type=refresh_token'
    OidcProvider.tokenService -> bank.consentMgmt 'consent still valid?'
    OidcProvider.tokenService -> tpp.backend.oauthClient 'new access_token (+ rotated refresh_token)'
    tpp.backend.xs2aClient -> bank.xs2aGateway 'GET /v1/accounts (new token, no PSU-IP-Address)'
    bank.xs2aGateway -> bank.xs2aService 'forward'
    bank.xs2aService -> bank.consentMgmt 'usage today per account < frequencyPerDay?'
    alt {
      when 'within frequency' {
        bank.xs2aService -> tpp.backend.xs2aClient '200 accounts'
      }
      else 'exceeded' {
        bank.xs2aService -> tpp.backend.xs2aClient '429 ACCESS_EXCEEDED'
      }
    }
    include tpp.backend.xs2aClient, tpp.backend.oauthClient, OidcProvider.tokenService, bank.xs2aGateway, bank.xs2aService, bank.consentMgmt
  }

  view bankPayments of bank.paymentMgmt {
    title 'Container: payment initiation at the Bank'
    include *
    include bank.xs2aService, bank.ciam, bank.coreAdapter, OidcProvider.authorize, tpp.backend
    style bank.xs2aService, bank.ciam, bank.coreAdapter, OidcProvider.authorize, tpp.backend {
      color muted
    }
  }

  dynamic view paymentInitiation {
    title '6.6 Payment initiation and approval (increment 4)'
    description 'A PSU pays from an account at the Bank through the TPP. The SCA, the device and the tokens are those of the account journey; only the resource and the dynamic link change.'
    psu -> tpp.frontend 'pay 12.50 EUR to Payee X'
    tpp.backend.xs2aClient -> bank.xs2aGateway 'POST /v1/payments/sepa-credit-transfers'
    bank.xs2aGateway -> bank.xs2aService 'forwards with the client certificate'
    bank.xs2aService -> bank.paymentMgmt 'creates the payment (RCVD) and its authorisation'
    bank.paymentMgmt -> tpp.backend.xs2aClient '201 paymentId, RCVD, scaOAuth and scaStatus links'
    tpp.backend.oauthClient -> OidcProvider.authorize 'scope PIS:<paymentId>, state, PKCE'
    OidcProvider.authorize -> bank.paymentMgmt 'payment exists, is RCVD and belongs to this client?'
    OidcProvider.broker -> bank.ciam.consentUi 'brokers the PSU to the Bank'
    psu -> bank.ciam.consentUi 'password, then reviews payee, amount and debtor account'
    bank.ciam.scaEngine -> bankApp 'challenge whose dynamic link covers amount and payee'
    psu -> bankApp 'approves with biometric or PIN'
    bankApp -> bank.ciam.scaEngine 'signed challenge response'
    bank.ciam.orchestration -> bank.paymentMgmt 'authorisation finalised'
    bank.ciam.orchestration -> OidcProvider.broker 'ID token (acr, amr, payment id)'
    OidcProvider.tokenService -> tpp.backend.oauthClient 'access token scoped to the payment'
    tpp.backend.xs2aClient -> bank.xs2aGateway 'PUT authorisation (confirmation), then GET status'
    bank.paymentMgmt -> bank.coreAdapter 'execute'
    bank.coreAdapter -> bank.paymentMgmt 'booked: ACSC'
  }
}
