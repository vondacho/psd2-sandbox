// Notation for the PSU account-list journey C4 model (LikeC4 DSL).
// Kinds follow the C4 levels: actor, softwareSystem, container, component.

specification {

  element actor {
    notation 'Person'
    style {
      shape person
      color amber
    }
  }

  element softwareSystem {
    notation 'Software system'
    style {
      opacity 10%
      border dashed
    }
  }

  element externalSystem {
    notation 'External system'
    style {
      color muted
    }
  }

  element container {
    notation 'Container'
    style {
      opacity 15%
      border dotted
    }
  }

  element component {
    notation 'Component'
  }

  element webApp {
    notation 'Web application'
    style {
      shape browser
    }
  }

  element mobileApp {
    notation 'Mobile application'
    style {
      shape mobile
    }
  }

  element database {
    notation 'Data store'
    style {
      shape cylinder
      color gray
    }
  }

  element apiGateway {
    notation 'API gateway'
    style {
      shape component
      color indigo
    }
  }

  // ---- relationship kinds --------------------------------------------------

  relationship https {
    technology 'HTTPS'
    line solid
  }

  relationship mtls {
    title 'mTLS'
    description 'TLS 1.2+ with the TPP eIDAS QWAC as client certificate (NextGenPSD2 §3, §13)'
    technology 'mTLS (QWAC)'
    line solid
    color indigo
  }

  relationship redirect {
    title 'redirects PSU browser'
    technology 'HTTP 302'
    line dashed
    color amber
  }

  relationship internal {
    technology 'internal API'
    line dotted
  }

  relationship push {
    title 'push notification'
    technology 'APNs / FCM'
    line dotted
    color green
  }

  // ---- tags -----------------------------------------------------------------

  tag tpp-a       { color #1f6feb }
  tag oidc-f      { color #8250df }
  tag bank-b      { color #0969da }
  tag xs2a        { color #0a7ea4 }
  tag oauth2      { color #8250df }
  tag sca         { color #bf8700 }
  tag external    { color gray }
  tag sandbox-mock { color green }
}
