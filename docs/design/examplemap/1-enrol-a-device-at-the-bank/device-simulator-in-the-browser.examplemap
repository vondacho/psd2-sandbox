// Example map for the story "Device simulator in the browser" (activity "Enrol
// a device at the Bank"). Fixtures: docs/design/examplemap/README.md.

examplemap "Device simulator in the browser" {
  product "OBI"

  delivery "Walking skeleton" release
  delivery "MVP" release
  delivery "Hardening" release

  story "Device simulator in the browser" ~ready @"Walking skeleton" +sandbox +bank-app {
    as "PSU"
    want "a web page that holds a WebCrypto key and scans or pastes a QR"
    so "the sandbox journey runs without a native app"
  }

  rule "The simulator holds one non-extractable WebCrypto P-256 key pair that survives a reload" {
    example "First visit generates a key and shows its public JWK" @"Walking skeleton" +nominal {
      given "a fresh browser profile opens https://app.bank.sandbox/simulator"
      when "the page loads"
      then "a P-256 key pair is generated with extractable = false"
      then "the key is stored in IndexedDB"
      then "the page shows the public JWK and the state 'not enrolled'"
    }
    example "A reload keeps the same key" @"Walking skeleton" +nominal {
      given "the simulator generated key K1"
      when "the page is reloaded"
      then "the public JWK shown is still K1"
    }
    example "Clearing site data loses the key and the enrolment" @MVP +edge {
      given "the simulator is enrolled as dev-anna-sim with key K1"
      when "the browser's site data is cleared and the page reopened"
      then "a new key K2 is generated"
      then "the page shows 'not enrolled' and hints that dev-anna-sim must be removed at the Bank"
    }
    example "The private key cannot be exported through the console" @"Walking skeleton" +error {
      given "the simulator key in IndexedDB"
      when "crypto.subtle.exportKey('jwk', privateKey) is called"
      then "the call rejects with InvalidAccessError"
    }
  }

  rule "The simulator enrols through the same device API as the native app" {
    example "Enrolling the simulator creates a device at the Bank" @"Walking skeleton" +nominal {
      given "Anna is logged in to the Bank online banking in the same browser"
      when "she clicks 'Enrol this browser' in the simulator"
      then "POST /devices is sent with the public JWK, platform 'browser', name 'Browser simulator' and no pushToken"
      then "the Bank lists 'Browser simulator' under Anna's devices"
    }
    example "The simulator is activated with the sandbox activation code" @"Walking skeleton" +nominal {
      given "the simulator is enrolled and pending"
      given "the sandbox shows the activation code 0000-0000 on the mock letter page"
      when "Anna enters 0000-0000 in the simulator"
      then "the device is active"
      then "the simulator shows 'enrolled as dev-anna-sim, active'"
    }
  }

  rule "A challenge can be entered by camera scan or by pasting the payload" {
    example "Pasting a QR payload loads the challenge" @"Walking skeleton" +nominal {
      given "the QR page shows the payload text for challenge chl-01"
      when "Anna pastes the payload into the simulator"
      then "the simulator fetches GET /sca/challenges/chl-01 with a device-signed request"
      then "the approval screen shows 'TPP App wants to read Main Account until 2026-12-05'"
    }
    example "Scanning the QR with the camera loads the same challenge" @MVP +nominal {
      given "the QR page is displayed on a second screen"
      when "Anna clicks 'Scan' and points the camera at it"
      then "the payload is decoded and the challenge is fetched"
    }
    example "A malformed payload is rejected before any network call" @"Walking skeleton" +error {
      given "the pasted text is 'hello world'"
      when "Anna clicks 'Load'"
      then "the simulator shows 'Not a Bank code'"
      then "no request is sent"
    }
    example "A payload whose endpoint is not the Bank is refused" @MVP +error {
      given "a well-formed payload with endpoint https://evil.example/sca"
      when "Anna pastes it"
      then "the simulator shows 'This code does not come from the Bank'"
      then "no request is sent to evil.example"
    }
    example "A payload with an invalid server signature is refused" @MVP +error {
      given "a payload whose server signature was altered"
      when "Anna pastes it"
      then "the simulator shows 'Not a Bank code'"
    }
  }

  rule "The simulator signs only after a simulated local verification" +sca {
    example "The correct PIN signs and posts the response" @"Walking skeleton" +nominal {
      given "challenge chl-01 is loaded and the simulator PIN is 1234"
      when "Anna clicks 'Approve' and enters 1234"
      then "the simulator signs 'chl-01|nonce|dynamic-link-hash' with the WebCrypto key"
      then "POST /sca/challenges/chl-01/response is sent"
      then "the simulator shows 'Approved'"
    }
    example "A wrong PIN sends nothing" @"Walking skeleton" +error {
      given "challenge chl-01 is loaded"
      when "Anna clicks 'Approve' and enters 0000"
      then "the simulator shows 'Wrong PIN'"
      then "no request is sent"
    }
    example "Reject sends a denial without signing" @MVP +nominal {
      given "challenge chl-01 is loaded"
      when "Anna clicks 'Reject'"
      then "POST /sca/challenges/chl-01/response is sent with decision deny"
      then "the simulator shows 'Rejected'"
    }
  }
}
