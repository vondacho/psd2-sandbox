// Example map for the story "Revoke a consent at Bank B" (activity "Come back
// later", step "Revoke or renew the consent"). Fixtures: docs/design/examplemap/README.md.

examplemap "Revoke a consent at Bank B" {
  product "berlin-psd2-sandbox"

  delivery "Walking skeleton" release
  delivery "MVP" release
  delivery "Hardening" release

  story "Revoke a consent at Bank B" ~analysing @MVP +bank-b-ciam +"spec 14.15" {
    as "PSU"
    want "a page at Bank B listing my consents with a revoke button"
    so "I can cut off an app without contacting the app"
    question "Are consents still in status received (pending) shown on the dashboard with a cancel button?" +"ask product"
    question "Does revoking need a second factor, or is the online-banking login enough since it only removes access?" +"ask bank-b" +security
  }

  rule "The dashboard lists every consent of the logged-in PSU with the TPP, the accounts, the validity, the status, the last access and today's usage" {
    example "Anna's consents" @MVP +nominal {
      given "Anna has consent 123cons456 by App A (valid until 2026-12-05, Main Account, last access today 09:15, 3 of 4 without her) and 333cons444 by C Pay (valid until 2026-10-01, Savings)"
      when "she opens 'Connected apps' in online banking"
      then "two rows are shown with those values and a 'Revoke' button each"
    }
    example "An expired consent is listed without a button" @MVP +edge {
      given "consent 111cons222 expired on 2026-09-01"
      when "the dashboard renders"
      then "its row says 'expired 1 Sep 2026' and has no 'Revoke'"
    }
    example "A revoked consent stays visible for 90 days" @MVP +edge {
      given "a consent revoked 10 days ago"
      when "the dashboard renders"
      then "its row says 'revoked by you on …'"
    }
    example "No consents" @MVP +edge {
      given "Ben has no consent"
      when "he opens 'Connected apps'"
      then "the page says 'No app has access to your accounts'"
    }
    example "Ben never sees Anna's consents" @MVP +nominal {
      given "Ben is logged in"
      when "the dashboard renders"
      then "123cons456 is absent"
    }
  }

  rule "Revoking sets the consent to revokedByPsu immediately, revokes its tokens at F, and the next TPP call is refused" +"spec 14.15" {
    example "Revoke App A" @MVP +nominal {
      given "consent 123cons456 valid and A holding valid tokens"
      when "Anna clicks 'Revoke' on App A and confirms"
      then "the consent status is revokedByPsu"
      then "consent management calls POST /internal/tokens/revoke?consent_id=123cons456 at F"
      then "A's next GET /v1/accounts answers 401 CONSENT_INVALID"
      then "the row says 'revoked by you just now'"
    }
    example "C's consent is untouched" @MVP +nominal {
      given "the revocation of 123cons456"
      when "C calls GET /v1/accounts with 333cons444"
      then "the answer is 200"
    }
    example "Revoking twice" @MVP +edge {
      given "123cons456 already revokedByPsu"
      when "the revoke request is sent again"
      then "the answer is 204 and nothing changes"
    }
    example "Ben cannot revoke Anna's consent" @MVP +error {
      given "Ben is logged in"
      when "he posts the revoke request for 123cons456"
      then "the answer is 404 and the consent stays valid"
    }
    example "F unreachable during revocation" @MVP +edge {
      given "F answers 503 to the token revocation"
      when "Anna revokes"
      then "the consent is revokedByPsu at once, the token revocation is queued and retried, and A's calls are already refused"
    }
  }

  rule "Revocation is the PSU's act; the TPP learns it on its next call or through a notification" {
    example "A learns from the failed call" @MVP +nominal {
      given "the revocation"
      when "A's nightly call answers 401 CONSENT_INVALID"
      then "A marks the connection needsReconsent with reason revoked"
    }
    example "GET status says revokedByPsu" @MVP +nominal {
      given "the revocation"
      when "A calls GET /v1/consents/123cons456/status"
      then "the answer is revokedByPsu"
    }
    example "A revoked consent cannot be un-revoked" @MVP +edge {
      given "123cons456 revokedByPsu"
      when "Anna wants App A back"
      then "she connects again from App A, which creates a new consent"
    }
  }
}
