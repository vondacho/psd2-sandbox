// Example map for the story "Read F's metadata from the scaOAuth link"
// (activity "Connect Bank B from application A", step "Start the authorization
// at F"). Fixtures: docs/design/examplemap/README.md.

examplemap "Read F's metadata from the scaOAuth link" {
  product "berlin-psd2-sandbox"

  delivery "Walking skeleton" release
  delivery "MVP" release
  delivery "Hardening" release

  story "Read F's metadata from the scaOAuth link" ~analysing @"Walking skeleton" +tpp-a +"spec 13" {
    as "TPP operator"
    want "A to discover the authorization and token endpoints from the metadata document"
    so "no endpoint is hard-coded per bank"
    question "How long may A cache a metadata document: one hour as assumed here, or the HTTP cache headers of F?" +"ask tpp-a"
  }

  rule "A fetches the RFC 8414 document at the scaOAuth href and uses its endpoints" +"spec 13" +"RFC 8414" {
    example "The endpoints of F are taken from the document" @"Walking skeleton" +nominal {
      given "the 201 answer carries scaOAuth https://f.sandbox/.well-known/oauth-authorization-server"
      given "that document has issuer https://f.sandbox, authorization_endpoint https://f.sandbox/authorize, token_endpoint https://f.sandbox/token, jwks_uri https://f.sandbox/jwks"
      when "A prepares the authorization"
      then "the browser is redirected to https://f.sandbox/authorize"
      then "the code will be exchanged at https://f.sandbox/token"
    }
    example "No endpoint of F is present in A's configuration" @"Walking skeleton" +nominal {
      given "A's registry entry for bank-b"
      when "the configuration is inspected"
      then "it holds the metadata URL only, no authorize or token URL"
    }
    example "A 404 on the metadata URL fails the connection with an operational alert" @MVP +error {
      given "https://f.sandbox/.well-known/oauth-authorization-server answers 404"
      when "A fetches it"
      then "the connection state is failed with reason 'authorization server metadata unavailable'"
      then "an alert names bank-b and the URL"
    }
    example "A document without token_endpoint aborts" @MVP +error {
      given "a metadata document without token_endpoint"
      when "A validates it"
      then "the connection fails with 'metadata incomplete: token_endpoint'"
    }
    example "A document whose issuer does not match its location aborts" @MVP +error {
      given "the document at https://f.sandbox/.well-known/oauth-authorization-server says issuer https://other.example"
      when "A validates it"
      then "the connection fails with 'issuer mismatch'"
    }
    example "A document that is not JSON aborts" @MVP +error {
      given "the metadata URL answers an HTML page"
      when "A parses it"
      then "the connection fails with 'metadata not parseable'"
    }
  }

  rule "A requires the capabilities the design depends on: tls_client_auth, S256 and the code grant" +"spec 13.1" +"spec 13.3" {
    example "F advertises everything needed" @"Walking skeleton" +nominal {
      given "token_endpoint_auth_methods_supported [tls_client_auth], code_challenge_methods_supported [S256], grant_types_supported [authorization_code, refresh_token], tls_client_certificate_bound_access_tokens true"
      when "A validates the document"
      then "the authorization proceeds"
    }
    example "Without tls_client_auth A aborts" @MVP +error {
      given "token_endpoint_auth_methods_supported [client_secret_basic]"
      when "A validates the document"
      then "the connection fails with 'F does not support tls_client_auth'"
    }
    example "Without S256 A aborts" @MVP +error {
      given "code_challenge_methods_supported [plain]"
      when "A validates the document"
      then "the connection fails with 'F does not support PKCE S256'"
    }
    example "Without refresh_token grant A still connects but warns" @MVP +edge {
      given "grant_types_supported [authorization_code]"
      when "A validates the document"
      then "the authorization proceeds"
      then "a warning 'no refresh token grant at bank-b' is logged"
    }
  }

  rule "The scaOAuth link must be https and on the host the registry knows for this bank" +security {
    example "A link on the registered host is followed" @"Walking skeleton" +nominal {
      given "bank-b.oauthMetadataUrl is https://f.sandbox/.well-known/oauth-authorization-server"
      when "the 201 carries scaOAuth on host f.sandbox"
      then "A fetches it"
    }
    example "A link on another host is refused" @MVP +error {
      given "the 201 carries scaOAuth https://evil.example/.well-known/oauth-authorization-server"
      when "A validates the link"
      then "the connection fails with 'scaOAuth host not expected for bank-b'"
      then "nothing is fetched from evil.example"
    }
    example "An http link is refused" @MVP +error {
      given "the 201 carries scaOAuth http://f.sandbox/.well-known/oauth-authorization-server"
      when "A validates the link"
      then "the connection fails with 'scaOAuth must use https'"
    }
    example "A link with a different path on the same host is followed" @MVP +edge {
      given "the 201 carries scaOAuth https://f.sandbox/.well-known/openid-configuration"
      when "A validates the link"
      then "A fetches it and uses it"
    }
  }

  rule "Metadata is cached per bank for one hour and refreshed on failure" {
    example "Two connects within an hour fetch the document once" @MVP +nominal {
      given "Anna and Ben connect Bank B within ten minutes"
      when "the requests to f.sandbox are counted"
      then "the metadata document was fetched once"
    }
    example "A changed link invalidates the cache" @MVP +edge {
      given "the cached document came from https://f.sandbox/.well-known/oauth-authorization-server"
      when "a new 201 carries scaOAuth https://f.sandbox/.well-known/openid-configuration"
      then "A fetches the new document"
    }
    example "A token endpoint that answers 404 triggers a refetch before failing" @MVP +edge {
      given "the cached token_endpoint answers 404"
      when "A exchanges a code"
      then "A refetches the metadata once and retries the exchange"
    }
  }
}
