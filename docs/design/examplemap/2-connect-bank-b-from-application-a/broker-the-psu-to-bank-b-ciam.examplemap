// Example map for the story "Broker the PSU to Bank B CIAM" (activity "Connect
// Bank B from application A", step "Start the authorization at F").
// Fixtures: docs/design/examplemap/README.md.

examplemap "Broker the PSU to Bank B CIAM" {
  product "berlin-psd2-sandbox"

  delivery "Walking skeleton" release
  delivery "MVP" release
  delivery "Hardening" release

  story "Broker the PSU to Bank B CIAM" ~analysing @"Walking skeleton" +oidc-f +"OIDC Core" {
    as "PSU"
    want "F to hand me to Bank B's own login page with the consent context"
    so "I authenticate with my bank, not with a stranger"
    question "Does the CIAM accept the consent context as plain query parameters or must F send a signed request object?" +"ask bank-b" +security
  }

  rule "After the scope is validated, F redirects the browser to the CIAM with its own state and nonce, the required acr and the consent context" +"OIDC Core" {
    example "The brokered authorization request" @"Walking skeleton" +nominal {
      given "the request for AIS:123cons456 by client PSDDE-BAFIN-123456 passed scope validation"
      when "F answers the browser"
      then "it is a 302 to https://ciam.bank-b.sandbox/authorize with client_id f-broker, response_type code, scope openid, acr_values urn:bank-b:psd2:sca, a fresh state and nonce, redirect_uri https://f.sandbox/broker/callback, consent_id 123cons456 and tpp_client_id PSDDE-BAFIN-123456"
    }
    example "A's state is not forwarded to the CIAM" @"Walking skeleton" +nominal {
      given "A's state S8NJ7…"
      when "the brokered URL is inspected"
      then "its state differs from S8NJ7…"
    }
    example "The PSU is never asked for credentials at F" @"Walking skeleton" +nominal {
      given "F has no PSU accounts"
      when "the browser hits /authorize"
      then "F renders no login form and redirects to the CIAM"
    }
    example "The CIAM unreachable yields temporarily_unavailable to A" @MVP +error {
      given "the CIAM answers 503 on /authorize"
      when "the browser follows the redirect"
      then "the CIAM's error is shown and F, on its next contact, redirects A with error=temporarily_unavailable"
    }
  }

  rule "F accepts the CIAM's ID token only if it is signed by the CIAM, meant for F, fresh, and carries the required acr and the requested consent id with status authorised" +"OIDC Core" {
    example "A correct ID token yields a code for A" @"Walking skeleton" +nominal {
      given "an ID token with iss https://ciam.bank-b.sandbox, aud f-broker, the sent nonce, exp in 5 minutes, acr urn:bank-b:psd2:sca, amr [pwd, hwk], consent_id 123cons456, consent_status authorised"
      when "F validates it"
      then "F issues an authorization code to A"
    }
    example "An ID token with a lower acr is refused" @"Walking skeleton" +error {
      given "an ID token with acr urn:bank-b:password-only"
      when "F validates it"
      then "F redirects A with error=access_denied and error_description 'SCA not performed'"
    }
    example "An ID token for another consent is refused" @"Walking skeleton" +error {
      given "an ID token with consent_id 111cons222 while AIS:123cons456 was requested"
      when "F validates it"
      then "F issues no code and redirects A with error=server_error"
      then "the mismatch is logged as a security event"
    }
    example "A refused consent yields access_denied" @MVP +error {
      given "an ID token with consent_status refused"
      when "F validates it"
      then "F redirects A's nok URI with error=access_denied and the state"
    }
    example "A wrong nonce is refused" @MVP +error {
      given "an ID token whose nonce is not the one F sent"
      when "F validates it"
      then "F issues no code"
    }
    example "An expired ID token is refused" @MVP +error {
      given "an ID token with exp one minute in the past"
      when "F validates it"
      then "F issues no code and redirects A with error=server_error"
    }
    example "An ID token signed with an unknown key is refused" @MVP +error {
      given "an ID token whose kid is not in the CIAM's JWKS"
      when "F validates it"
      then "F issues no code"
    }
    example "An ID token with aud of another relying party is refused" @MVP +error {
      given "an ID token with aud other-rp"
      when "F validates it"
      then "F issues no code"
    }
  }

  rule "The CIAM's callback to F is single-use and bound to the brokered request" {
    example "A replayed broker callback is refused" @MVP +error {
      given "the CIAM redirected to https://f.sandbox/broker/callback?code=c1&state=st1 and F processed it"
      when "the same URL is opened again"
      then "F answers 400 'request already completed'"
    }
    example "A broker callback with an unknown state is refused" @MVP +error {
      given "a callback with state st-unknown"
      when "F handles it"
      then "F answers 400 and issues no code"
    }
    example "F redeems the CIAM code over the back channel with its own client credentials" @"Walking skeleton" +nominal {
      given "the broker callback with code c1"
      when "F calls POST https://ciam.bank-b.sandbox/token"
      then "the call authenticates client f-broker and returns the ID token"
      then "the browser never sees the ID token"
    }
  }
}
