// Example map for the story "Forward PSU context headers" (activity "Connect
// Bank B from application A", step "Request the consent").
// Fixtures: docs/design/examplemap/README.md.

examplemap "Forward PSU context headers" {
  product "berlin-psd2-sandbox"

  delivery "Walking skeleton" release
  delivery "MVP" release
  delivery "Hardening" release

  story "Forward PSU context headers" ~analysing @MVP +tpp-a +"spec 4.8" {
    as "Bank B security officer"
    want "A to send PSU-IP-Address, PSU-User-Agent, PSU-Device-ID and geo location"
    so "the risk engine can assess the session"
    question "Does A ask the browser for geolocation at all, given the permission prompt it causes?" +"ask product"
  }

  rule "A call made while the PSU's browser request is in flight carries the PSU's context" +"spec 4.8" {
    example "Consent creation carries all four headers" @MVP +nominal {
      given "Anna's browser request comes from 192.168.8.78 with user agent 'Mozilla/5.0 (Macintosh…) Safari/605.1.15', device cookie 3f1d2c3a-… and the browser reported latitude 52.506931 longitude 13.144558"
      when "A sends POST /v1/consents"
      then "PSU-IP-Address is 192.168.8.78, PSU-User-Agent is the browser's user agent, PSU-Device-ID is 3f1d2c3a-…, PSU-Geo-Location is GEO:52.506931;13.144558"
    }
    example "The account list requested by Anna carries the headers" @MVP +nominal {
      given "Anna clicks 'View accounts'"
      when "A sends GET /v1/accounts"
      then "PSU-IP-Address is Anna's address"
    }
    example "Without geolocation permission the header is omitted" @MVP +edge {
      given "Anna denied the geolocation prompt"
      when "A sends POST /v1/consents"
      then "PSU-Geo-Location is absent and the other three headers are present"
    }
    example "An IPv6 address is forwarded as is" @MVP +edge {
      given "Anna's browser request comes from 2001:db8::1"
      when "A sends the call"
      then "PSU-IP-Address is 2001:db8::1"
    }
  }

  rule "The address is the PSU's, not a proxy's" {
    example "Behind A's load balancer the first X-Forwarded-For hop is used" @MVP +nominal {
      given "the request reaches A with X-Forwarded-For '192.168.8.78, 10.0.0.5' from the trusted load balancer 10.0.0.5"
      when "A sends the call"
      then "PSU-IP-Address is 192.168.8.78"
    }
    example "An X-Forwarded-For from an untrusted peer is ignored" @MVP +error {
      given "a request to A directly from 203.0.113.9 with X-Forwarded-For '1.2.3.4'"
      when "A sends the call"
      then "PSU-IP-Address is 203.0.113.9"
    }
  }

  rule "A background call sends no PSU header at all, so Bank B counts it" +"spec 6" {
    example "The nightly refresh has no PSU headers" @MVP +nominal {
      given "the scheduler refreshes Anna's accounts at 03:00"
      when "A sends GET /v1/accounts"
      then "none of PSU-IP-Address, PSU-User-Agent, PSU-Device-ID, PSU-Geo-Location is present"
    }
    example "A cached address is never replayed on a background call" @MVP +error {
      given "A stored Anna's last address 192.168.8.78 from the morning"
      when "the scheduler calls at 03:00"
      then "PSU-IP-Address is absent"
    }
    example "A PSU click after a background call is again marked present" @MVP +edge {
      given "the 03:00 background call was counted"
      when "Anna opens the account list at 08:00"
      then "the call carries PSU-IP-Address and is not counted"
    }
  }

  rule "Header values are well-formed" {
    example "Geo location is formatted GEO:lat;lon with a dot decimal separator" @MVP +nominal {
      given "latitude 52.506931 and longitude 13.144558"
      when "the header is built"
      then "PSU-Geo-Location is exactly GEO:52.506931;13.144558"
    }
    example "A user agent longer than the bank accepts is truncated, not dropped" @MVP +edge {
      given "a user agent of 600 characters"
      when "the header is built"
      then "PSU-User-Agent has 512 characters"
    }
    example "PSU-Device-ID is a UUID v4 stored in a first-party cookie for one year" @MVP +nominal {
      given "Anna's first visit"
      when "A sets the device cookie"
      then "its value is a UUID v4 and it is sent as PSU-Device-ID on later calls"
    }
  }
}
