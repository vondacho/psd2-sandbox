// Example map for the story "Terminate the XS2A TLS with a client certificate"
// (activity "Connect the Bank from the TPP", step "Request the consent").
// Fixtures: docs/design/examplemap/README.md.

examplemap "Terminate the XS2A TLS with a client certificate" {
  product "OBI"

  delivery "Walking skeleton" release
  delivery "MVP" release
  delivery "Hardening" release

  story "Terminate the XS2A TLS with a client certificate" ~ready @"Walking skeleton" +bank-xs2a +security +"spec 3" {
    as "Bank security officer"
    want "every XS2A call to present a client certificate and be refused otherwise"
    so "only identified TPPs reach the API"
  }

  rule "The TLS handshake on the XS2A endpoint requires a client certificate chained to a trusted CA" +"spec 3" {
    example "The TPP's QWAC from the sandbox CA completes the handshake" @"Walking skeleton" +nominal {
      given "the TPP presents the QWAC issued by the sandbox CA for PSDDE-BAFIN-123456"
      when "the TPP opens a TLS connection to api.bank.sandbox"
      then "the handshake completes"
      then "the request reaches the XS2A service"
    }
    example "A connection without client certificate is closed during the handshake" @"Walking skeleton" +error {
      given "a client that presents no certificate"
      when "it opens a TLS connection to api.bank.sandbox"
      then "the gateway closes the connection with a TLS alert"
      then "no HTTP response is produced"
    }
    example "A certificate from an unknown CA is refused during the handshake" @"Walking skeleton" +error {
      given "a client certificate issued by a self-signed CA the gateway does not trust"
      when "it opens a TLS connection"
      then "the handshake fails with unknown_ca"
    }
    example "A public web-server certificate is refused" @"Walking skeleton" +error {
      given "a certificate from a public CA without client-authentication usage"
      when "it is presented as client certificate"
      then "the handshake fails"
    }
    example "The requirement holds for every path under /psd2" @"Walking skeleton" +nominal {
      given "no client certificate"
      when "GET /psd2/v1/accounts and POST /psd2/v1/consents are attempted"
      then "both fail at the handshake"
    }
  }

  rule "Only TLS 1.2 and 1.3 are accepted" +security {
    example "TLS 1.3 is accepted" @"Walking skeleton" +nominal {
      given "a client offering TLS 1.3 only"
      when "it connects with the TPP's QWAC"
      then "the handshake completes with TLS 1.3"
    }
    example "TLS 1.2 is accepted" @"Walking skeleton" +nominal {
      given "a client offering TLS 1.2 only"
      when "it connects with the TPP's QWAC"
      then "the handshake completes with TLS 1.2"
    }
    example "TLS 1.1 is refused" @"Walking skeleton" +error {
      given "a client offering TLS 1.1 at most"
      when "it connects"
      then "the handshake fails with protocol_version"
    }
  }

  rule "The gateway forwards the verified certificate to the service and strips any client-supplied copy" +security {
    example "The service sees the PEM of the presented certificate" @"Walking skeleton" +nominal {
      given "the TPP connects with its QWAC"
      when "the request is forwarded to the XS2A service"
      then "the header X-Client-Cert holds the URL-encoded PEM of the TPP's QWAC"
    }
    example "A forged X-Client-Cert header from the client is replaced" @"Walking skeleton" +error {
      given "the TPP connects with its QWAC and adds a header X-Client-Cert containing C's certificate"
      when "the request is forwarded"
      then "the service sees the TPP's certificate, not C's"
    }
    example "The service refuses a request that reaches it without the forwarded certificate" @MVP +error {
      given "a request that bypasses the gateway and hits the service port directly"
      when "the service receives it without X-Client-Cert"
      then "the service answers 401 CERTIFICATE_MISSING"
    }
  }

  rule "Server-side TLS is strong and the service identity is verifiable" {
    example "The server certificate names api.bank.sandbox" @"Walking skeleton" +nominal {
      given "the TPP validates the server certificate"
      when "it connects to api.bank.sandbox"
      then "the certificate's SAN contains api.bank.sandbox"
    }
    example "Only AEAD cipher suites are offered" @MVP +edge {
      given "a client offering only TLS_RSA_WITH_AES_128_CBC_SHA"
      when "it connects"
      then "the handshake fails with handshake_failure"
    }
  }
}
