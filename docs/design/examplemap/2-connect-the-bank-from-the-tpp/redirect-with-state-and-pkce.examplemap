// Example map for the story "Redirect with state and PKCE" (activity "Connect
// the Bank from the TPP", step "Start the authorization at the OIDC-provider").
// Fixtures: docs/design/examplemap/README.md.

examplemap "Redirect with state and PKCE" {
  product "berlin-psd2-sandbox"

  delivery "Walking skeleton" release
  delivery "MVP" release
  delivery "Hardening" release

  story "Redirect with state and PKCE" ~ready @"Walking skeleton" +tpp +security +"spec 13.1" +"RFC 7636" {
    as "PSU"
    want "the TPP to send me to the OIDC-provider with a one-time state bound to my session and an S256 code challenge"
    so "nobody can inject a code into my session"
  }

  rule "state is 32 random bytes, base64url, stored with the session, the consent and a 10-minute expiry" +"spec 7.6.1" {
    example "A fresh state is created for each authorization" @"Walking skeleton" +nominal {
      given "Anna's session sess-anna and consent 123cons456"
      when "the TPP starts the authorization"
      then "an AuthorizationAttempt exists with a 43-character base64url state, userSessionId sess-anna, consentId 123cons456, startedAt now, outcome pending"
    }
    example "Two authorizations in the same session get two states" @MVP +edge {
      given "Anna connects the Bank and Bank C in two tabs"
      when "both authorizations start"
      then "two attempts exist with different states"
    }
    example "The state is not derivable from the session id or the consent id" @"Walking skeleton" +nominal {
      given "1000 generated states"
      when "they are compared"
      then "no two are equal and none contains the session id or consent id"
    }
  }

  rule "The PKCE verifier is 43 to 128 unreserved characters and the challenge is BASE64URL(SHA-256(verifier)) with method S256" +"RFC 7636" {
    example "The RFC 7636 test vector" @"Walking skeleton" +nominal {
      given "the verifier dBjftJeZ4CVP-mB92K27uhbUJU1p1r_wW1gFWFOEjXk"
      when "the challenge is computed"
      then "it is E9Melhoa2OwvFrEMTJguCHaoeK1t8URWbuGJSstw-cM"
    }
    example "A generated verifier has 64 characters from the unreserved set" @"Walking skeleton" +nominal {
      given "the TPP generates a verifier"
      when "it is inspected"
      then "it has 64 characters, all in [A-Za-z0-9-._~]"
    }
    example "The verifier is stored server-side only" @"Walking skeleton" +nominal {
      given "the authorization started"
      when "the response to the browser is inspected"
      then "neither the redirect URL nor any cookie contains the verifier"
    }
  }

  rule "The authorization URL carries exactly the parameters of the code flow with PKCE" +"spec 13.1" {
    example "The redirect for consent 123cons456" @"Walking skeleton" +nominal {
      given "client PSDDE-BAFIN-123456, consent 123cons456, state S8NJ7…, challenge 5c3055…"
      when "the TPP answers the browser"
      then "it is a 302 to https://oidc-provider.sandbox/authorize with response_type=code, client_id=PSDDE-BAFIN-123456, scope=AIS:123cons456 offline_access, state=S8NJ7…, redirect_uri=https://tpp.sandbox/xs2a/callback/bank, code_challenge=5c3055…, code_challenge_method=S256"
    }
    example "The scope is URL-encoded" @"Walking skeleton" +edge {
      given "scope AIS:123cons456 offline_access"
      when "the URL is built"
      then "the query contains scope=AIS%3A123cons456%20offline_access"
    }
    example "No client secret is ever in the URL" @"Walking skeleton" +nominal {
      given "the redirect URL"
      when "it is inspected"
      then "it has no client_secret, no code_verifier and no bearer token"
    }
    example "The redirect_uri equals the TPP-Redirect-URI sent to the Bank" @"Walking skeleton" +nominal {
      given "TPP-Redirect-URI https://tpp.sandbox/xs2a/callback/bank was sent at consent creation"
      when "the URL is built"
      then "redirect_uri is https://tpp.sandbox/xs2a/callback/bank"
    }
  }

  rule "The attempt is single-use and expires" {
    example "An attempt older than ten minutes is expired" @MVP +edge {
      given "an attempt started at 09:00 with no callback"
      when "the clock reaches 09:10"
      then "the attempt outcome is expired"
      then "a callback with its state is refused"
    }
    example "A consumed attempt cannot be reused" @"Walking skeleton" +error {
      given "an attempt whose callback was processed"
      when "a second callback with the same state arrives"
      then "it is refused"
    }
    example "Starting over creates a new attempt and expires the pending one" @MVP +edge {
      given "an attempt is pending for 123cons456"
      when "Anna clicks 'Start over'"
      then "a new attempt with a new state exists and the old one is expired"
    }
  }
}
