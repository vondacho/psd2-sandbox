// Example map for the story "Validate the QWAC and its PSD2 roles" (activity
// "Connect the Bank from the TPP", step "Request the consent").
// Fixtures: docs/design/examplemap/README.md.

examplemap "Validate the QWAC and its PSD2 roles" {
  product "berlin-psd2-sandbox"

  delivery "Walking skeleton" release
  delivery "MVP" release
  delivery "Hardening" release

  story "Validate the QWAC and its PSD2 roles" ~analysing @MVP +bank-xs2a +security +"spec 3" {
    as "Bank security officer"
    want "the certificate chain, revocation and the AISP role checked on every call"
    so "a revoked or non-AISP certificate gets CERTIFICATE_* or ROLE_INVALID"
    question "When the OCSP responder or CRL is unreachable, does the Bank fail open with the last good CRL or fail closed?" +"ask bank" +security
    question "How long may a validation result be cached per certificate serial: 10 minutes as assumed here?" +"ask bank"
  }

  rule "The chain must end at a trusted qualified trust service provider; in the sandbox, at the sandbox CA" +"spec 3" +"ETSI TS 119 495" {
    example "The TPP's QWAC chained to the sandbox CA is accepted" @MVP +nominal {
      given "the TPP's QWAC issued by the sandbox CA"
      when "POST /v1/consents is called"
      then "the call proceeds to request validation"
    }
    example "A certificate whose intermediate is missing is refused" @MVP +error {
      given "a client sends a leaf certificate without its intermediate and the gateway has no path to the root"
      when "the call is made"
      then "the answer is 401 CERTIFICATE_INVALID"
    }
    example "A certificate without a PSD2 QcStatement is refused" @MVP +error {
      given "a certificate from the sandbox CA issued without the qcStatements extension"
      when "POST /v1/consents is called"
      then "the answer is 401 CERTIFICATE_INVALID with text 'PSD2 QcStatement missing'"
    }
    example "A certificate whose organizationIdentifier is malformed is refused" @MVP +error {
      given "a certificate with organizationIdentifier 'ACME-123' (no PSD prefix, no NCA)"
      when "the call is made"
      then "the answer is 401 CERTIFICATE_INVALID with text 'organizationIdentifier invalid'"
    }
  }

  rule "Validity period and revocation are checked on every call" +"spec 14.11" {
    example "An expired certificate gets CERTIFICATE_EXPIRED" @MVP +error {
      given "a QWAC with notAfter 2026-09-05T23:59:59Z and today 2026-09-06"
      when "GET /v1/accounts is called"
      then "the answer is 401 CERTIFICATE_EXPIRED"
    }
    example "A revoked certificate gets CERTIFICATE_REVOKED" @MVP +error {
      given "the TPP's QWAC serial 0x1A2B is on the sandbox CA's CRL"
      when "GET /v1/accounts is called"
      then "the answer is 401 CERTIFICATE_REVOKED"
    }
    example "A certificate blocked by the Bank gets CERTIFICATE_BLOCKED" @MVP +error {
      given "the Bank's operator put serial 0x1A2B on the local block list"
      when "GET /v1/accounts is called"
      then "the answer is 401 CERTIFICATE_BLOCKED"
    }
    example "A certificate not yet valid gets CERTIFICATE_INVALID" @MVP +error {
      given "a QWAC with notBefore 2026-09-07T00:00:00Z and now 2026-09-06T12:00:00Z"
      when "the call is made"
      then "the answer is 401 CERTIFICATE_INVALID"
    }
    example "A revocation published a minute ago is honoured on the next call" @MVP +edge {
      given "the TPP's QWAC was validated and cached at 10:00 and revoked at 10:05"
      when "the TPP calls at 10:11"
      then "the answer is 401 CERTIFICATE_REVOKED"
    }
    example "A certificate expiring in the middle of a session still works until notAfter" @MVP +edge {
      given "a QWAC with notAfter 2026-09-06T12:00:00Z"
      when "the TPP calls at 11:59:59Z"
      then "the call is served"
    }
  }

  rule "The endpoint's role must be in the certificate's PSD2 roles" +"spec 3" {
    example "A certificate with AISP and PISP may create consents" @MVP +nominal {
      given "the TPP's QWAC with roles PSP_AI and PSP_PI"
      when "POST /v1/consents is called"
      then "the call is served"
    }
    example "A PISP-only certificate may not create consents" @MVP +error {
      given "C's QWAC with role PSP_PI only"
      when "POST /v1/consents is called"
      then "the answer is 401 ROLE_INVALID"
    }
    example "A PISP-only certificate may not read accounts" @MVP +error {
      given "C's QWAC with role PSP_PI only and a stolen valid token of the TPP"
      when "GET /v1/accounts is called"
      then "the answer is 401 ROLE_INVALID before any token check"
    }
    example "An AISP-only certificate may not initiate payments" @MVP +error {
      given "a QWAC with role PSP_AI only"
      when "POST /v1/payments/sepa-credit-transfers is called"
      then "the answer is 401 ROLE_INVALID"
    }
    example "A PIISP-only certificate may not read accounts" @MVP +error {
      given "a QWAC with role PSP_IC only"
      when "GET /v1/accounts is called"
      then "the answer is 401 ROLE_INVALID"
    }
  }

  rule "The organizationIdentifier of the certificate is the TPP identity for everything that follows" {
    example "The consent is created for PSDDE-BAFIN-123456" @MVP +nominal {
      given "the TPP's QWAC with organizationIdentifier PSDDE-BAFIN-123456"
      when "POST /v1/consents succeeds"
      then "the consent's tppId is PSDDE-BAFIN-123456"
    }
    example "A renewed certificate with the same organizationIdentifier keeps the identity" @MVP +edge {
      given "the TPP replaces its QWAC with a new one carrying PSDDE-BAFIN-123456"
      when "GET /v1/consents/123cons456/status is called with the new certificate"
      then "the consent is found and served"
    }
    example "The error body follows the tppMessages format" @MVP +nominal {
      given "a revoked certificate"
      when "the call is refused"
      then "the body is {tppMessages: [{category: ERROR, code: CERTIFICATE_REVOKED, text: …}]}"
      then "the response carries the request's X-Request-ID"
    }
  }
}
