// Example map for the story "Issue a refresh token capped by validUntil"
// (activity "Complete the connection", step "Exchange the code for tokens").
// Fixtures: docs/design/examplemap/README.md.

examplemap "Issue a refresh token capped by validUntil" {
  product "OBI"

  delivery "Walking skeleton" release
  delivery "MVP" release
  delivery "Hardening" release

  story "Issue a refresh token capped by validUntil" ~analysing @MVP +oidc-provider +"spec 13.5" {
    as "PSU"
    want "the TPP to keep access for the life of my consent without asking me again"
    so "I authenticate once per consent, not per visit"
    question "Which time zone defines the end of validUntil: the Bank's (Europe/Berlin) as assumed here, or UTC?" +"ask bank"
  }

  rule "The refresh token expires at the end of the consent's validUntil day in the Bank's time zone, or after 180 days, whichever is first" +"spec 13.5" {
    example "validUntil 2026-12-05" @MVP +nominal {
      given "consent 123cons456 with validUntil 2026-12-05"
      when "the refresh token is issued on 2026-09-06"
      then "it expires at 2026-12-05T23:59:59+01:00"
    }
    example "validUntil today" @MVP +edge {
      given "a consent with validUntil 2026-09-06"
      when "the refresh token is issued at 2026-09-06T09:13:20Z"
      then "it expires at 2026-09-06T23:59:59+02:00"
    }
    example "validUntil shortened by the bank" @MVP +edge {
      given "the TPP asked 2027-09-06 and the bank stored 2027-03-05"
      when "the refresh token is issued"
      then "it expires at 2027-03-05T23:59:59+01:00"
    }
    example "The 180-day cap" @MVP +edge {
      given "a bank configured with 365 days and validUntil 2027-09-06"
      when "the refresh token is issued on 2026-09-06"
      then "it expires at 2027-03-05T23:59:59+01:00"
    }
    example "The refresh token is opaque" @MVP +nominal {
      given "the refresh token tGzv3JokF0XG5Qx2TlKWIA"
      when "it is inspected"
      then "it is not a JWT and reveals nothing about the consent"
    }
  }

  rule "A refresh over mTLS with the same certificate, while the consent is valid, yields a new access token with the same scope and binding and a rotated refresh token" +"spec 13.5" +"RFC 8705" {
    example "The nominal refresh" @MVP +nominal {
      given "grant g1 with refresh token R1 and consent 123cons456 valid"
      when "the TPP posts grant_type=refresh_token, refresh_token=R1, client_id=PSDDE-BAFIN-123456 with its QWAC"
      then "the OIDC-provider asks consent management and gets status valid"
      then "the answer has a new access token with the same scope, sub and cnf, and a new refresh token R2"
      then "R1 is invalid from now on"
    }
    example "A revoked consent" @MVP +error {
      given "consent 123cons456 revokedByPsu"
      when "the TPP refreshes with R1"
      then "the OIDC-provider answers 400 invalid_grant with error_description 'consent no longer valid'"
      then "the TPP marks the connection needsReconsent"
    }
    example "An expired consent" @MVP +error {
      given "consent 123cons456 expired"
      when "the TPP refreshes"
      then "the OIDC-provider answers 400 invalid_grant"
    }
    example "A refresh after the refresh token's own expiry" @MVP +error {
      given "R1 expired at 2026-12-05T23:59:59+01:00"
      when "the TPP refreshes on 2026-12-06"
      then "the OIDC-provider answers 400 invalid_grant"
    }
    example "A refresh with another certificate of the same client" @MVP +edge {
      given "the TPP's new QWAC bound as second certificate"
      when "the TPP refreshes R1 with the new QWAC"
      then "the OIDC-provider issues an access token bound to the new certificate's thumbprint"
    }
    example "A refresh with C's certificate" @MVP +error {
      given "R1 of the TPP"
      when "C posts it with its QWAC"
      then "the OIDC-provider answers 401 invalid_client"
    }
    example "A refresh without mTLS" @MVP +error {
      given "R1"
      when "it is posted without client certificate"
      then "the OIDC-provider answers 401 invalid_client"
    }
    example "A rotated refresh token used again revokes the grant" @MVP +error {
      given "R1 was rotated to R2"
      when "R1 is posted again"
      then "the OIDC-provider answers 400 invalid_grant and revokes R2 and every access token of g1"
      then "the event is logged as a refresh-token replay"
    }
  }

  rule "A one-off consent gets no refresh token" +"spec 13.5" {
    example "recurringIndicator false" @MVP +nominal {
      given "consent 777cons888 with recurringIndicator false"
      when "the tokens are issued"
      then "the response has no refresh_token"
    }
    example "A refresh attempt for a one-off consent" @MVP +error {
      given "no refresh token exists for 777cons888"
      when "the TPP posts grant_type=refresh_token with any value"
      then "the OIDC-provider answers 400 invalid_grant"
    }
  }
}
