// Example map for the story "Issue a certificate-bound JWT scoped to the
// consent" (activity "Complete the connection", step "Exchange the code for
// tokens"). Fixtures: docs/design/examplemap/README.md.

examplemap "Issue a certificate-bound JWT scoped to the consent" {
  product "berlin-psd2-sandbox"

  delivery "Walking skeleton" release
  delivery "MVP" release
  delivery "Hardening" release

  story "Issue a certificate-bound JWT scoped to the consent" ~ready @"Walking skeleton" +oidc-f +security +"spec 13.4" +"RFC 8705" {
    as "Bank B security officer"
    want "an access token with aud, scope AIS:<consentId>, cnf thumbprint and a short lifetime"
    so "a leaked token cannot be used without A's private key"
  }

  rule "The access token is an ES256 JWT with issuer, pairwise subject, Bank B's API as audience, the client id, the scope, the consent id, acr, amr, the certificate thumbprint, iat, exp and jti" +"spec 13.4" {
    example "The claims of the nominal token" @"Walking skeleton" +nominal {
      given "the exchange for grant g1 at 2026-09-06T09:13:20Z (1757150000) by A with QWAC thumbprint bwcK0…"
      when "F issues the access token"
      then "the header has alg ES256 and kid f-2026"
      then "the claims are iss https://f.sandbox, sub 8f6c2b1e-…, aud https://api.bank-b.sandbox/psd2, client_id PSDDE-BAFIN-123456, scope 'AIS:123cons456 offline_access', consent_id 123cons456, acr urn:bank-b:psd2:sca, amr [pwd, hwk], cnf {x5t#S256: bwcK0…}, iat 1757150000, exp 1757150600, jti unique"
    }
    example "The token verifies against F's JWKS" @"Walking skeleton" +nominal {
      given "the token"
      when "Bank B fetches https://f.sandbox/jwks and verifies with kid f-2026"
      then "the signature is valid"
    }
    example "Two tokens never share a jti" @"Walking skeleton" +nominal {
      given "1000 tokens"
      when "their jti values are compared"
      then "all are distinct"
    }
    example "The token carries no bank PSU-ID and no IBAN" @"Walking skeleton" +nominal {
      given "the token"
      when "its claims are listed"
      then "there is no psu_id, iban or account claim, and sub is not anna.mueller"
    }
  }

  rule "The token lives at most ten minutes" +"spec 13.4" {
    example "exp is iat plus 600" @"Walking skeleton" +nominal {
      given "iat 1757150000"
      when "the token is issued"
      then "exp is 1757150600 and expires_in is 600"
    }
    example "A configured lifetime above ten minutes is capped" @MVP +edge {
      given "F configured with access token lifetime 3600"
      when "F starts"
      then "it refuses the configuration with 'access token lifetime must be at most 600'"
    }
    example "Bank B refuses the token one second after exp" @MVP +edge {
      given "exp 1757150600"
      when "GET /v1/accounts is called at 1757150601"
      then "the answer is 401 TOKEN_EXPIRED"
    }
  }

  rule "The cnf thumbprint is the SHA-256 of the DER certificate presented at the token endpoint, base64url without padding" +"RFC 8705" {
    example "The thumbprint of A's QWAC" @"Walking skeleton" +nominal {
      given "A's QWAC DER bytes"
      when "the thumbprint is computed"
      then "it equals base64url(SHA-256(DER)) without '=' padding and matches cnf.x5t#S256"
    }
    example "A renewed QWAC gives a different thumbprint" @MVP +edge {
      given "A exchanges a code with its new QWAC"
      when "the token is issued"
      then "cnf.x5t#S256 is the thumbprint of the new certificate"
    }
    example "Metadata advertises certificate-bound tokens" @"Walking skeleton" +nominal {
      given "F's metadata"
      when "it is read"
      then "tls_client_certificate_bound_access_tokens is true"
    }
  }

  rule "The scope of the token is the scope that was authorised, and a refresh token is issued for recurring access" +"spec 13.5" {
    example "offline_access requested: refresh token issued" @"Walking skeleton" +nominal {
      given "scope 'AIS:123cons456 offline_access' authorised"
      when "the tokens are issued"
      then "the response includes a refresh_token and scope 'AIS:123cons456 offline_access'"
    }
    example "Recurring consent without offline_access: refresh token still issued" @MVP +edge {
      given "scope 'AIS:123cons456' authorised and the consent is recurring"
      when "the tokens are issued"
      then "the response includes a refresh_token"
    }
    example "One-off consent without offline_access: no refresh token" @MVP +edge {
      given "scope 'AIS:777cons888' for a one-off consent"
      when "the tokens are issued"
      then "the response has no refresh_token"
    }
    example "The token scope never widens" @"Walking skeleton" +nominal {
      given "scope 'AIS:123cons456' authorised"
      when "the token is issued"
      then "scope contains no PIS entry and no second AIS entry"
    }
  }

  rule "F's signing key rotates without breaking verification" {
    example "The old kid stays in the JWKS for 24 hours" @MVP +edge {
      given "F rotated from kid f-2026 to f-2026b at 10:00"
      when "Bank B verifies a token signed with f-2026 at 12:00"
      then "the JWKS still holds f-2026 and the verification succeeds"
    }
    example "New tokens use the new kid" @MVP +nominal {
      given "the rotation"
      when "a token is issued at 10:01"
      then "its header kid is f-2026b"
    }
  }
}
