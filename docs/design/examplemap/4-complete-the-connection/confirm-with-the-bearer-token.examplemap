// Example map for the story "Confirm with the bearer token" (activity "Complete
// the connection", step "Confirm the authorisation").
// Fixtures: docs/design/examplemap/README.md.

examplemap "Confirm with the bearer token" {
  product "berlin-psd2-sandbox"

  delivery "Walking skeleton" release
  delivery "MVP" release
  delivery "Hardening" release

  story "Confirm with the bearer token" ~analysing @MVP +tpp +bank-xs2a +"spec 7.6.4" {
    as "Bank security officer"
    want "the TPP to PUT the authorisation with its token and the Bank to check consent id and client before finalising"
    so "the consent becomes valid only for the TPP that created it"
    question "When no confirmation link was returned and the TPP still sends the PUT, is it a harmless 200 or a 405?" +"ask bank" +"spec 7.6.4"
  }

  rule "A PUT on the authorisation with a bearer token whose consent id and client match the resource finalises an unconfirmed authorisation and validates the consent" +"spec 7.6.4" {
    example "The nominal confirmation" @MVP +nominal {
      given "authorisation 123auth567 of 123cons456 is unconfirmed and the TPP holds a token with consent_id 123cons456, client_id PSDDE-BAFIN-123456"
      when "the TPP calls PUT /v1/consents/123cons456/authorisations/123auth567 with Authorization: Bearer, X-Request-ID and body {}"
      then "the answer is 200 {scaStatus: finalised}"
      then "the consent status is valid"
    }
    example "The TPP confirms right after the token exchange" @MVP +nominal {
      given "the connection holds a confirmation link"
      when "the token exchange succeeds"
      then "the TPP sends the PUT before any GET /v1/accounts"
    }
    example "The PUT is idempotent" @MVP +edge {
      given "the authorisation is already finalised"
      when "the TPP repeats the PUT"
      then "the answer is 200 {scaStatus: finalised}"
    }
  }

  rule "A token for another consent, another client or none at all does not confirm" +security {
    example "A token for another consent of the TPP" @MVP +error {
      given "a token with consent_id 111cons222"
      when "the TPP PUTs on 123cons456/authorisations/123auth567"
      then "the answer is 401 TOKEN_INVALID and the authorisation stays unconfirmed"
    }
    example "A token of the TPP presented over C's certificate" @MVP +error {
      given "the TPP's token and C's QWAC"
      when "the PUT is sent"
      then "the answer is 401 TOKEN_INVALID"
    }
    example "No token" @MVP +error {
      given "the PUT without Authorization"
      when "it is sent"
      then "the answer is 401 TOKEN_INVALID"
    }
    example "An expired token" @MVP +error {
      given "an access token past exp"
      when "the PUT is sent"
      then "the answer is 401 TOKEN_EXPIRED"
      then "the TPP refreshes and repeats the PUT once"
    }
    example "A consent created by C confirmed by the TPP" @MVP +error {
      given "consent 333cons444 of C and a token of the TPP for it (impossible to obtain; a forged one fails signature)"
      when "the PUT is sent"
      then "the answer is 401 TOKEN_INVALID"
    }
  }

  rule "Confirmation is possible only in the unconfirmed state" +"spec 14.16" {
    example "PUT while started" @MVP +error {
      given "the authorisation is started (no device approval yet)"
      when "the TPP PUTs"
      then "the answer is 409 STATUS_INVALID and the status stays started"
    }
    example "PUT while failed" @MVP +error {
      given "the authorisation is failed"
      when "the TPP PUTs"
      then "the answer is 409 STATUS_INVALID"
    }
    example "PUT on a rejected consent" @MVP +error {
      given "consent 123cons456 rejected"
      when "the TPP PUTs"
      then "the answer is 409 STATUS_INVALID"
    }
  }

  rule "Until confirmed, the consent serves nothing" {
    example "GET /v1/accounts before the PUT" @MVP +error {
      given "unconfirmed authorisation and a valid token"
      when "the TPP calls GET /v1/accounts"
      then "the answer is 401 CONSENT_INVALID"
    }
    example "GET /v1/accounts after the PUT" @MVP +nominal {
      given "the PUT answered finalised"
      when "the TPP calls GET /v1/accounts"
      then "the answer is 200"
    }
  }
}
