// Example map for the story "Explain a refusal to the PSU" (activity
// "Authenticate and approve at Bank B", step "Identify and enter my password").
// Fixtures: docs/design/examplemap/README.md.

examplemap "Explain a refusal to the PSU" {
  product "berlin-psd2-sandbox"

  delivery "Walking skeleton" release
  delivery "MVP" release
  delivery "Hardening" release

  story "Explain a refusal to the PSU" ~analysing @MVP +bank-b-ciam {
    as "PSU"
    want "a clear message and a way back to A when Bank B refuses"
    so "I am not left on a dead page"
    question "After how long is a consent that the PSU simply abandoned (tab closed) moved from received to rejected: 30 minutes as assumed here?" +"ask bank-b" +"spec 14.15"
  }

  rule "Every refusal page names the cause in plain words, shows a reference id and offers a way back to the TPP" {
    example "Locked access" @MVP +nominal {
      given "the fifth wrong password locked anna.mueller in the session for App A"
      when "the refusal page renders"
      then "it says 'Your access to Bank B is locked. Contact Bank B to unlock it.'"
      then "it shows 'Reference BB-2026-09-06-8F3A'"
      then "it has the button 'Back to App A'"
    }
    example "No registered device" @MVP +nominal {
      given "Anna has no active device"
      when "the refusal page renders"
      then "it says 'You have no registered device to approve with. Activate the Bank B app first.'"
      then "it links to the device enrolment help"
    }
    example "Challenge expired for the last time" @MVP +nominal {
      given "the third QR code expired"
      when "the refusal page renders"
      then "it says 'The approval was not completed in time. Start again from App A.'"
    }
    example "Session expired" @MVP +nominal {
      given "ten minutes of inactivity on the login page"
      when "the refusal page renders"
      then "it says 'Your session expired. Start again from App A.'"
    }
    example "Risk refusal" @MVP +nominal {
      given "the risk engine refused"
      when "the refusal page renders"
      then "it says 'Bank B cannot continue this request. Contact Bank B and quote the reference.'"
    }
    example "The PSU declined" @MVP +nominal {
      given "Anna clicked 'Decline' on the consent summary"
      when "the refusal page renders"
      then "it says 'You declined. App A was not given access.'"
    }
  }

  rule "The way back goes through F to the TPP's nok redirect URI with error=access_denied and the TPP's state" +"spec 7.6" {
    example "Back to App A lands on the nok URI" @MVP +nominal {
      given "consent 123cons456 has TPP-Nok-Redirect-URI https://a.tpp.sandbox/xs2a/callback/bank-b?outcome=nok"
      when "Anna clicks 'Back to App A'"
      then "the browser ends at https://a.tpp.sandbox/xs2a/callback/bank-b?outcome=nok&error=access_denied&state=S8NJ7…"
    }
    example "Without a nok URI the ok URI is used with an error parameter" @MVP +edge {
      given "the consent has no TPP-Nok-Redirect-URI"
      when "Anna clicks 'Back to App A'"
      then "the browser ends at https://a.tpp.sandbox/xs2a/callback/bank-b?error=access_denied&state=S8NJ7…"
    }
    example "The button is shown even when the redirect fails" @MVP +edge {
      given "A's callback answers 502"
      when "Anna clicks 'Back to App A'"
      then "the browser shows A's error, and the CIAM page had told her 'If App A does not open, return to it manually'"
    }
  }

  rule "A refusal reveals nothing that helps an attacker" +security {
    example "Unknown customer id and wrong password read the same" @MVP +nominal {
      given "two refusals: unknown id, wrong password"
      when "the pages are compared"
      then "the text is identical"
    }
    example "The page does not say which factor failed after the password" @MVP +nominal {
      given "a risk refusal"
      when "the page renders"
      then "it does not mention risk, address or device"
    }
    example "The reference id is random and maps to the log only inside Bank B" @MVP +nominal {
      given "reference BB-2026-09-06-8F3A"
      when "support searches for it"
      then "one audit entry with the full cause is found"
      then "the reference is not derivable from the consent id or PSU-ID"
    }
  }

  rule "The consent and the authorisation reflect the refusal immediately" +"spec 14.15" {
    example "A reads rejected right after the refusal" @MVP +nominal {
      given "the refusal page rendered for 123cons456"
      when "A calls GET /v1/consents/123cons456/status"
      then "the answer is rejected"
    }
    example "An abandoned session is rejected after 30 minutes" @MVP +edge {
      given "Anna closed the tab at 09:00 with the consent received"
      when "the clock reaches 09:31"
      then "the consent is rejected and the authorisation failed"
    }
  }
}
