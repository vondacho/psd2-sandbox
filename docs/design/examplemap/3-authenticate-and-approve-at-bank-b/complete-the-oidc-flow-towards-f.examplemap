// Example map for the story "Complete the OIDC flow towards F" (activity
// "Authenticate and approve at Bank B", step "Return to application A").
// Fixtures: docs/design/examplemap/README.md.

examplemap "Complete the OIDC flow towards F" {
  product "berlin-psd2-sandbox"

  delivery "Walking skeleton" release
  delivery "MVP" release
  delivery "Hardening" release

  story "Complete the OIDC flow towards F" ~ready @"Walking skeleton" +bank-b-ciam +oidc-f +"OIDC Core" {
    as "PSU"
    want "Bank B to send me back to F with an ID token that carries acr, amr and the consent id"
    so "F can issue the code for A"
  }

  rule "After the approval, the CIAM redirects the browser to F's broker callback with a code, and F redeems it over the back channel for an ID token" +"OIDC Core" {
    example "The redirect and the token" @"Walking skeleton" +nominal {
      given "session sess-1 approved for consent 123cons456, F's broker request with state st1 and nonce nc1"
      when "the QR page polls approved"
      then "the browser is redirected to https://f.sandbox/broker/callback?code=c1&state=st1"
      when "F posts code c1 to https://ciam.bank-b.sandbox/token with client f-broker"
      then "the answer holds an ID token with iss https://ciam.bank-b.sandbox, aud f-broker, nonce nc1, exp in 5 minutes, sub the CIAM's pairwise subject for F, acr urn:bank-b:psd2:sca, amr [pwd, hwk, face], consent_id 123cons456, consent_status authorised"
    }
    example "The amr reflects the methods used" @"Walking skeleton" +edge {
      given "Anna used the PIN on the device"
      when "the ID token is issued"
      then "amr is [pwd, hwk, pin]"
    }
    example "The code is single-use" @MVP +error {
      given "F redeemed c1"
      when "F posts c1 again"
      then "the CIAM answers 400 invalid_grant"
    }
    example "The code expires after 60 seconds" @MVP +error {
      given "c1 issued at 09:13:30"
      when "F redeems it at 09:14:35"
      then "the CIAM answers 400 invalid_grant"
    }
    example "A wrong client credential is refused" @MVP +error {
      given "a token request with a wrong secret for f-broker"
      when "the CIAM handles it"
      then "the answer is 401 invalid_client"
    }
    example "The browser never sees the ID token" @"Walking skeleton" +nominal {
      given "the whole flow"
      when "every browser request is inspected"
      then "no ID token appears in a URL, a fragment or a cookie"
    }
  }

  rule "An ID token is produced only for a session whose challenge is approved" +security {
    example "A refused session redirects with access_denied and no token" @MVP +error {
      given "session sess-1 refused"
      when "Anna clicks 'Back to App A'"
      then "the browser is redirected to https://f.sandbox/broker/callback?error=access_denied&state=st1"
      then "no code is issued by the CIAM"
    }
    example "A session in step approved whose challenge is not approved yields no token" @MVP +error {
      given "an inconsistent session (step approved, challenge pending)"
      when "F redeems its code"
      then "the CIAM answers 400 invalid_grant and logs the inconsistency"
    }
    example "A code cannot be minted for a session that never finished the first factor" @MVP +error {
      given "session sess-9 in step identified"
      when "the callback URL for sess-9 is forged with a code"
      then "the CIAM answers invalid_grant for that code"
    }
  }

  rule "The session is completed once, and the consent id in the token is the session's subject" {
    example "A second callback for the same session is refused" @MVP +error {
      given "sess-1 completed"
      when "the browser opens the CIAM's approved redirect again"
      then "the CIAM shows 'This request was already completed'"
    }
    example "The consent id cannot be swapped" @"Walking skeleton" +nominal {
      given "sess-1 for 123cons456"
      when "the ID token is issued"
      then "consent_id is 123cons456 and nothing in the request could change it"
    }
    example "The session records completion" @"Walking skeleton" +nominal {
      given "the token was issued at 09:13:40Z"
      when "sess-1 is read"
      then "its step is completed and completedAt is 09:13:40Z"
    }
  }
}
