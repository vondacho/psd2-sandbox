// Example map for the story "Handle a PSU with no active device" (activity
// "Authenticate and approve at Bank B", step "Approve on my registered device").
// Fixtures: docs/design/examplemap/README.md.

examplemap "Handle a PSU with no active device" {
  product "berlin-psd2-sandbox"

  delivery "Walking skeleton" release
  delivery "MVP" release
  delivery "Hardening" release

  story "Handle a PSU with no active device" ~analysing @MVP +bank-b-ciam {
    as "Bank B product owner"
    want "the journey to explain how to enrol a device or to abort cleanly"
    so "the PSU is never stuck at the QR page"
    question "Should Bank B offer a fallback second factor (SMS OTP, photoTAN) when no device is active, or is the app the only possession element?" +"ask bank-b" +"RTS art. 4"
  }

  rule "The device check happens after account selection and before any challenge; without an active device no QR is shown" {
    example "No device at all" @MVP +nominal {
      given "Ben has no device record"
      when "he approves the consent summary"
      then "no challenge is created"
      then "the page shows 'You have no registered device to approve with. Activate the Bank B app first.' with the enrolment help link and 'Back to App A'"
      then "the authorisation is failed and the consent rejected"
    }
    example "Only blocked devices" @MVP +edge {
      given "Anna's only device dev-anna-0 is blocked"
      when "she approves the summary"
      then "the same page is shown with 'Your device Old phone is blocked'"
    }
    example "Only a pending device" @MVP +edge {
      given "Anna's only device dev-anna-3 is pending"
      when "she approves the summary"
      then "the page shows 'Finish activating Anna's iPhone with the code from your letter, then start again from App A'"
    }
    example "An active device exists: the QR shows" @MVP +nominal {
      given "dev-anna-1 active"
      when "she approves the summary"
      then "a challenge is created and the QR page renders"
    }
  }

  rule "A device lost during the session is handled at the next step, never with a dead page" {
    example "The only device is blocked while the QR is pending" @MVP +edge {
      given "chl-01 pending and dev-anna-1 is blocked from another browser"
      when "chl-01 expires"
      then "'New code' is not offered and the no-device page is shown"
    }
    example "A device is enrolled while the QR is pending" @MVP +edge {
      given "chl-01 pending and dev-anna-2 becomes active meanwhile"
      when "dev-anna-2 fetches chl-01"
      then "the answer is 200 and it can approve"
    }
  }

  rule "The way back and the status are consistent with any other refusal" +"spec 14.15" {
    example "Back to App A goes to the nok URI" @MVP +nominal {
      given "the no-device page"
      when "Anna clicks 'Back to App A'"
      then "the browser ends at A's nok URI with error=access_denied and error_description 'no registered device'"
    }
    example "A reads rejected" @MVP +nominal {
      given "the no-device refusal"
      when "A calls GET /v1/consents/123cons456/status"
      then "the answer is rejected"
    }
    example "A shows a useful message" @MVP +nominal {
      given "A received error_description 'no registered device'"
      when "the callback page renders"
      then "it says 'Bank B needs its app activated on your phone before you can connect. Do that at Bank B, then try again.'"
    }
    example "The enrolment help never points into the TPP journey" @MVP +nominal {
      given "the no-device page"
      when "the enrolment link is followed"
      then "it opens Bank B's own online-banking device page, not a page of App A"
    }
  }
}
