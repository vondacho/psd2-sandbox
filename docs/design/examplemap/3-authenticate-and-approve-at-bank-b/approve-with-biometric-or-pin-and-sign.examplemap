// Example map for the story "Approve with biometric or PIN and sign" (activity
// "Authenticate and approve at Bank B", step "Approve on my registered device").
// Fixtures: docs/design/examplemap/README.md.

examplemap "Approve with biometric or PIN and sign" {
  product "berlin-psd2-sandbox"

  delivery "Walking skeleton" release
  delivery "MVP" release
  delivery "Hardening" release

  story "Approve with biometric or PIN and sign" ~ready @"Walking skeleton" +bank-b-app +sca +"RTS art. 4" {
    as "PSU"
    want "the app to sign the challenge with my device key after my biometric or PIN"
    so "possession and a local check are both needed"
  }

  rule "Approve triggers the phone's user verification, and only after success the device key signs" +"RTS art. 4" {
    example "Face ID then signature" @"Walking skeleton" +nominal {
      given "chl-01J8 loaded on dev-anna-1"
      when "Anna taps 'Approve' and Face ID succeeds"
      then "the app signs the message 'chl-01J8|m3A9…|H1' with the device key (ES256)"
      then "POST /sca/challenges/chl-01J8/response is sent with {deviceId: dev-anna-1, signature, amr: [hwk, face]}"
      then "the app shows 'Approved. Return to your browser.'"
    }
    example "PIN fallback after a failed biometric" @"Walking skeleton" +nominal {
      given "Face ID fails and the phone offers the passcode"
      when "Anna enters the passcode"
      then "the signature is made and posted with amr [hwk, pin]"
    }
    example "Cancelling the verification sends nothing" @"Walking skeleton" +error {
      given "chl-01J8 loaded"
      when "Anna cancels the Face ID prompt"
      then "no request is sent and the challenge stays pending"
      then "the screen returns to the details with the approve button"
    }
    example "Too many failed verifications send nothing" @MVP +error {
      given "biometric fails and the passcode is wrong three times"
      when "the phone locks the verification"
      then "no request is sent and the app shows 'Try again later'"
    }
    example "The key cannot sign without the verification" @"Walking skeleton" +nominal {
      given "an instrumented app that skips the prompt"
      when "it asks the keystore to sign"
      then "the keystore refuses"
    }
  }

  rule "The signed message binds the challenge id, the nonce and the dynamic-link hash" +"RTS art. 5" {
    example "The message format" @"Walking skeleton" +nominal {
      given "chl-01J8, nonce m3A9…, hash H1"
      when "the message is built"
      then "it is the UTF-8 string 'chl-01J8|m3A9…|H1'"
    }
    example "A signature cannot be precomputed before the challenge exists" @"Walking skeleton" +nominal {
      given "the nonce is generated at challenge creation"
      when "an attacker has the hash H1 in advance"
      then "the signature still needs the nonce, which is only in the challenge"
    }
    example "The signature is ES256 in raw r||s form, 64 bytes" @"Walking skeleton" +nominal {
      given "a signature from dev-anna-1"
      when "it is inspected"
      then "it is 64 bytes, base64url in the request"
    }
  }

  rule "The response is posted over the device-authenticated channel, once, and survives a flaky network" {
    example "The response is a signed request from the device" @"Walking skeleton" +nominal {
      given "the response"
      when "it is sent"
      then "it carries X-Device-Id, X-Timestamp, X-Nonce and X-Signature like the fetch"
    }
    example "A network error retries the identical request once" @MVP +edge {
      given "the first POST times out"
      when "the app retries with the same signature"
      then "the server, which had received the first, answers 409 'already answered' and the app treats it as success"
    }
    example "Expiry during the prompt" @MVP +edge {
      given "chl-01J8 expires while the Face ID prompt is open"
      when "the signature is posted"
      then "the answer is 410 and the app shows 'Code expired, request a new one on the Bank B page'"
    }
    example "The app never stores the signature or the challenge after posting" @MVP +nominal {
      given "the response was posted"
      when "the app's local storage is inspected"
      then "no challenge or signature is kept"
    }
  }
}
