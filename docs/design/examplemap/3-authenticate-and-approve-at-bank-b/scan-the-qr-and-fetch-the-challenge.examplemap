// Example map for the story "Scan the QR and fetch the challenge" (activity
// "Authenticate and approve at Bank B", step "Approve on my registered device").
// Fixtures: docs/design/examplemap/README.md.

examplemap "Scan the QR and fetch the challenge" {
  product "berlin-psd2-sandbox"

  delivery "Walking skeleton" release
  delivery "MVP" release
  delivery "Hardening" release

  story "Scan the QR and fetch the challenge" ~ready @"Walking skeleton" +bank-b-app +sca {
    as "PSU"
    want "the app to read the QR and load the challenge from Bank B over an authenticated channel"
    so "what I approve is what the bank recorded, not what the QR says"
  }

  rule "The app verifies the payload's server signature and endpoint before any network call" +security {
    example "A genuine QR is fetched" @"Walking skeleton" +nominal {
      given "the QR of chl-01J8 signed by the SCA engine with endpoint https://ciam.bank-b.sandbox/sca"
      when "Anna scans it with the app on dev-anna-1"
      then "the app calls GET https://ciam.bank-b.sandbox/sca/challenges/chl-01J8"
    }
    example "An altered payload is refused offline" @"Walking skeleton" +error {
      given "a QR whose payload was modified after signing"
      when "Anna scans it"
      then "the app shows 'Not a Bank B code'"
      then "no request is sent"
    }
    example "A payload pointing to another host is refused offline" @MVP +error {
      given "a QR with endpoint https://evil.example/sca and a signature from an unknown key"
      when "Anna scans it"
      then "the app shows 'Not a Bank B code' and sends nothing"
    }
    example "A payload with an unsupported version asks for an update" @MVP +edge {
      given "a QR with v: 2"
      when "Anna scans it with an app that supports v 1 only"
      then "the app shows 'Update the Bank B app to continue'"
    }
    example "A QR that is not a Bank B payload at all is ignored" @"Walking skeleton" +error {
      given "a QR encoding https://example.com"
      when "Anna scans it"
      then "the app shows 'Not a Bank B code'"
    }
  }

  rule "The fetch is authenticated with the device key: a signed request with the device id, a timestamp and a fresh nonce" +security {
    example "A correctly signed fetch returns the details" @"Walking skeleton" +nominal {
      given "dev-anna-1 active"
      when "the app sends GET /sca/challenges/chl-01J8 with headers X-Device-Id dev-anna-1, X-Timestamp, X-Nonce and X-Signature over method, path, timestamp and nonce"
      then "the answer is 200 with the challenge details"
    }
    example "A fetch with a bad signature is refused" @"Walking skeleton" +error {
      given "X-Signature made with another key"
      when "the fetch is sent"
      then "the answer is 401"
    }
    example "A replayed fetch is refused" @MVP +error {
      given "a fetch with nonce n1 already accepted"
      when "the same request is sent again"
      then "the answer is 401 'nonce reused'"
    }
    example "A fetch with a timestamp older than five minutes is refused" @MVP +error {
      given "X-Timestamp ten minutes in the past"
      when "the fetch is sent"
      then "the answer is 401 'stale request'"
    }
    example "A fetch from a blocked device is refused" @MVP +error {
      given "dev-anna-0 blocked"
      when "it fetches chl-01J8"
      then "the answer is 403 'device blocked'"
    }
    example "A fetch from a pending device is refused" @MVP +error {
      given "dev-anna-3 pending"
      when "it fetches chl-01J8"
      then "the answer is 403 'device not active'"
    }
  }

  rule "A challenge is only returned to an active device of the PSU it was issued for" +security {
    example "Anna's device gets Anna's challenge" @"Walking skeleton" +nominal {
      given "chl-01J8 for anna.mueller and dev-anna-1 of anna.mueller"
      when "dev-anna-1 fetches it"
      then "the answer is 200"
    }
    example "Ben's device does not get Anna's challenge" @"Walking skeleton" +error {
      given "chl-01J8 for anna.mueller and dev-ben-1 of ben.weber"
      when "dev-ben-1 fetches it"
      then "the answer is 403 'challenge not for this device'"
      then "the app shows 'This code is not for this device'"
    }
    example "An unknown challenge id" @"Walking skeleton" +error {
      given "no challenge chl-nope"
      when "dev-anna-1 fetches it"
      then "the answer is 404 and the app shows 'Code invalid'"
    }
    example "An expired challenge" @MVP +error {
      given "chl-01J8 expired"
      when "dev-anna-1 fetches it"
      then "the answer is 410 and the app shows 'Code expired, request a new one on the Bank B page'"
    }
  }

  rule "The app shows the server's details and refuses a QR whose hash disagrees with the server" +"RTS art. 5" {
    example "The details shown come from the server" @"Walking skeleton" +nominal {
      given "the server's challenge says App A, Main Account, until 2026-12-05"
      when "the approval screen renders"
      then "it shows exactly those values"
    }
    example "A QR hash that differs from the server's hash is refused" @MVP +error {
      given "a QR with dl H9 while the server's challenge chl-01J8 has hash H1"
      when "the app compares them"
      then "it shows 'This code was tampered with' and offers no approve button"
      then "the mismatch is reported to the SCA engine"
    }
  }
}
