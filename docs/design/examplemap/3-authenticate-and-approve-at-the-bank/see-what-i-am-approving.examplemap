// Example map for the story "See what I am approving" (activity "Authenticate
// and approve at the Bank", step "Approve on my registered device").
// Fixtures: docs/design/examplemap/README.md.

examplemap "See what I am approving" {
  product "OBI"

  delivery "Walking skeleton" release
  delivery "MVP" release
  delivery "Hardening" release

  story "See what I am approving" ~analysing @"Walking skeleton" +bank-app +"RTS art. 5" {
    as "PSU"
    want "the TPP, the accounts and the validity shown on my phone before I approve"
    so "I cannot be tricked into approving something else"
    question "In which languages must the approval screen be available in the sandbox: German and English?" +"ask product"
  }

  rule "The approval screen shows the TPP, the access, every account, the validity, the frequency and the time left" +"RTS art. 5" {
    example "The screen for the TPP's consent on Main Account" @"Walking skeleton" +nominal {
      given "chl-01J8: TPP App (TPP Fintech GmbH), accounts and balances, Main Account DE23 …7 89 EUR, until 2026-12-05, 4 times a day, 2:40 left"
      when "the approval screen renders"
      then "it shows 'TPP App (TPP Fintech GmbH) wants to read', 'the list of your accounts and their balances', 'Main Account, DE23 1001 0010 0123 4567 89, EUR', 'until 5 Dec 2026', 'up to 4 times a day without you' and 'expires in 2:40'"
    }
    example "Six accounts are all listed, none hidden" @MVP +edge {
      given "a challenge for six accounts"
      when "the screen renders"
      then "six rows are listed in a scrollable area and the approve button sits below the last"
    }
    example "A one-off consent says once" @MVP +edge {
      given "a challenge for a one-off consent"
      when "the screen renders"
      then "it says 'one time only, today'"
    }
    example "A payment challenge shows the amount and the payee" @Hardening +edge {
      given "a challenge of kind PIS_PAYMENT: 12.50 EUR to Payee X from Main Account"
      when "the screen renders"
      then "it shows 'Pay 12.50 EUR to Payee X from Main Account'"
    }
  }

  rule "Approve is available only once the server details are loaded and consistent" +security {
    example "Approve is disabled while loading" @"Walking skeleton" +nominal {
      given "the fetch is in flight"
      when "the screen renders"
      then "the approve button is disabled and a spinner is shown"
    }
    example "A fetch error offers retry, never approve" @MVP +error {
      given "the fetch answered 503"
      when "the screen renders"
      then "it shows 'the Bank did not answer' and 'Retry', no approve button"
    }
    example "A tampered QR offers no approve" @MVP +error {
      given "the QR hash disagrees with the server"
      when "the screen renders"
      then "no approve button is shown"
    }
  }

  rule "What is displayed is exactly what the signature will cover" +"RTS art. 5" {
    example "The screen is rendered from the dynamic-link fields" @"Walking skeleton" +nominal {
      given "the challenge's dynamicLink {subjectId 123cons456, tppName 'TPP App (TPP Fintech GmbH)', summary, hash H1}"
      when "the screen renders"
      then "every value on screen is a field of the dynamic link or of the server's account list for it"
    }
    example "A value not covered by the hash is not shown as part of the approval" @MVP +edge {
      given "the server also returns the TPP's logo URL"
      when "the screen renders"
      then "the logo is shown as decoration and the text says 'Check the name, not the logo'"
    }
  }
}
