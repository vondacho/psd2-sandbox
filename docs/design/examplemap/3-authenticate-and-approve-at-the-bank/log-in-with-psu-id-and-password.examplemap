// Example map for the story "Log in with PSU-ID and password" (activity
// "Authenticate and approve at the Bank", step "Identify and enter my password").
// Fixtures: docs/design/examplemap/README.md.

examplemap "Log in with PSU-ID and password" {
  product "berlin-psd2-sandbox"

  delivery "Walking skeleton" release
  delivery "MVP" release
  delivery "Hardening" release

  story "Log in with PSU-ID and password" ~analysing @"Walking skeleton" +bank-ciam {
    as "PSU"
    want "to enter my bank customer id and password on the Bank's page"
    so "the Bank knows who is consenting"
    question "Is the PSU-ID case-insensitive at the Bank (anna.mueller vs Anna.Mueller)?" +"ask bank"
    question "Will the Bank offer passkeys as first factor, and does that change the amr values?" +"ask bank"
  }

  rule "A correct PSU-ID and password verify the first factor and record amr pwd" +"RTS art. 4" {
    example "Anna logs in" @"Walking skeleton" +nominal {
      given "an authentication session started by the OIDC-provider for consent 123cons456"
      given "identity anna.mueller is active with the password 'correct-horse-battery'"
      when "Anna submits PSU-ID anna.mueller and that password"
      then "the session step is firstFactorVerified, the session references anna.mueller and amr contains pwd"
      then "the page moves on to account selection"
    }
    example "Leading and trailing spaces in the PSU-ID are ignored" @MVP +edge {
      given "identity anna.mueller"
      when "Anna submits ' anna.mueller '"
      then "the first factor is verified"
    }
    example "Spaces inside the password are significant" @MVP +edge {
      given "the password 'correct-horse-battery'"
      when "Anna submits 'correct-horse-battery '"
      then "the login is refused"
    }
  }

  rule "A failed login says only that the credentials are invalid, counts the failure and locks after five" +security {
    example "A wrong password" @"Walking skeleton" +error {
      given "identity anna.mueller"
      when "Anna submits the password 'wrong'"
      then "the page shows 'Customer id or password is incorrect'"
      then "the session step stays identified"
      then "failedTries of the password credential is 1"
    }
    example "An unknown PSU-ID gives the same message" @"Walking skeleton" +error {
      given "no identity nobody.here"
      when "nobody.here and any password are submitted"
      then "the page shows 'Customer id or password is incorrect'"
      then "the response time is within 50 ms of the wrong-password case"
    }
    example "The fifth failure locks the credential" @MVP +error {
      given "four failed tries for anna.mueller"
      when "a fifth wrong password is submitted"
      then "the identity status is locked"
      then "the page shows 'Your access is locked. Contact the Bank.'"
    }
    example "A correct password after four failures resets the counter" @MVP +edge {
      given "four failed tries for anna.mueller"
      when "the correct password is submitted"
      then "the first factor is verified and failedTries is 0"
    }
    example "A locked identity cannot log in with the correct password" @MVP +error {
      given "anna.mueller is locked"
      when "the correct password is submitted"
      then "the page shows 'Your access is locked. Contact the Bank.' and the authorisation scaStatus becomes failed"
    }
    example "A closed identity cannot log in" @MVP +error {
      given "the identity of a former customer is closed"
      when "the correct former password is submitted"
      then "the page shows 'Customer id or password is incorrect'"
    }
  }

  rule "The login page belongs to a brokered session and shows who is asking" {
    example "The page names the TPP and the purpose" @"Walking skeleton" +nominal {
      given "the session for consent 123cons456 created by the TPP (brand 'TPP App')"
      when "the login page renders"
      then "it says 'TPP App asks to access your accounts. Log in to continue.'"
      then "the address bar shows ciam.bank.sandbox"
    }
    example "Opening the login URL without a brokered request is refused" @MVP +error {
      given "no session"
      when "the browser opens https://ciam.bank.sandbox/login directly"
      then "the page shows 'Start from your app' and no form"
    }
    example "The session times out after ten minutes of inactivity" @MVP +edge {
      given "the login page was opened at 09:00 and nothing happened"
      when "Anna submits the form at 09:11"
      then "the page shows 'Your session expired, start again from TPP App' with a link to the TPP's nok URI"
    }
    example "The password is posted over TLS and never appears in a URL or a log" @"Walking skeleton" +nominal {
      given "a login"
      when "the CIAM access log is inspected"
      then "the password is absent from URLs and log lines"
    }
  }

  rule "A successful first factor alone grants nothing" +"RTS art. 4" {
    example "No ID token exists after the first factor" @"Walking skeleton" +nominal {
      given "Anna verified her password"
      when "the session is inspected"
      then "no ID token was issued and the consent is still received"
    }
    example "A first factor for the wrong PSU cannot approve a consent pre-bound to another" @MVP +edge {
      given "consent 123cons456 was created with PSU-ID anna.mueller"
      when "Ben logs in with his own credentials in that session"
      then "the page shows 'This request is for another customer' and the authorisation is failed"
    }
  }
}
