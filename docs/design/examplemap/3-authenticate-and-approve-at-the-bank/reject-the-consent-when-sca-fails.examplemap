// Example map for the story "Reject the consent when SCA fails" (activity
// "Authenticate and approve at the Bank", step "Return to the TPP").
// Fixtures: docs/design/examplemap/README.md.

examplemap "Reject the consent when SCA fails" {
  product "berlin-psd2-sandbox"

  delivery "Walking skeleton" release
  delivery "MVP" release
  delivery "Hardening" release

  story "Reject the consent when SCA fails" ~analysing @MVP +bank-xs2a +oidc-provider +"spec 14.15" {
    as "Bank product owner"
    want "a denied, expired or failed challenge to set the consent to rejected and send the PSU to the nok redirect URI"
    so "the TPP learns the outcome without polling forever"
    question "Should a consent abandoned in status received be rejected after a fixed time, and is 30 minutes right?" +"ask bank" +"spec 14.15"
  }

  rule "Every failure of the authorisation rejects the consent and fails the authorisation, whatever the cause" +"spec 14.15" +"spec 14.16" {
    example "Denied on the device" @MVP +nominal {
      given "Anna rejected chl-01J8 in the app"
      when "the outcome is recorded"
      then "authorisation 123auth567 is failed and consent 123cons456 is rejected"
    }
    example "Third challenge expired" @MVP +nominal {
      given "chl-01, chl-02 and chl-03 expired"
      when "the third expiry is processed"
      then "the authorisation is failed and the consent rejected"
    }
    example "Too many bad signatures on the last challenge" @MVP +nominal {
      given "three invalid signatures on chl-03, the last allowed challenge"
      when "the third is refused"
      then "the authorisation is failed and the consent rejected"
    }
    example "Declined on the summary" @MVP +nominal {
      given "Anna clicked 'Decline'"
      when "the refusal is recorded"
      then "the authorisation is failed and the consent rejected"
    }
    example "Refused by the risk engine" @Hardening +nominal {
      given "the risk decision was refuse"
      when "the refusal is recorded"
      then "the authorisation is failed and the consent rejected"
    }
    example "Locked after the fifth password" @MVP +nominal {
      given "anna.mueller was locked in this session"
      when "the lock is recorded"
      then "the authorisation is failed and the consent rejected"
    }
    example "Abandoned for 30 minutes" @MVP +edge {
      given "the consent received at 09:00 and no activity since"
      when "the clock reaches 09:31"
      then "the authorisation is failed and the consent rejected"
    }
  }

  rule "rejected is terminal" +"spec 14.15" {
    example "A late approval outcome is ignored" @MVP +edge {
      given "consent 123cons456 rejected"
      when "an approved outcome for chl-01J8 arrives"
      then "consent management answers 409 and the consent stays rejected"
    }
    example "A new authorization request for a rejected consent is refused at the OIDC-provider" @MVP +error {
      given "consent 123cons456 rejected"
      when "the TPP requests AIS:123cons456 again"
      then "the OIDC-provider redirects with error=invalid_scope"
    }
    example "GET status answers rejected" @MVP +nominal {
      given "the rejected consent"
      when "the TPP calls GET /v1/consents/123cons456/status"
      then "the answer is rejected"
    }
    example "No token is ever issued for a rejected consent" @MVP +nominal {
      given "the rejected consent"
      when "the OIDC-provider is asked for the grant of 123cons456"
      then "there is none"
    }
  }

  rule "The PSU is sent to the TPP's nok redirect URI with error=access_denied and the TPP's state; without a nok URI, to the ok URI with the error" +"spec 7.6" {
    example "With a nok URI" @MVP +nominal {
      given "TPP-Nok-Redirect-URI https://tpp.sandbox/xs2a/callback/bank?outcome=nok and state S8NJ7…"
      when "the PSU returns after a denial"
      then "the browser ends at https://tpp.sandbox/xs2a/callback/bank?outcome=nok&error=access_denied&state=S8NJ7…"
    }
    example "Without a nok URI" @MVP +edge {
      given "no TPP-Nok-Redirect-URI"
      when "the PSU returns after a denial"
      then "the browser ends at https://tpp.sandbox/xs2a/callback/bank?error=access_denied&state=S8NJ7…"
    }
    example "The error carries a reason the TPP can show" @MVP +edge {
      given "a denial in the app"
      when "the redirect is built"
      then "it includes error_description 'denied by PSU'"
    }
    example "The PSU never returns with a code after a failure" @MVP +nominal {
      given "any failure"
      when "the redirect to the TPP is inspected"
      then "it has no code parameter"
    }
  }

  rule "The TPP treats access_denied with a valid state as a failed connection, without calling the token endpoint" {
    example "The TPP's callback handling" @MVP +nominal {
      given "the callback error=access_denied&state=S8NJ7… for a pending attempt"
      when "the TPP handles it"
      then "the attempt outcome is denied, the connection state is failed with 'access not granted'"
      then "no request goes to the OIDC-provider's token endpoint"
      then "the page shows 'the Bank did not grant access' and 'Try again'"
    }
    example "A retry creates a new consent" @MVP +nominal {
      given "the failed connection"
      when "Anna clicks 'Try again'"
      then "a new POST /v1/consents is sent and a new attempt starts"
    }
    example "An access_denied with an unknown state is ignored" @MVP +error {
      given "the callback error=access_denied&state=unknown"
      when "the TPP handles it"
      then "no connection changes and the page shows 'Unknown request'"
    }
  }
}
