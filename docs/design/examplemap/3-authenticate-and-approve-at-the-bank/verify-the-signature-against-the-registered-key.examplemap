// Example map for the story "Verify the signature against the registered key"
// (activity "Authenticate and approve at the Bank", step "Approve on my
// registered device"). Fixtures: docs/design/examplemap/README.md.

examplemap "Verify the signature against the registered key" {
  product "berlin-psd2-sandbox"

  delivery "Walking skeleton" release
  delivery "MVP" release
  delivery "Hardening" release

  story "Verify the signature against the registered key" ~ready @"Walking skeleton" +bank-ciam +sca +security {
    as "Bank security officer"
    want "the response accepted only from an active device of the identified PSU with a valid signature"
    so "a stolen challenge id is worthless"
  }

  rule "A response is accepted only if the challenge is pending and unexpired, the device is active and belongs to the challenge's PSU, and the signature verifies over the expected message with the stored key" +"RTS art. 5" {
    example "The nominal approval" @"Walking skeleton" +nominal {
      given "chl-01J8 pending for anna.mueller, dev-anna-1 active with key K1"
      when "a signature over 'chl-01J8|m3A9…|H1' made with K1 is posted with deviceId dev-anna-1"
      then "the answer is 200 {status: approved}"
      then "the challenge is approved with deviceId dev-anna-1, the signature stored and answeredAt set"
    }
    example "A signature from Ben's active device" @"Walking skeleton" +error {
      given "chl-01J8 for anna.mueller and dev-ben-1 active with key K2"
      when "a valid K2 signature is posted with deviceId dev-ben-1"
      then "the answer is 403 'challenge not for this device'"
      then "chl-01J8 stays pending"
    }
    example "A signature from Anna's blocked device" @"Walking skeleton" +error {
      given "dev-anna-0 blocked with key K0"
      when "a valid K0 signature is posted"
      then "the answer is 403 'device blocked' and chl-01J8 stays pending"
    }
    example "A signature from Anna's pending device" @MVP +error {
      given "dev-anna-3 pending"
      when "a valid signature is posted"
      then "the answer is 403 'device not active'"
    }
    example "A valid signature over another challenge's message" @"Walking skeleton" +error {
      given "a K1 signature over 'chl-99|nonce99|H1'"
      when "it is posted for chl-01J8"
      then "the answer is 400 'signature invalid' and the attempt counter is 1"
    }
    example "A valid signature over another consent's hash" @"Walking skeleton" +error {
      given "a K1 signature over 'chl-01J8|m3A9…|H2'"
      when "it is posted"
      then "the answer is 400 'signature invalid'"
    }
    example "Random bytes as signature" @"Walking skeleton" +error {
      given "64 random bytes"
      when "they are posted as the signature"
      then "the answer is 400 'signature invalid' and the attempt counter is 1"
    }
    example "A correct signature for an expired challenge" @MVP +error {
      given "chl-01J8 expired"
      when "a valid signature is posted"
      then "the answer is 410 and the status stays expired"
    }
    example "A second correct signature" @MVP +edge {
      given "chl-01J8 approved"
      when "the same signature is posted again"
      then "the answer is 409 'already answered' and nothing changes"
    }
    example "An unknown device id" @"Walking skeleton" +error {
      given "deviceId dev-nope"
      when "a signature is posted"
      then "the answer is 403"
    }
    example "A device id of Anna's with a signature from another of Anna's keys" @MVP +error {
      given "dev-anna-1 (K1) and dev-anna-2 (K3) both active"
      when "a K3 signature is posted with deviceId dev-anna-1"
      then "the answer is 400 'signature invalid'"
    }
  }

  rule "Verification uses the key stored at enrolment; nothing in the response can supply a key" +security {
    example "A public key sent in the response is ignored" @"Walking skeleton" +error {
      given "a response body with an extra field publicKey holding an attacker's key, and a signature made with that key"
      when "it is posted for dev-anna-1"
      then "the answer is 400 'signature invalid'"
    }
    example "A rotated key is a new device, not a new key for the old device" @MVP +nominal {
      given "dev-anna-1 stored with K1"
      when "the registry is asked to replace K1 by K5"
      then "it refuses; only a new device record can carry K5"
    }
  }

  rule "A successful verification updates the challenge, the device and the session" {
    example "The side effects" @"Walking skeleton" +nominal {
      given "the nominal approval at 2026-09-06T09:13:20Z"
      when "it is processed"
      then "dev-anna-1.lastUsedAt is 09:13:20Z"
      then "the session step is approved and its methods are [pwd, hwk, face]"
      then "the outcome is sent to consent management"
    }
    example "The stored evidence allows a later audit" @MVP +nominal {
      given "the approved challenge"
      when "an auditor reads it"
      then "they find the hash, the nonce, the device id, the signature and the timestamps, enough to re-verify"
    }
  }
}
