// Example map for the story "Show the TPP brand name" (activity "Authenticate
// and approve at the Bank", step "Select accounts and review the consent").
// Fixtures: docs/design/examplemap/README.md.

examplemap "Show the TPP brand name" {
  product "OBI"

  delivery "Walking skeleton" release
  delivery "MVP" release
  delivery "Hardening" release

  story "Show the TPP brand name" ~analysing @MVP +bank-ciam +"spec 4.9" {
    as "PSU"
    want "the name I know the app by, not only its legal name"
    so "I recognise who is asking"
    question "May a TPP send a brand name that equals another company's name, and does the Bank check it against the client registration at the OIDC-provider?" +"ask bank" +security
    question "What is the maximum length of TPP-Brand-Logging-Information; 140 characters is assumed here." +"ask bank" +"spec 4.9"
  }

  rule "When the consent request carried TPP-Brand-Logging-Information, the brand is shown with the legal name; otherwise the legal name alone" +"spec 4.9" {
    example "Brand and legal name" @MVP +nominal {
      given "consent 123cons456 created with TPP-Brand-Logging-Information 'TPP App' by TPP Fintech GmbH"
      when "the login page, the summary and the app's approval screen render"
      then "each shows 'TPP App (TPP Fintech GmbH)'"
    }
    example "No brand header" @MVP +edge {
      given "a consent created without TPP-Brand-Logging-Information"
      when "the pages render"
      then "each shows 'TPP Fintech GmbH'"
    }
    example "A brand equal to the legal name is shown once" @MVP +edge {
      given "TPP-Brand-Logging-Information 'TPP Fintech GmbH'"
      when "the pages render"
      then "each shows 'TPP Fintech GmbH'"
    }
    example "The brand is stored on the consent so every screen agrees" @MVP +nominal {
      given "the consent with brand 'TPP App'"
      when "the consent dashboard lists it a month later"
      then "it shows 'TPP App (TPP Fintech GmbH)'"
    }
  }

  rule "The brand text is untrusted input" +security {
    example "Markup is shown literally" @MVP +error {
      given "TPP-Brand-Logging-Information '<script>alert(1)</script>'"
      when "the summary renders"
      then "the text '<script>alert(1)</script>' is visible as text and no script runs"
    }
    example "An over-long brand is refused at consent creation" @MVP +error {
      given "TPP-Brand-Logging-Information of 141 characters"
      when "POST /v1/consents is called"
      then "the answer is 400 FORMAT_ERROR with path TPP-Brand-Logging-Information"
    }
    example "Control characters are stripped" @MVP +edge {
      given "TPP-Brand-Logging-Information 'App\tA'"
      when "the summary renders"
      then "it shows 'TPP App'"
    }
    example "A brand cannot hide the legal name" @MVP +nominal {
      given "TPP-Brand-Logging-Information 'the Bank'"
      when "the summary renders"
      then "it shows 'the Bank (TPP Fintech GmbH)' and a note 'a third-party app, not the Bank'"
    }
  }

  rule "The legal name comes from the certificate, never from the request" {
    example "The legal name is the O of the QWAC" @MVP +nominal {
      given "the TPP's QWAC with O 'TPP Fintech GmbH'"
      when "the consent is created"
      then "the stored legal name is 'TPP Fintech GmbH'"
    }
    example "A request cannot override the legal name" @MVP +error {
      given "a request with a body field tppName 'the Bank Official'"
      when "the consent is created"
      then "the field is ignored and the legal name is still 'TPP Fintech GmbH'"
    }
  }
}
