@startuml 06-seq-token-and-account-read
title Token exchange, confirmation, account list and account details (steps 12-16)
autonumber
actor PSU
participant "PSU browser" as Br
participant "TPP back end" as TPP
participant "OIDC provider" as OIDC
participant "Bank XS2A API" as XS2A
participant "Bank consent mgmt" as CM
participant "Core banking" as Core

Br -> TPP : GET /callback?code&state
TPP -> TPP : state matches session? (else abort)
TPP -> OIDC : POST /token (mTLS QWAC)\ngrant_type=authorization_code, code, redirect_uri,\ncode_verifier, client_id
OIDC -> OIDC : cert matches client, PKCE ok
OIDC --> TPP : access_token (JWT, scope AIS:{consentId}, cnf.x5t#S256),\nrefresh_token, expires_in
TPP -> XS2A : PUT /v1/consents/{id}/authorisations/{authId}\nAuthorization: Bearer
XS2A -> CM : token.consent_id == id, client == owner\n-> authorisation finalised, consent valid
XS2A --> TPP : 200 {scaStatus: finalised}
TPP -> XS2A : GET /v1/consents/{id}/status
XS2A --> TPP : 200 {consentStatus: valid}
TPP --> Br : "Bank connected"

== Account list ==
PSU -> Br : open accounts at the Bank
Br -> TPP : GET /banks/bank/accounts
TPP -> XS2A : GET /v1/accounts?withBalance=true\nConsent-ID, Authorization: Bearer, X-Request-ID, PSU-IP-Address
XS2A -> XS2A : QWAC (AISP), JWT sig/exp/aud, cnf == client cert,\nscope consentId == Consent-ID
XS2A -> CM : consent valid? access rights?\nfrequency (PSU present: not counted)
XS2A -> Core : accounts of psuId within accessible accounts
XS2A --> TPP : 200 {accounts: [{resourceId, iban, currency, name, balances, _links}]}
TPP --> Br : account list

== Account details ==
PSU -> Br : click an account
Br -> TPP : GET /banks/bank/accounts/{resourceId}
TPP -> XS2A : GET /v1/accounts/{resourceId}?withBalance=true
XS2A -> CM : resourceId in accessible accounts of this consent?
XS2A -> Core : account details + balances
XS2A --> TPP : 200 {account: {...}}
TPP --> Br : account details
@enduml
