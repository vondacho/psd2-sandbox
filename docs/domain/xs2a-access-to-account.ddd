// Context map — PSD2 XS2A access to account
// PROPOSAL generated by AI on 2026-09-19 from SRC-IG v1.3.16 and SRC-ADR. Domain experts
// review language, boundaries and power (gate G2). Context ids used across artefacts:
//   CTX-TPP-ACCESS, CTX-CONSENT, CTX-TXN-AUTHORISATION, CTX-PAYMENT-INITIATION,
//   CTX-ACCOUNT-INFORMATION, CTX-CUSTOMER-IDENTITY, CTX-MOBILE-BANKING, CTX-CORE-BANKING,
//   CTX-TPP (external).
// No subdomain is classified core. For the bank, XS2A is a regulatory obligation built around
// bought products; calling any of it core would be a budget claim nobody has made (see
// validation report W-DDD-01). Owners are "unassigned" where no source names one: an unowned
// boundary is a suggestion, and the map says so rather than hiding it.
// Iteration 3 (SRC-ADR 87c72b8): the mobile app carries only the last SCA factor; the consent screen
// (grant/revoke) is a UI of the Consent and Transaction Authorisation contexts, provided by the ASPSP
// gateway or by Finologee (D-01). The former "Consent -> Mobile Banking" relationship is removed:
// the app no longer reads or revokes consents.
map "PSD2 XS2A access to account" {

  domain "Third-party access to accounts" {
    intent "Let licensed TPPs reach PSU accounts and initiate payments under PSD2, through the
            Berlin Group NextGenPSD2 XS2A interface, with the PSU's consent and SCA."
    owner  "Unassigned — no source names the accountable business owner (Q-20)"

    subdomain supporting "XS2A resources" {
      intent "The resource model the bank owes TPPs: consents, payment initiations and their
              authorisation sub-resources, and consented account data. Built in house (SRC-ADR)."
      owner  "Bank ASPSP gateway team (SRC-ADR 'We develop our own ASPSP gateway')"

      context "Consent" {
        intent   "Hold each AIS consent resource and decide, at any moment, what a TPP may read for a PSU."
        language "AIS consent" "access" "dedicated accounts" "recurringIndicator" "validUntil"
                 "frequencyPerDay" "consentStatus" "revokedByPsu" "terminatedByTpp" "Consent-ID"
                 "consent screen"
        aggregate "Consent"
        owner    "Unassigned — D-01 decides whether the ASPSP gateway (with IDP/CIAM) or Finologee implements it and its consent screen"
        status   drafted
      }

      context "Transaction Authorisation" {
        intent   "Run the authorisation sub-resources of consents and payments: which SCA approach,
                  which scaStatus, which redirect, and whether the PSU's approval is final."
        language "authorisation sub-resource" "scaStatus" "SCA approach" "scaRedirect"
                 "confirmationCode" "implicit start" "explicit start" "finalised" "exempted"
        aggregate "Authorisation"
        owner    "Bank ASPSP gateway team (proposed)"
        status   drafted
      }

      context "Payment Initiation" {
        intent   "Hold each payment initiation resource and its transactionStatus from RCVD to its
                  last status in the XS2A interface."
        language "payment initiation" "payment-service" "payment-product" "transactionStatus"
                 "instructedAmount" "debtorAccount" "creditorAccount" "RCVD" "ACTC" "RJCT" "CANC"
        aggregate "Payment Initiation"
        owner    "Bank ASPSP gateway team (proposed)"
        status   drafted
      }

      context "Account Information" {
        intent   "Serve consented account data — account list, details, balances, transactions — and
                  count unattended reads against the consent's frequency."
        language "accessible accounts" "available accounts" "resourceId" "balanceType"
                 "bookingStatus" "withBalance" "ACCESS_EXCEEDED"
        aggregate "Account Resource Map" "Daily Access Allowance"
        owner    "Bank ASPSP gateway team (proposed)"
        status   drafted
      }
    }

    subdomain generic "TPP access mediation" {
      intent "Terminate TPP connections, identify TPPs from eIDAS certificates and mediate their
              requests to the bank. Bought: Finologee (SRC-ADR)."
      owner  "Finologee (vendor); bank integration owner unassigned"

      context "TPP Access" {
        intent   "Identify the TPP and its roles and hand an authenticated request to the bank."
        language "QWAC" "QSealC" "TPP role" "organizationIdentifier" "NCA" "client_id"
                 "TPP access token" "X-Request-ID"
        owner    "Finologee (vendor)"
        status   unmodelled
      }
    }

    subdomain generic "Customer identity and authentication" {
      intent "Identify and strongly authenticate PSUs on their devices. Bought: Ping Federate (IDP)
              and Transmit (CIAM) (SRC-ADR)."
      owner  "Bank IAM team (assumed, A-12)"

      context "Customer Identity and SCA" {
        intent   "Authenticate the PSU with two factors, on a registered device, bound to what is approved."
        language "PSU identity" "authentication journey" "registered device" "SCA method"
                 "bank access token" "dynamic linking"
        owner    "Bank IAM team (assumed, A-12)"
        status   unmodelled
      }
    }
  }

  domain "Retail banking" {
    intent "The bank's own customer channels and account servicing, which XS2A depends on but does
            not own."
    owner  "Unassigned in supplied sources"

    context "Mobile Banking" {
      intent   "The PSU's own banking app. In the PSD2 journey it only carries the last SCA authentication factor (SRC-ADR 87c72b8)."
      language "last factor" "confirm it's you" "registered device"
      owner    "Bank mobile app team (SRC-ADR 'We develop our own mobile banking application')"
      status   unmodelled
    }

    context "Core Banking" {
      intent   "Accounts, balances, bookings and payment execution."
      language "booking" "account number" "posting" "cut-off"
      owner    "Unassigned in supplied sources (Q-06)"
      status   unmodelled
    }
  }

  domain "PSD2 ecosystem" {
    intent "Parties outside the bank that use the XS2A interface."
    owner  "Each TPP; the Berlin Group owns the standard"

    context "Third-Party Provider" {
      intent   "An AISP, PISP or PIISP acting for a PSU."
      language "PSU" "AISP" "PISP" "PIISP" "redirect URI"
      owner    "Each TPP"
      status   unmodelled
    }
  }

  // ---- Relationships. Left = upstream on a directed edge.

  "TPP Access" -> "Third-Party Provider" : published-language / conformist {
    exchange "Berlin Group NextGenPSD2 XS2A requests and responses (SRC-IG v1.3.16)."
    because  "The standard is the published language; a TPP integrates with hundreds of ASPSPs and
              will not negotiate a bank-specific dialect. The bank may only choose options the
              standard leaves open."
  }

  "TPP Access" -> "Consent" : open-host-service / anticorruption-layer {
    exchange "Identified TPP (organizationIdentifier, roles) with each consent request; access token if OAuth is used."
    because  "Finologee is a bought product: the bank adapts to its integration contract, not the
              other way round. Its contract was not supplied (Q-04), so the ASPSP gateway keeps an
              anticorruption layer to protect the XS2A resource model from it. Unverified assumption A-02."
  }

  "TPP Access" -> "Payment Initiation" : open-host-service / anticorruption-layer {
    exchange "Identified TPP and payment initiation requests."
    because  "Same vendor contract as for consents; same protection."
  }

  "TPP Access" -> "Account Information" : open-host-service / anticorruption-layer {
    exchange "Identified TPP, Consent-ID or access token, read requests."
    because  "Same vendor contract as for consents; same protection."
  }

  "Customer Identity and SCA" -> "Transaction Authorisation" : customer-supplier {
    exchange "PSU authenticated, SCA result bound to the approved consent or payment."
    because  "Journeys are configured in house on Ping and Transmit (SRC-ADR 'In house solution'),
              so the IAM team can build what XS2A asks for — within what the two products can do,
              which nobody has checked yet (Q-07)."
  }

  "Transaction Authorisation" -> "Consent" : customer-supplier {
    exchange "Authorisation finalised / failed for a consent."
    because  "The consent's status follows its authorisation, never the other way round."
  }

  "Transaction Authorisation" -> "Payment Initiation" : customer-supplier {
    exchange "Authorisation finalised / failed for a payment."
    because  "The payment's status follows its authorisation(s); multilevel SCA would add several."
  }

  "Consent" -> "Account Information" : customer-supplier {
    exchange "Consent validity, access per account, frequencyPerDay."
    because  "Every read is decided against the consent; the consent does not care how data is read."
  }

  "Core Banking" -> "Account Information" : anticorruption-layer {
    exchange "Accounts, balances, bookings."
    because  "Core banking's booking model is not the Berlin Group account model, and its interface
              is unknown (Q-06); XS2A must not leak core identifiers such as account numbers into paths."
  }

  "Core Banking" -> "Payment Initiation" : anticorruption-layer {
    exchange "Payment submission and execution outcome."
    because  "Same reason; and the status the bank can report (ACTC vs ACSC) is decided by core
              booking behaviour (Q-28)."
  }

  "Mobile Banking" <-> "Customer Identity and SCA" : partnership {
    exchange "Device registration and the last SCA factor in the app."
    because  "SRC-ADR: the app 'integrates with our ASPSP gateway and CIAM' and Transmit adds device
              management — the two succeed or fail together."
  }
}
