// CTX-CONSENT — domain model. PROPOSAL generated by AI on 2026-09-19.
// Sources: SRC-IG §4.9, §4.11, §4.14.2, §6.3.1, §6.4, §14.15, §14.17, §14.19.
// Invariant ids [INV-...] are referenced by docs/traceability/manifest.yaml.
// Domain events and policies have no syntax in .ddm; they live in
// docs/journeys/ais-consent-lifecycle.eventstorm.
context "Consent" {

  value "AccountReference" {
    attribute "iban"      : "IBAN"
    attribute "bban"      : "BBAN"
    attribute "pan"       : "Max35Text"
    attribute "maskedPan" : "Max35Text"
    attribute "msisdn"    : "Max35Text"
    attribute "currency"  : "CurrencyCode"
  }

  aggregate "Consent" {
    intent    "Decide, for one TPP and one PSU, which account data may be read, until when and how often."
    invariant "[INV-CNS-01] consentStatus moves only received -> valid | rejected | partiallyAuthorised, partiallyAuthorised -> valid | rejected, valid -> expired | revokedByPsu | terminatedByTpp; rejected, expired, revokedByPsu and terminatedByTpp are final (SRC-IG §4.14.2, §14.15)."
    invariant "[INV-CNS-02] In a dedicated-account consent every used access list names at least one account; if any list is empty all used lists are empty (SRC-IG §6.3.1.1, §14.17)."
    invariant "[INV-CNS-03] 1 <= frequencyPerDay, and frequencyPerDay <= 4 unless a bilateral agreement with the TPP exists; a one-off consent has frequencyPerDay = 1 (SRC-IG §6.3.1.1)."
    invariant "[INV-CNS-04] The consent belongs to exactly one TPP — the legal owner of the certificate, not the OU brand — and only that TPP may address it (SRC-IG §4.9, §4.11)."
    invariant "[INV-CNS-05] validUntil is the date the bank granted, which may be earlier than requested; it never moves later (SRC-IG §6.3.1.1)."
    invariant "[INV-CNS-06] Only a valid consent authorises a read."

    root entity "Consent" {
      id         "ConsentId"
      attribute  "tppId"                    : "OrganizationIdentifier"
      attribute  "psuId"                    : "PsuId"
      attribute  "recurringIndicator"       : "Boolean"
      attribute  "requestedValidUntil"      : "ISODate"
      attribute  "validUntil"               : "ISODate"
      attribute  "frequencyPerDay"          : "Integer"
      attribute  "combinedServiceIndicator" : "Boolean"
      attribute  "lastActionDate"           : "ISODate"
      embeds     "AccountAccess" one
      embeds     "ConsentStatus" one
    }

    value "AccountAccess" {
      embeds "AccountReference" many
      attribute "scope" : "accounts | balances | transactions per reference"
    }

    enum "ConsentStatus" {
      "received" "rejected" "partiallyAuthorised" "valid" "revokedByPsu" "expired" "terminatedByTpp"
    }
  }

  // Cross-consent rule, deliberately NOT an aggregate invariant: "authorising a new recurring
  // consent ends the former recurring consent of the same TPP and PSU" (SRC-IG §6.3.1.1) spans two
  // Consent aggregates. It is a policy with eventual consistency in the event storm, and the
  // resulting status of the former consent is open (Q-08). Making it transactional would need a
  // "PSU-TPP relationship" aggregate — a boundary nobody has asked for; raised as W-DDM-01.
}
