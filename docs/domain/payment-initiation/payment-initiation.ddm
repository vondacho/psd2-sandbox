// CTX-PAYMENT-INITIATION — domain model. PROPOSAL generated by AI on 2026-09-19.
// Sources: SRC-IG §4.14.1, §5.3.1, §5.4, §5.7, §7.1, §11.1, §14.3, §14.13.
// Scope: single payments (payment-service "payments"). Bulk and periodic payments are
// unscheduled on the story map and are not modelled.
context "Payment Initiation" {

  value "Amount" {
    attribute "currency" : "CurrencyCode"
    attribute "amount"   : "DecimalString"
  }

  value "AccountReference" {
    attribute "iban"     : "IBAN"
    attribute "bban"     : "BBAN"
    attribute "currency" : "CurrencyCode"
  }

  aggregate "Payment Initiation" {
    intent    "Hold what the PSU is asked to pay, and report its transactionStatus to the TPP that initiated it."
    invariant "[INV-PAY-01] The payment data (amount, debtor, creditor, remittance) cannot change after creation; the PSU authorises exactly what was submitted."
    invariant "[INV-PAY-02] transactionStatus never leaves a final status — RJCT, CANC, ACSC, ACCC — and a payment in a final status accepts no new authorisation (STATUS_INVALID 409, SRC-IG §14.11.1)."
    invariant "[INV-PAY-03] If the required authorisation(s) are not finalised within the SCA window the payment becomes RJCT (SRC-IG §5.4); the window is open (Q-29)."
    invariant "[INV-PAY-04] Calls on the payment must name the payment-service and payment-product it was created under (SRC-IG §7.1)."
    invariant "[INV-PAY-05] Only the TPP that created the payment may address it (SRC-IG §4.11)."

    root entity "Payment Initiation" {
      id         "PaymentId"
      attribute  "tppId"                             : "OrganizationIdentifier"
      attribute  "psuId"                             : "PsuId"
      attribute  "paymentService"                    : "payments"
      attribute  "paymentProduct"                    : "sepa-credit-transfers"
      attribute  "creditorName"                      : "Max70Text"
      attribute  "remittanceInformationUnstructured" : "Max140Text"
      attribute  "endToEndIdentification"            : "Max35Text"
      attribute  "requestedExecutionDate"            : "ISODate"
      attribute  "fundsAvailable"                    : "Boolean"
      attribute  "createdAt"                         : "ISODateTime"
      embeds     "Amount" one
      embeds     "AccountReference" many
      embeds     "TransactionStatus" one
    }

    enum "TransactionStatus" {
      "RCVD" "PDNG" "PATC" "ACTC" "ACWC" "ACCP" "ACFC" "ACSP" "ACSC" "ACCC" "ACWP" "RJCT" "CANC" "PART"
      "RVCM" "RVNC" "RCVC"
    }
  }
}
