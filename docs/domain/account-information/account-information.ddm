// CTX-ACCOUNT-INFORMATION — domain model. PROPOSAL generated by AI on 2026-09-19.
// Sources: SRC-IG §4.11.2 remark, §6 (frequency per account and per PSU), §6.5, §14.11.3, §14.20.
// Account data itself (balances, transactions) is read through from core banking and not owned
// here; only the two things this context must keep true are modelled.
context "Account Information" {

  aggregate "Account Resource Map" {
    intent    "Give each consented account a resourceId that hides the account number and stays stable."
    invariant "[INV-ACC-01] Within one consent, one account (IBAN plus currency for a sub-account) has exactly one resourceId, and that resourceId never changes while the consent lives (SRC-IG §6.5.2)."
    invariant "[INV-ACC-02] A resourceId resolves only for the TPP and consent it was issued under (SRC-IG §4.11)."

    root entity "Account Resource Map" {
      id         "ConsentId"
      contains   "Account Resource" many
    }

    entity "Account Resource" {
      id         "ResourceId"
      attribute  "iban"     : "IBAN"
      attribute  "currency" : "CurrencyCode"
    }
  }

  aggregate "Daily Access Allowance" {
    intent    "Count unattended reads so a TPP never exceeds what the PSU consented to."
    invariant "[INV-ACC-03] For one consent, one account and one day, unattended reads never exceed the consent's frequencyPerDay; the next is refused with 429 ACCESS_EXCEEDED (SRC-IG §6, §14.11.3)."
    invariant "[INV-ACC-04] A read carrying PSU-IP-Address (PSU actively initiated) is not counted — inferred, pending confirmation (EXMAP-ENFORCE-FREQUENCY R-FRQ-02)."

    root entity "Daily Access Allowance" {
      id         "ConsentAccountDay"
      attribute  "consentId"        : "ConsentId"
      attribute  "resourceId"       : "ResourceId"
      attribute  "day"              : "ISODate"
      attribute  "frequencyPerDay"  : "Integer"
      attribute  "unattendedReads"  : "Integer"
    }
  }
}
