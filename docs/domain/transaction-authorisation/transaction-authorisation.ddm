// CTX-TXN-AUTHORISATION — domain model. PROPOSAL generated by AI on 2026-09-19.
// Sources: SRC-IG §4.6, §4.7, §4.10, §5.1, §7.1, §7.6, §14.11.1, §14.16.
// An authorisation is its own aggregate, not part of the consent or payment: multilevel SCA
// creates n authorisations for one parent, each updated independently and possibly at the same
// time (§5.1.12 remark), so one transaction per authorisation is the natural boundary.
context "Transaction Authorisation" {

  aggregate "Authorisation" {
    intent    "Carry one SCA attempt for one consent, payment or payment cancellation to a final outcome."
    invariant "[INV-AUT-01] scaStatus moves only forward through received, psuIdentified, psuAuthenticated, scaMethodSelected, started, unconfirmed to finalised | failed | exempted; finalised, failed and exempted are final and accept no update (SRC-IG §14.16; SCA_INVALID, STATUS_INVALID §14.11.1)."
    invariant "[INV-AUT-02] An authorisation belongs to the TPP that created its parent resource (SRC-IG §4.11)."
    invariant "[INV-AUT-03] Every authorisation of one parent uses the TPP-Redirect-URI (and TPP-Nok-Redirect-URI) given when the parent was created (SRC-IG §4.10, §7.1)."
    invariant "[INV-AUT-04] A confirmation code is accepted once, only while scaStatus is unconfirmed (SRC-IG §7.6) — applies only if D-03/Q-34 adopt the confirmation step."
    invariant "[INV-AUT-05] The SCA result is bound to the exact subject the PSU approved (amount and payee for a payment; access, accounts and validity for a consent)."

    root entity "Authorisation" {
      id         "AuthorisationId"
      attribute  "subjectId"          : "ConsentId | PaymentId"
      attribute  "tppId"              : "OrganizationIdentifier"
      attribute  "psuId"              : "PsuId"
      attribute  "tppRedirectUri"     : "URI"
      attribute  "tppNokRedirectUri"  : "URI"
      attribute  "approvedSubjectHash" : "Digest"
      attribute  "confirmationCodeHash" : "Digest"
      attribute  "createdAt"          : "ISODateTime"
      embeds     "AuthorisationPurpose" one
      embeds     "ScaApproach" one
      embeds     "ScaStatus" one
      embeds     "ScaMethod" optional
    }

    enum "AuthorisationPurpose" { "consent" "payment" "paymentCancellation" }
    enum "ScaApproach" { "REDIRECT" "DECOUPLED" "EMBEDDED" }
    enum "ScaStatus" {
      "received" "psuIdentified" "psuAuthenticated" "scaMethodSelected" "started"
      "unconfirmed" "finalised" "failed" "exempted"
    }

    value "ScaMethod" {
      attribute "authenticationType"      : "AuthenticationType"
      attribute "authenticationMethodId"  : "Max35Text"
      attribute "name"                    : "Max70Text"
    }
  }
}
