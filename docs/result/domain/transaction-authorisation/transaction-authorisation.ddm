// CTX-TXN-AUTHORISATION — domain model. PROPOSAL generated by AI.
// Sources: SRC-IG §4.6, §4.15, §7.1-§7.6, §14.6, §14.16; SRC-ADR SCA journey (CIAM login in the
// browser, then OTP / QR code / biometrics, then the consent confirmation panel on the enrolled
// device).
// The aggregate exists to keep one thing true: what the PSU saw and confirmed is what the SCA was
// bound to, across two surfaces and often two devices. That is INV-AUT-05, and it is the reason
// the boundary is here rather than inside Consent or Payment Initiation.
context "Transaction Authorisation" {

  enum "ScaStatus" {
    "received" "psuIdentified" "psuAuthenticated" "scaMethodSelected" "started"
    "unconfirmed" "finalised" "failed" "exempted"
  }

  enum "AuthorisationPurpose" {
    "consent" "payment" "paymentCancellation"
  }

  aggregate "Authorisation" {
    intent    "Carry one PSU authorisation of one consent or one payment, from the redirect to a final scaStatus, and bind the SCA result to what the PSU actually confirmed."
    invariant "[INV-AUT-01] scaStatus only moves forward through received -> psuIdentified -> psuAuthenticated -> scaMethodSelected -> started -> unconfirmed -> finalised; failed and exempted are reachable from any non-final state; finalised, failed and exempted are final (SRC-IG §14.16)."
    invariant "[INV-AUT-02] An authorisation belongs to exactly one subject — one consent or one payment — and to the TPP that created that subject (SRC-IG §4.6, §4.11)."
    invariant "[INV-AUT-03] The redirect session is single use and time-boxed: it resolves at most once, only before its deadline, and only to the return URIs the TPP supplied (SRC-IG §4.10, §7.6.2)."
    invariant "[INV-AUT-04] No credential, one-time password or confirmation code is stored in readable form; a confirmation code is held only as a hash (SRC-IG §7.6)."
    invariant "[INV-AUT-05] An SCA result is accepted only when it carries the digest of the subject the PSU was shown and confirmed. If the subject changed after the digest was taken, the result is refused and the authorisation fails. For a consent the subject is the items on the consent confirmation panel; for a payment SRC-ADR names no surface, so no digest can be taken today (Q-17, C-09)."

    root entity "Authorisation" {
      id         "AuthorisationId"
      attribute  "subjectId"           : "Max35Text"
      attribute  "tppId"               : "OrganizationIdentifier"
      attribute  "psuId"               : "PsuId"
      attribute  "approvedSubjectDigest" : "Sha256"
      attribute  "startedAt"           : "Instant"
      attribute  "deadline"            : "Instant"
      embeds     "AuthorisationPurpose" one
      embeds     "ScaStatus" one
      contains   "RedirectSession" one
      contains   "ScaAttempt" many
    }

    // subjectId holds the ConsentId or the PaymentId. It is a plain identifier and not a
    // `references` link because the subject lives in another bounded context: a .ddm models the
    // inside of one context, and a link across a context boundary is a relationship on the
    // context map, not an association here.

    entity "RedirectSession" {
      id        "RedirectToken"
      attribute "returnUri"    : "Max140Text"
      attribute "nokReturnUri" : "Max140Text"
      attribute "resolvedAt"   : "Instant"
      attribute "used"         : "Boolean"
    }

    entity "ScaAttempt" {
      id        "ScaAttemptId"
      attribute "method"       : "otp | qrCode | biometric"
      attribute "deviceId"     : "Max35Text"
      attribute "requestedAt"  : "Instant"
      attribute "outcome"      : "confirmed | rejected | expired"
      attribute "resultDigest" : "Sha256"
    }
  }
}
