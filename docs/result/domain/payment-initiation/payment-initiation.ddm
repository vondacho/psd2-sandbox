// CTX-PAYMENT-INITIATION — domain model. PROPOSAL generated by AI.
// Sources: SRC-IG §5.1, §5.3.1, §5.4, §5.6, §4.14.1, §11.1, §14.13.
// Scope is a single SEPA credit transfer in JSON (A-06, A-13). Bulk, periodic and pain.001
// payments are unscheduled stories and are not modelled.
context "Payment Initiation" {

  value "Amount" {
    attribute "amount"   : "Decimal"
    attribute "currency" : "CurrencyCode"
  }

  value "PaymentAccountReference" {
    attribute "iban"     : "IBAN"
    attribute "currency" : "CurrencyCode"
  }

  enum "TransactionStatus" {
    "RCVD" "ACTC" "ACCP" "ACFC" "ACSP" "ACSC" "ACWC" "ACWP" "PDNG" "PATC" "PART" "RJCT" "CANC"
  }

  aggregate "Payment Initiation" {
    intent    "Hold one payment instruction exactly as the TPP submitted it, and report its status truthfully to the TPP until it is final."
    invariant "[INV-PAY-01] The payment instruction is immutable once created. Nothing about the amount, the accounts or the remittance changes after the resource exists (SRC-IG §5.6) — which is what makes an SCA binding to it meaningful (INV-AUT-05)."
    invariant "[INV-PAY-02] transactionStatus only takes a value from the ISO 20022 list of SRC-IG §14.13, and RJCT, CANC and ACSC are final. The codes ACCT and REJT used in the flow diagrams of §5.1.8-§5.1.10 are not valid values (C-03)."
    invariant "[INV-PAY-03] A payment whose authorisation is not finalised before its SCA window closes becomes RJCT and is never submitted to core banking (SRC-IG §5.4)."
    invariant "[INV-PAY-04] A payment is submitted to core banking at most once, and only after an authorisation for it reached finalised or exempted."
    invariant "[INV-PAY-05] The payment belongs to the TPP that created it, and only that TPP may read it or its status (SRC-IG §4.11)."

    root entity "Payment Initiation" {
      id         "PaymentId"
      attribute  "paymentProduct"  : "sepa-credit-transfers"
      attribute  "tppId"           : "OrganizationIdentifier"
      attribute  "creditorName"    : "Max70Text"
      attribute  "remittanceInformationUnstructured" : "Max140Text"
      attribute  "requestedExecutionDate" : "ISODate"
      attribute  "submittedToCoreAt" : "Instant"
      embeds     "Amount" one
      embeds     "TransactionStatus" one
      embeds     "PaymentAccountReference" at-least-one
    }

    // The authorisations of this payment live in CTX-TXN-AUTHORISATION and are reached from
    // there by subjectId, not from here: the boundary between the two is a context-map
    // relationship (Transaction Authorisation -> Payment Initiation, customer-supplier).
  }
}
