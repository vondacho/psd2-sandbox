// CTX-CONSENT — domain model. PROPOSAL generated by AI.
// Sources: SRC-IG §4.9, §4.11, §4.14.2, §6.3.1, §6.4, §14.15, §14.17, §14.19; SRC-ADR
// (Finologee manages the consent state).
// What this aggregate protects is an access decision, not a record: the record is mastered at
// Finologee (A-16). The invariants below are therefore about what the bank refuses, which it can
// enforce, rather than about who writes the master copy, which it cannot.
// Domain events and policies have no syntax in .ddm; they live in
// docs/journeys/ais-consent-lifecycle.eventstorm.
context "Consent" {

  value "AccountReference" {
    attribute "iban"      : "IBAN"
    attribute "bban"      : "BBAN"
    attribute "pan"       : "Max35Text"
    attribute "maskedPan" : "Max35Text"
    attribute "msisdn"    : "Max35Text"
    attribute "currency"  : "CurrencyCode"
  }

  aggregate "Consent" {
    intent    "Decide, for one TPP and one PSU, which account data may be read, until when and how often."
    invariant "[INV-CNS-01] consentStatus moves only received -> valid | rejected | partiallyAuthorised, partiallyAuthorised -> valid | rejected, valid -> expired | revokedByPsu | terminatedByTpp; rejected, expired, revokedByPsu and terminatedByTpp are final (SRC-IG §4.14.2, §14.15)."
    invariant "[INV-CNS-02] In a dedicated-account consent every used access list names at least one account; if any used list is empty then all of them are (SRC-IG §6.3.1.1, §14.17)."
    invariant "[INV-CNS-03] 1 <= frequencyPerDay, and frequencyPerDay <= 4 unless a bilateral agreement with the TPP exists; a one-off consent has frequencyPerDay = 1 (SRC-IG §6.3.1.1)."
    invariant "[INV-CNS-04] The consent belongs to exactly one TPP — the legal owner of the certificate, not the brand in the OU — and only that TPP may address it (SRC-IG §4.9, §4.11)."
    invariant "[INV-CNS-05] validUntil is the date the bank granted, which may be earlier than the date requested, and it never moves later (SRC-IG §6.3.1.1)."
    invariant "[INV-CNS-06] Only a consent this aggregate holds as valid authorises a read. A projection the bank cannot vouch for is not valid: when the enforcing projection is stale beyond its agreed bound, the read is refused rather than served (D-01)."

    root entity "Consent" {
      id         "ConsentId"
      attribute  "tppId"                    : "OrganizationIdentifier"
      attribute  "psuId"                    : "PsuId"
      attribute  "recurringIndicator"       : "Boolean"
      attribute  "requestedValidUntil"      : "ISODate"
      attribute  "validUntil"               : "ISODate"
      attribute  "frequencyPerDay"          : "Integer"
      attribute  "combinedServiceIndicator" : "Boolean"
      attribute  "lastActionDate"           : "ISODate"
      attribute  "recordVersion"            : "Max35Text"
      attribute  "projectedAt"              : "Instant"
      embeds     "AccountAccess" one
      embeds     "ConsentStatus" one
    }

    value "AccountAccess" {
      embeds "AccountReference" many
      attribute "scope" : "accounts | balances | transactions per reference"
    }

    enum "ConsentStatus" {
      "received" "rejected" "partiallyAuthorised" "valid" "revokedByPsu" "expired" "terminatedByTpp"
    }
  }

  // Two things are deliberately NOT modelled as invariants here.
  //
  // 1. "Authorising a new recurring consent ends the former recurring consent of the same TPP and
  //    PSU" (SRC-IG §6.3.1.1) spans two Consent aggregates. It is a policy with eventual
  //    consistency in the event storm, and the resulting status of the former consent is open
  //    (Q-20). Making it transactional would need a "PSU-TPP relationship" aggregate — a boundary
  //    nobody has asked for. Raised as W-DDM-01.
  //
  // 2. Freshness of the projection against the Finologee record. recordVersion and projectedAt
  //    exist so that INV-CNS-06 can be enforced, but the bound itself — how stale is too stale —
  //    is a decision (D-01) and not a fact this model may assert.
}
