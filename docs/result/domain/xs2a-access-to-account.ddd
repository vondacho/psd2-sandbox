// Context map — PSD2 XS2A access to account
// PROPOSAL generated by AI from SRC-IG v1.3.16 and SRC-ADR (docs/context/adr.md @ 7c44c2d).
// Domain experts review language, boundaries and power (gate G2). Context ids used across
// artefacts: CTX-TPP-ACCESS, CTX-CONSENT, CTX-TXN-AUTHORISATION, CTX-PAYMENT-INITIATION,
// CTX-ACCOUNT-INFORMATION, CTX-CUSTOMER-IDENTITY, CTX-MOBILE-BANKING, CTX-CORE-BANKING,
// CTX-TPP (external).
//
// No subdomain is classified core. For this bank XS2A is a regulatory obligation assembled from
// bought products: Finologee mediates the TPPs and masters the consent record, Transmit and
// PingFederate carry identity and tokens, DCP holds the money. Calling any of it core would be a
// budget claim nobody has made (validation report W-DDD-01).
//
// Two edges below are deliberately unflattering, and both come straight from SRC-ADR:
//   * TPP Access -> Consent is conformist, not anticorruption-layer, because the vendor masters
//     the consent state and the bank's model has to follow it.
//   * Core Banking -> Customer Identity and SCA is conformist, because DCP accepts only
//     PingFederate tokens and the identity estate has to exchange for one.
map "PSD2 XS2A access to account" {

  domain "Third-party access to accounts" {
    intent "Let licensed TPPs reach PSU accounts and initiate payments under PSD2, through the
            Berlin Group NextGenPSD2 XS2A interface, with the PSU's consent and SCA."
    owner  "Unassigned — no source names the accountable business owner (Q-01)"

    subdomain supporting "XS2A resources" {
      intent "The resource model the bank owes TPPs: consents, payment initiations and their
              authorisation sub-resources, and consented account data. The gateway is built in
              house (SRC-ADR)."
      owner  "Bank ASPSP gateway team (SRC-ADR: the bank is building its own ASPSP XS2A gateway)"

      context "Consent" {
        intent   "Decide, at any moment, what a TPP may read for a PSU — against a consent record
                  the bank does not master. SRC-ADR puts the consent state at Finologee; what
                  lives here is the enforcing model and the projection behind it (A-16, D-01)."
        language "AIS consent resource" "consent record" "access" "dedicated accounts"
                 "recurringIndicator" "validUntil" "frequencyPerDay" "consentStatus"
                 "revokedByPsu" "terminatedByTpp" "Consent-ID" "enforcing projection"
        aggregate "Consent"
        owner    "Finologee masters the consent record (SRC-ADR); the bank owns the enforcing projection — how the two stay in step is D-01"
        status   drafted
      }

      context "Transaction Authorisation" {
        intent   "Run the authorisation sub-resources of consents and payments: which SCA approach,
                  which scaStatus, which redirect session, and whether what the PSU confirmed on
                  the enrolled device is what the SCA was bound to."
        language "authorisation sub-resource" "scaStatus" "SCA approach" "scaRedirect"
                 "redirect session" "approved-subject digest" "confirmationCode" "implicit start"
                 "finalised" "exempted"
        aggregate "Authorisation"
        owner    "Bank ASPSP gateway team (proposed)"
        status   drafted
      }

      context "Payment Initiation" {
        intent   "Hold each payment initiation resource and its transactionStatus, from RCVD to
                  the last status the XS2A interface reports."
        language "payment initiation" "payment-service" "payment-product" "transactionStatus"
                 "instructedAmount" "debtorAccount" "creditorAccount" "RCVD" "ACTC" "RJCT" "CANC"
        aggregate "Payment Initiation"
        owner    "Bank ASPSP gateway team (proposed)"
        status   drafted
      }

      context "Account Information" {
        intent   "Serve consented account data — account list, details, balances, transactions —
                  without leaking core identifiers, and count unattended reads against the
                  consent's daily frequency."
        language "accessible accounts" "available accounts" "resourceId" "balanceType"
                 "bookingStatus" "withBalance" "unattended read" "ACCESS_EXCEEDED"
        aggregate "Account Resource Map" "Daily Access Allowance"
        owner    "Bank ASPSP gateway team (proposed)"
        status   drafted
      }
    }

    subdomain generic "TPP access mediation and consent state" {
      intent "Terminate TPP connections, identify TPPs from eIDAS certificates, mediate their
              requests, and hold the consent record. Bought: Finologee (SRC-ADR)."
      owner  "Finologee (vendor); the bank's integration owner is unassigned"

      context "TPP Access" {
        intent   "Identify the TPP and its roles, hand an authenticated request to the bank, and
                  master the consent record the bank enforces against."
        language "QWAC" "QSealC" "TPP role" "organizationIdentifier" "NCA" "client_id"
                 "TPP access token" "consent state" "X-Request-ID"
        owner    "Finologee (vendor)"
        status   unmodelled
      }
    }

    subdomain generic "Customer identity and authentication" {
      intent "Authenticate the PSU on the CIAM login screen, carry strong authentication on an
              enrolled device, and issue the tokens the bank's own services accept. Two commercial
              products operated in house (SRC-ADR)."
      owner  "Bank IAM team (assumed, A-12)"

      context "Customer Identity and SCA" {
        intent   "Authenticate the PSU, drive the SCA method on an enrolled device, and turn the
                  result into a token the bank's services accept. Transmit and PingFederate are
                  both issuers, and a token exchange bridges them (SRC-ADR)."
        language "PSU identity" "login screen" "device enrolment" "enrolled device" "SCA method"
                 "OTP" "QR code" "biometric method" "CIAM token" "IDP token" "token exchange"
                 "dynamic linking"
        owner    "Bank IAM team (assumed, A-12)"
        status   unmodelled
      }
    }
  }

  domain "Retail banking" {
    intent "The bank's own customer channels and account servicing, which XS2A depends on but does
            not own."
    owner  "Unassigned in the supplied sources"

    context "Mobile Banking" {
      intent   "The PSU's own banking app on the enrolled device. In the PSD2 journey it presents
                the OTP, QR-code and biometric screens and the consent confirmation panel, at the
                request of the CIAM (SRC-ADR). It presents nothing for a payment, which is C-09."
      language "enrolled device" "OTP screen" "QR code screen" "biometric screen"
               "consent confirmation panel" "SCA method"
      owner    "Bank mobile app team (SRC-ADR: the bank has its own mobile banking app)"
      status   unmodelled
    }

    context "Core Banking" {
      intent   "The in-house DCP Digital Client Platform: the PSU's accounts, transactions and
                payment services. Its services consume PingFederate tokens only (SRC-ADR)."
      language "DCP" "booking" "account number" "posting" "cut-off" "PingFederate token"
      owner    "Unassigned in the supplied sources (Q-05)"
      status   unmodelled
    }
  }

  domain "PSD2 ecosystem" {
    intent "Parties outside the bank that use the XS2A interface."
    owner  "Each TPP; the Berlin Group owns the standard"

    context "Third-Party Provider" {
      intent   "An AISP, PISP or PIISP acting for a PSU. Under SRC-ADR the TPP also manages the
                consent screen in the PSU's browser, so the surface where a PSU grants or revokes
                access is outside the bank altogether."
      language "PSU" "AISP" "PISP" "PIISP" "consent screen" "redirect URI"
      owner    "Each TPP"
      status   unmodelled
    }
  }

  // ---- Relationships. On a directed edge the left name is upstream.

  "TPP Access" -> "Third-Party Provider" : published-language / conformist {
    exchange "Berlin Group NextGenPSD2 XS2A requests and responses (SRC-IG v1.3.16)."
    because  "The standard is the published language; a TPP integrates with hundreds of ASPSPs and
              will not negotiate a bank-specific dialect. The bank may only choose the options the
              standard leaves open."
  }

  "TPP Access" -> "Consent" : open-host-service / conformist {
    exchange "The consent record: its access rights, validity, frequency and status, plus every
              change to them."
    because  "SRC-ADR says Finologee manages the consent state. The bank therefore cannot define
              its own consent lifecycle — it reproduces the vendor's, including whatever that
              vendor does about revocation timing and audit export (Q-45). This is conformist and
              not an anticorruption layer on purpose: an anticorruption layer protects a model the
              bank owns, and here the bank does not own it. If D-01 moves the master record into
              the gateway, this edge becomes customer-supplier and the label should change with it."
  }

  "TPP Access" -> "Payment Initiation" : open-host-service / anticorruption-layer {
    exchange "Identified TPP and payment initiation requests."
    because  "Payments are mastered by the bank, so the gateway can and should keep the vendor's
              integration shape out of its own resource model. Its contract was not supplied (Q-03)."
  }

  "TPP Access" -> "Account Information" : open-host-service / anticorruption-layer {
    exchange "Identified TPP, Consent-ID or access token, read requests."
    because  "Same vendor contract as for payments; same protection."
  }

  "Customer Identity and SCA" -> "Transaction Authorisation" : customer-supplier {
    exchange "PSU authenticated on the login screen; SCA result from the enrolled device, bound to
              what the PSU confirmed."
    because  "The journeys are configured in house on Transmit and PingFederate (SRC-ADR), so the
              IAM team can build what XS2A asks for — within what the two products can do, which
              nobody has checked (Q-14, Q-16)."
  }

  "Core Banking" -> "Customer Identity and SCA" : conformist {
    exchange "Access tokens DCP will accept."
    because  "SRC-ADR: DCP services require a PingFederate token, and a Transmit token has to be
              exchanged for one. The requirement belongs to core banking and is not up for
              negotiation here; the identity estate carries the exchange (D-02)."
  }

  "Transaction Authorisation" -> "Consent" : customer-supplier {
    exchange "Authorisation finalised or failed, for a consent."
    because  "A consent's status follows its authorisation, never the other way round."
  }

  "Transaction Authorisation" -> "Payment Initiation" : customer-supplier {
    exchange "Authorisation finalised or failed, for a payment."
    because  "A payment's status follows its authorisation; multilevel SCA would add several."
  }

  "Consent" -> "Account Information" : customer-supplier {
    exchange "Consent validity, access per account, frequencyPerDay."
    because  "Every read is decided against the consent; the consent does not care how data is read."
  }

  "Core Banking" -> "Account Information" : anticorruption-layer {
    exchange "Accounts, balances, bookings."
    because  "DCP's booking model is not the Berlin Group account model, its interfaces are unknown
              (Q-05), and XS2A must not leak core identifiers such as account numbers into paths."
  }

  "Core Banking" -> "Payment Initiation" : anticorruption-layer {
    exchange "Payment submission and execution outcome."
    because  "Same reason; and the end status the bank can report (ACTC against ACSC) is decided by
              DCP's booking behaviour (Q-31)."
  }

  "Mobile Banking" <-> "Customer Identity and SCA" : partnership {
    exchange "Device enrolment, and the OTP, QR-code, biometric and consent confirmation screens
              presented on demand by the CIAM."
    because  "SRC-ADR: the CIAM owns device enrolment and the SCA methods and asks the app to
              present the screens — neither side works without the other."
  }
}
