// CTX-ACCOUNT-INFORMATION — domain model. PROPOSAL generated by AI.
// Sources: SRC-IG §6 (available vs accessible accounts, frequency checked per account and per
// PSU), §6.5, §14.11.3 ACCESS_EXCEEDED, §14.20.
// Two aggregates, each with something of its own to protect: one keeps core identifiers out of
// the XS2A surface, the other keeps a promise the PSU made about how often a TPP may look.
context "Account Information" {

  aggregate "Account Resource Map" {
    intent    "Give each account the TPP may address a resourceId that reveals nothing about core banking, and translate it back on every read."
    invariant "[INV-ACC-01] No IBAN, no DCP account number and no other core identifier appears in a URL path or query parameter; only a resourceId does (SRC-IG §14.20)."
    invariant "[INV-ACC-02] A resourceId resolves to an account only for the consent it was issued under, and never for another TPP's consent (SRC-IG §4.11)."

    root entity "Account Resource Map" {
      id        "ConsentId"
      attribute "issuedAt" : "Instant"
      contains  "AccountResource" at-least-one
    }

    entity "AccountResource" {
      id        "ResourceId"
      attribute "iban"        : "IBAN"
      attribute "currency"    : "CurrencyCode"
      attribute "accessTypes" : "accounts | balances | transactions"
    }
  }

  aggregate "Daily Access Allowance" {
    intent    "Keep the promise the PSU confirmed about how often a TPP may read without them, for one consent and one account, on one day."
    invariant "[INV-ACC-03] The number of reads served without PSU involvement for one consent, one account and one day never exceeds the consent's frequencyPerDay; the read that would exceed it is refused with ACCESS_EXCEEDED (SRC-IG §6, §14.11.3)."
    invariant "[INV-ACC-04] A read the PSU is present for does not consume the allowance, and a refused read does not consume it either (SRC-IG §6.3.1.1)."

    root entity "Daily Access Allowance" {
      id         "AllowanceId"
      attribute  "day" : "ISODate"
      references "Account Resource Map" one
      contains   "AccountUsage" many
    }

    entity "AccountUsage" {
      id        "ResourceId"
      attribute "unattendedReads" : "Integer"
      attribute "lastReadAt"      : "Instant"
    }
  }
}
