// C4 model — PSD2 XS2A access to account (LikeC4)
// PROPOSAL generated by AI. Elements named in SRC-ADR are the bank's own decisions; elements this
// proposal adds carry #proposed, and allocations nobody has decided carry #undecided plus the
// decision id (D-xx) in their metadata.
// metadata.cmp = component id, metadata.ctx = owning bounded context (docs/domain/*.ddd),
// metadata.stories = the stories that justify the element (docs/stories/*.storymap).
// PSU-facing screens are elements of kind appScreen / webScreen nested inside the element that
// manages them; metadata.scr and metadata.readmodels use the SCR- and RM- ids defined in
// docs/journeys/service-blueprint.md.
//
// Per SRC-ADR: the TPP manages the consent screen, the CIAM owns the browser login screen, the
// mobile app presents the OTP, QR-code and biometric screens and the consent confirmation panel,
// and Finologee masters the consent record. The bank has exactly one browser surface of its own.
// There is no payment confirmation screen anywhere in this model, and that is the point of Q-17.

specification {
  element actor {
    style {
      shape person
      color green
    }
  }
  element system
  element container
  element component
  element database {
    style {
      shape storage
    }
  }
  element appScreen {
    style {
      shape mobile
      color amber
    }
  }
  element webScreen {
    style {
      shape browser
      color amber
    }
  }

  tag vendor
  tag bank
  tag external
  tag proposed
  tag undecided
  tag skeleton
  tag mvp
}

model {

  psu = actor 'Account holder (PSU)' {
    description 'Bank customer who uses a TPP and confirms its requests on an enrolled device'
    metadata {
      actor 'ACT-PSU'
    }
  }

  tpp = system 'Third-Party Provider (AISP / PISP)' {
    #external #skeleton #mvp
    description 'Licensed TPP calling the Berlin Group XS2A interface with its eIDAS QWAC. Under SRC-ADR it also manages the consent screen the PSU sees in the browser'
    metadata {
      cmp 'CMP-TPP'
      ctx 'CTX-TPP'
      stories 'STORY-TPP-IDENTIFY STORY-CONSENT-DEDICATED STORY-CONSENT-DELETE'
    }

    tppConsent = webScreen 'Consent screen (TPP)' {
      #external #skeleton #mvp
      description 'Where the PSU grants or revokes this TPP access, in the browser. Managed by the TPP (SRC-ADR); the bank does not design it'
      metadata {
        scr 'SCR-TPP-CONSENT'
      }
    }
    tppResult = webScreen 'TPP result screen' {
      #external #skeleton #mvp
      description 'The TPP shows the outcome after the PSU returns'
      metadata {
        scr 'SCR-TPP-RESULT'
        readmodels 'RM-TPP-CONSENT-STATUS RM-TPP-PAYMENT-STATUS'
      }
    }
  }

  trust = system 'Qualified trust services and NCA registers' {
    #external
    description 'Issue and revoke QWAC and QSealC certificates; register TPP authorisations. Who consults them is open (Q-08)'
    metadata {
      cmp 'CMP-TRUST-SERVICES'
      decisions 'Q-08'
    }
  }

  finologee = system 'Finologee PSD2 gateway' {
    #vendor #skeleton #mvp
    description 'The chosen PSD2 gateway: intermediary between the ASPSP and TPPs, OIDC and OAuth 2.0 towards the TPP, and master of the consent record (SRC-ADR)'
    metadata {
      cmp 'CMP-FINOLOGEE-GW'
      ctx 'CTX-TPP-ACCESS'
      decisions 'D-01 D-05 Q-03 Q-45'
      stories 'STORY-TPP-IDENTIFY STORY-TPP-ROLE-CHECK STORY-CONSENT-DEDICATED STORY-CONSENT-DELETE'
    }
  }

  bank = system 'Bank' {
    #bank
    description 'The ASPSP'

    gateway = container 'ASPSP XS2A gateway' {
      #bank #proposed #skeleton #mvp
      technology 'Built in house (SRC-ADR); proposed as one deployable, modular by bounded context (D-06)'
      description 'Implements the XS2A resource model behind the PSD2 gateway'
      metadata {
        cmp 'CMP-ASPSP-GW'
        decisions 'D-05 D-06'
      }

      edge = component 'XS2A API adapter' {
        #proposed #skeleton #mvp
        description 'Anticorruption layer between the Finologee integration contract and the XS2A resource model; X-Request-ID, error mapping to tppMessages'
        metadata {
          cmp 'CMP-XS2A-ADAPTER'
          ctx 'CTX-TPP-ACCESS'
          stories 'STORY-TPP-IDENTIFY STORY-TPP-RESOURCE-ISOLATION STORY-XS2A-PROFILE'
          interfaces 'API-XS2A-PROFILE'
        }
      }

      consentModule = component 'Consent module' {
        #proposed #undecided #skeleton #mvp
        description 'The enforcing projection of the Finologee-mastered consent record, and the access decision on every read. Whether this copy or the vendor record decides a read is D-01'
        metadata {
          cmp 'CMP-CONSENT'
          ctx 'CTX-CONSENT'
          decisions 'D-01 Q-22 Q-45'
          readmodels 'RM-ACCESS-DECISION RM-CONSENTS-DUE-TO-EXPIRE RM-PSU-TPP-ACCESS'
          stories 'STORY-TPP-RESOURCE-ISOLATION STORY-CONSENT-DEDICATED STORY-CONSENT-STATUS STORY-CONSENT-READ STORY-CONSENT-DELETE STORY-CONSENT-EXPIRY STORY-ENFORCE-FREQUENCY'
        }
      }

      authorisationModule = component 'Authorisation module' {
        #proposed #skeleton #mvp
        description 'Authorisation sub-resources, scaStatus, redirect sessions, and the digest that binds an SCA result to what the PSU confirmed'
        metadata {
          cmp 'CMP-AUTHORISATION'
          ctx 'CTX-TXN-AUTHORISATION'
          decisions 'D-03 Q-24 Q-29'
          readmodels 'RM-REDIRECT-SESSION RM-AUTHORISATION-OUTCOME RM-SCA-DEADLINES'
          stories 'STORY-SCA-DEVICE STORY-SCA-STATUS STORY-SCA-REQUEST-UNAVAILABLE STORY-PIS-SCA-DEVICE'
        }
      }

      paymentModule = component 'Payment initiation module' {
        #proposed #skeleton #mvp
        description 'Payment initiation resources and their transactionStatus'
        metadata {
          cmp 'CMP-PAYMENT'
          ctx 'CTX-PAYMENT-INITIATION'
          stories 'STORY-TPP-RESOURCE-ISOLATION STORY-PIS-INITIATE-SCT STORY-PIS-STATUS STORY-PIS-READ-PAYMENT STORY-PIS-SCA-TIMEOUT'
        }
      }

      accountModule = component 'Account information module' {
        #proposed #skeleton #mvp
        description 'Consented account list, details, balances and transactions; the resourceId map and the daily access allowance'
        metadata {
          cmp 'CMP-ACCOUNT-INFO'
          ctx 'CTX-ACCOUNT-INFORMATION'
          readmodels 'RM-ACCESS-DECISION'
          stories 'STORY-READ-ACCOUNT-LIST STORY-READ-ACCOUNT-DETAILS STORY-READ-BALANCES STORY-READ-TRANSACTIONS STORY-ENFORCE-FREQUENCY'
        }
      }

      coreAdapter = component 'Core banking adapter' {
        #proposed #skeleton #mvp
        description 'Anticorruption layer to DCP, and the holder of the PingFederate token DCP requires. A stub in the walking skeleton until Q-05 is answered'
        metadata {
          cmp 'CMP-CORE-ADAPTER'
          ctx 'CTX-ACCOUNT-INFORMATION'
          decisions 'D-02 Q-05'
          stories 'STORY-READ-ACCOUNT-LIST STORY-READ-ACCOUNT-DETAILS STORY-READ-BALANCES STORY-READ-TRANSACTIONS STORY-PIS-INITIATE-SCT'
        }
      }

      psuChannel = component 'PSU channel API' {
        #proposed #skeleton #mvp
        description 'Backend of the CIAM browser pages and of the app panels: what to show, and what the PSU decided (API-PSU-CHANNEL)'
        metadata {
          cmp 'CMP-PSU-CHANNEL-API'
          ctx 'CTX-TXN-AUTHORISATION'
          decisions 'Q-15 Q-17 Q-18'
          readmodels 'RM-CONSENT-APPROVAL RM-PAYMENT-APPROVAL RM-SCA-PROMPT RM-AUTHORISATION-OUTCOME RM-REDIRECT-SESSION'
          interfaces 'API-PSU-CHANNEL'
          stories 'STORY-SCA-DEVICE STORY-PIS-SCA-DEVICE STORY-SCA-CONSENT-DETAILS STORY-SCA-OUTCOME STORY-SCA-REQUEST-UNAVAILABLE'
        }
      }

      outbox = component 'Domain event outbox' {
        #proposed #undecided #mvp
        description 'Publishes consent, authorisation and payment status changes for audit and metrics (API-XS2A-EVENTS)'
        metadata {
          cmp 'CMP-EVENT-OUTBOX'
          decisions 'D-04'
          interfaces 'API-XS2A-EVENTS'
        }
      }

      store = database 'XS2A resource store' {
        #proposed #skeleton #mvp
        description 'Authorisations, payment initiations, resource maps, access allowances, and the consent projection'
        metadata {
          cmp 'CMP-XS2A-STORE'
        }
      }
    }

    transmit = container 'Transmit CIAM' {
      #vendor #skeleton #mvp
      description 'Bank CIAM: device management and enrolment, Auth-N, Auth-Z, the SCA methods, and a token issuer. Owns the browser login screen (SRC-ADR, A-08)'
      metadata {
        cmp 'CMP-TRANSMIT'
        ctx 'CTX-CUSTOMER-IDENTITY'
        decisions 'D-02 Q-12 Q-14 Q-15 Q-16'
        readmodels 'RM-SCA-CONTEXT'
        stories 'STORY-SCA-DEVICE STORY-PIS-SCA-DEVICE STORY-SCA-METHOD-CHOICE STORY-DEVICE-ENROLMENT'
      }

      loginScreen = webScreen 'Login screen' {
        #skeleton #mvp
        description 'The PSU authenticates against the CIAM, in the web browser (SRC-ADR). The only bank surface in the browser that SRC-ADR names'
        metadata {
          scr 'SCR-CIAM-LOGIN'
        }
      }
      awaitDevice = webScreen 'Continue on your enrolled device' {
        #proposed #skeleton #mvp
        description 'Proposed, not stated: the ADR names no bank page between login and return (Q-18)'
        metadata {
          scr 'SCR-CIAM-AWAIT-DEVICE'
          readmodels 'RM-AUTHORISATION-OUTCOME'
        }
      }
      outcomePage = webScreen 'Outcome and return to the TPP' {
        #proposed #mvp
        description 'Proposed (Q-18)'
        metadata {
          scr 'SCR-CIAM-OUTCOME'
          readmodels 'RM-AUTHORISATION-OUTCOME'
        }
      }
      unavailablePage = webScreen 'Request no longer available' {
        #proposed #mvp
        description 'Proposed (Q-18)'
        metadata {
          scr 'SCR-CIAM-UNAVAILABLE'
          readmodels 'RM-REDIRECT-SESSION RM-AUTHORISATION-OUTCOME'
        }
      }
    }

    ping = container 'PingFederate IDP' {
      #vendor #skeleton #mvp
      description 'Bank IDP and token issuer. DCP services consume PingFederate tokens, so a Transmit token has to be exchanged for one (SRC-ADR, D-02)'
      metadata {
        cmp 'CMP-PING'
        ctx 'CTX-CUSTOMER-IDENTITY'
        decisions 'D-02 Q-04 Q-16'
        stories 'STORY-SCA-DEVICE STORY-PIS-SCA-DEVICE'
      }
    }

    mobileApp = container 'Mobile banking app' {
      #bank #skeleton #mvp
      description 'The bank app on the enrolled device. In the PSD2 journey it presents the SCA screens and the consent confirmation panel at the request of the CIAM (SRC-ADR)'
      metadata {
        cmp 'CMP-MOBILE-APP'
        ctx 'CTX-MOBILE-BANKING'
        decisions 'Q-15 Q-17 Q-36'
        stories 'STORY-SCA-DEVICE STORY-PIS-SCA-DEVICE STORY-SCA-METHOD-CHOICE STORY-SCA-CONSENT-DETAILS'
      }

      otpScreen = appScreen 'OTP screen' {
        #skeleton #mvp
        description 'The PSU confirms identity with a one-time password (SRC-ADR)'
        metadata {
          scr 'SCR-APP-OTP'
          readmodels 'RM-SCA-PROMPT'
        }
      }
      qrScreen = appScreen 'QR code screen' {
        #mvp
        description 'The PSU confirms identity by scanning a QR code (SRC-ADR)'
        metadata {
          scr 'SCR-APP-QR'
          readmodels 'RM-SCA-PROMPT'
        }
      }
      biometricScreen = appScreen 'Biometric screen' {
        #mvp
        description 'The PSU confirms identity with a biometric method (SRC-ADR)'
        metadata {
          scr 'SCR-APP-BIOMETRIC'
          readmodels 'RM-SCA-PROMPT'
        }
      }
      consentConfirm = appScreen 'Consent confirmation panel' {
        #skeleton #mvp
        description 'The PSU confirms the items of the consent (SRC-ADR). Read as the ASPSP displaying the consent details during SCA, which the Detailed Consent model expects (A-15)'
        metadata {
          scr 'SCR-APP-CONSENT-CONFIRM'
          readmodels 'RM-CONSENT-APPROVAL'
        }
      }
      enrolment = appScreen 'Device enrolment' {
        #undecided
        description 'CIAM device enrolment — a bank-wide capability assumed to exist (A-14, Q-36)'
        metadata {
          scr 'SCR-APP-DEVICE-ENROLMENT'
          readmodels 'RM-SCA-CONTEXT'
        }
      }
    }

    core = container 'DCP Digital Client Platform' {
      #bank
      description 'In-house core banking: the PSU accounts, transactions and payment services. Its interfaces are unknown and it requires a PingFederate token (Q-05)'
      metadata {
        cmp 'CMP-CORE-BANKING'
        ctx 'CTX-CORE-BANKING'
        decisions 'D-02 Q-05'
      }
    }

    observability = container 'Observability platform' {
      #bank #undecided
      description 'Traces, metrics and logs for the XS2A path. The platform is not named in the supplied context (Q-06)'
      metadata {
        cmp 'CMP-OBSERVABILITY'
        decisions 'Q-06'
        readmodels 'RM-OPS-SCA-FUNNEL RM-OPS-XS2A-HEALTH'
      }
    }
  }

  // ---- relationships

  psu -> tpp 'uses the TPP service'
  psu -> tpp.tppConsent 'grants or revokes access on the TPP consent screen'
  psu -> bank.transmit.loginScreen 'authenticates at the bank'
  psu -> bank.mobileApp 'confirms on the enrolled device'

  tpp -> finologee 'calls XS2A over mTLS with its QWAC' {
    #skeleton
  }
  finologee -> trust 'validates certificates and registers? (Q-08)'
  finologee -> bank.gateway.edge 'forwards identified TPP requests (vendor contract Q-03)' {
    #skeleton #undecided
  }
  tpp.tppConsent -> finologee 'the TPP posts the detailed consent it collected'

  bank.gateway.edge -> bank.gateway.consentModule 'consent commands and queries'
  bank.gateway.edge -> bank.gateway.authorisationModule 'authorisation sub-resource calls'
  bank.gateway.edge -> bank.gateway.paymentModule 'payment initiation calls'
  bank.gateway.edge -> bank.gateway.accountModule 'account reads with Consent-ID'

  bank.gateway.consentModule -> finologee 'projects the consent record the vendor masters (D-01)' {
    #undecided
  }
  bank.gateway.authorisationModule -> bank.gateway.consentModule 'authorisation finalised or failed'
  bank.gateway.authorisationModule -> bank.gateway.paymentModule 'authorisation finalised or failed'
  bank.gateway.accountModule -> bank.gateway.consentModule 'may this TPP read this account now?'
  bank.gateway.accountModule -> bank.gateway.coreAdapter 'accounts, balances, transactions'
  bank.gateway.paymentModule -> bank.gateway.coreAdapter 'submit payment, read outcome'
  bank.gateway.coreAdapter -> bank.ping 'exchange the CIAM token for a PingFederate token (D-02)' {
    #undecided
  }
  bank.gateway.coreAdapter -> bank.core 'core banking interface, with a PingFederate token (Q-05)'

  bank.gateway.consentModule -> bank.gateway.store 'reads and writes'
  bank.gateway.authorisationModule -> bank.gateway.store 'reads and writes'
  bank.gateway.paymentModule -> bank.gateway.store 'reads and writes'
  bank.gateway.accountModule -> bank.gateway.store 'reads and writes'
  bank.gateway.outbox -> bank.gateway.store 'reads the outbox'
  bank.gateway.outbox -> bank.observability 'status-change events for audit and metrics'
  bank.gateway -> bank.observability 'traces, metrics, logs'

  // ---- the PSU journey across the two surfaces

  tpp.tppConsent -> bank.transmit.loginScreen 'scaRedirect: the PSU authenticates at the bank'
  bank.transmit.loginScreen -> bank.transmit.awaitDevice 'authenticated; waiting for the device'
  bank.transmit -> bank.gateway.psuChannel 'resolves the redirect session and reads the outcome'
  bank.transmit -> bank.mobileApp 'asks an enrolled device to confirm (how is open, Q-15)'
  bank.transmit -> bank.ping 'federation and token exchange (D-02)'
  bank.mobileApp.otpScreen -> bank.transmit 'SCA result'
  bank.mobileApp.qrScreen -> bank.transmit 'SCA result'
  bank.mobileApp.biometricScreen -> bank.transmit 'SCA result'
  bank.mobileApp.consentConfirm -> bank.gateway.psuChannel 'reads the consent items; confirms or declines'
  bank.mobileApp.enrolment -> bank.transmit 'device enrolment (A-14)'
  bank.transmit.awaitDevice -> bank.transmit.outcomePage 'the device answered'
  bank.transmit.outcomePage -> tpp.tppResult 'back to the TPP redirect URI'
  bank.transmit.unavailablePage -> tpp.tppResult 'back to the TPP nok redirect URI'
  bank.gateway.psuChannel -> bank.gateway.authorisationModule 'redirect sessions, prompts, decisions, outcomes'
  bank.gateway.psuChannel -> bank.gateway.consentModule 'the consent items to confirm'
  bank.gateway.psuChannel -> bank.gateway.paymentModule 'the payment details — with no screen to show them (Q-17)'
  bank.gateway.psuChannel -> bank.gateway.coreAdapter 'account labels (Q-32)'

}

views {

  view index {
    title 'System context — PSD2 XS2A'
    description 'Who talks to whom. Elements from SRC-ADR are the bank decisions; #proposed elements are this proposal.'
    include *
    include bank.gateway, bank.mobileApp, bank.transmit, bank.ping, bank.core
    exclude bank.observability
  }

  view containers of bank {
    title 'Containers — the bank side of XS2A'
    include *
    include tpp, finologee, psu
  }

  view gateway of bank.gateway {
    title 'Components — ASPSP XS2A gateway (modules by bounded context)'
    include *
    include finologee, bank.core, bank.mobileApp, bank.transmit, bank.ping, bank.observability
  }

  view walkingSkeleton {
    title 'WS-01 — walking skeleton path'
    description 'Elements and relationships exercised by WS-01 (docs/delivery/walking-skeleton.md)'
    include
      psu,
      tpp,
      finologee,
      bank.gateway.edge,
      bank.gateway.consentModule,
      bank.gateway.authorisationModule,
      bank.gateway.paymentModule,
      bank.gateway.accountModule,
      bank.gateway.coreAdapter,
      bank.gateway.store,
      bank.gateway.psuChannel,
      bank.transmit,
      bank.ping,
      bank.mobileApp
  }

  view psuScreens {
    title 'PSU screens and the components that manage them'
    description 'Screens (amber) nested in the element that manages them. The consent screen is the TPP\'s; the bank has one browser page and the device panels. Nothing here shows a payment (Q-17)'
    include
      psu,
      tpp,
      tpp.*,
      bank.transmit,
      bank.transmit.*,
      bank.mobileApp,
      bank.mobileApp.*,
      bank.gateway.psuChannel,
      bank.gateway.authorisationModule,
      bank.gateway.consentModule,
      bank.gateway.paymentModule,
      finologee
  }

  view mvp {
    title 'MVP-01 — elements in the MVP slice'
    include element.tag = #mvp
    include psu
  }
}
