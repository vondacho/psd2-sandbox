@startuml mvp-consent-end
' MVP-01 — a consent ends, and the next read is refused.
' PROPOSAL generated by AI from SRC-IG §6.4, §14.15, §14.11.1 and SRC-ADR (Finologee masters the
' consent record). It also shows the path that does not exist: revokedByPsu.
title MVP-01 — ending access, and the path that has no surface

actor "PSU" as psu
participant "TPP consent screen" as tppui
participant "AISP" as tpp
participant "Finologee\n(master record)" as fin
participant "XS2A adapter" as edge
participant "Consent\n(projection + access decision)" as consent
participant "Account information\n(CMP-ACCOUNT-INFO)" as acc

group terminatedByTpp — the path SRC-ADR supports
  psu -> tppui : withdraws access on the TPP's screen
  tppui -> tpp : withdraw
  tpp -> fin : DELETE /v1/consents/{id}
  fin -> edge : forward
  edge -> consent : terminate
  consent -> fin : record ends (terminatedByTpp)
  consent --> tpp : 204 No Content
end

group revokedByPsu — the path with no surface (C-07, D-09)
  psu -[#red]-> psu : wants to withdraw at the bank
  note right of psu #FFDDDD
    SRC-IG §14.15 defines revokedByPsu as a
    revocation towards the ASPSP. The only
    consent screen belongs to the TPP, so
    there is nowhere to do this. D-09 decides
    whether that is acceptable.
  end note
end

group the next read
  tpp -> fin : GET /v1/accounts (Consent-ID)
  fin -> edge : forward
  edge -> acc : read
  acc -> consent : may this TPP read now? (RM-ACCESS-DECISION)
  consent -> consent : projection fresh? (INV-CNS-06, D-01)
  consent --> acc : no — the consent has ended
  acc --> tpp : refused
  note over consent
    Which message code applies to a consent the
    PSU ended, as opposed to one that expired,
    is Q-22.
  end note
end
@enduml
