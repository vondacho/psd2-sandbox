@startuml ws-01-ais-consent-redirect
' WS-01 — AIS consent, redirect SCA, confirmation on the enrolled device.
' PROPOSAL generated by AI from SRC-IG §6.1.1.1, §6.3.1, §6.3.2 and SRC-ADR (CIAM login in the
' browser, then OTP / QR / biometrics, then the consent confirmation panel).
' Dashed notes mark what no source settles.
title WS-01 — AIS consent on dedicated accounts (redirect, device confirmation)

actor "PSU" as psu
participant "TPP consent screen\n(SCR-TPP-CONSENT)" as tppui
participant "AISP" as tpp
participant "Finologee\n(CMP-FINOLOGEE-GW)" as fin
participant "XS2A adapter\n(CMP-XS2A-ADAPTER)" as edge
participant "Consent\n(CMP-CONSENT)" as consent
participant "Authorisation\n(CMP-AUTHORISATION)" as auth
participant "PSU channel\n(CMP-PSU-CHANNEL-API)" as psuapi
participant "Transmit CIAM\n(CMP-TRANSMIT)" as ciam
participant "Bank app\n(CMP-MOBILE-APP)" as app

psu -> tppui : grants access at the TPP
tppui -> tpp : detailed consent
tpp -> fin : POST /v1/consents (mTLS, QWAC)
fin -> fin : identify TPP from the certificate\n(EVT-TPP-IDENTIFIED)
fin -> edge : forward identified request
edge -> consent : create consent
consent -> fin : project / master record (D-01)
note right of consent
  Finologee masters the consent record
  (SRC-ADR). The gateway holds the
  enforcing projection (A-16).
end note
consent -> auth : start authorisation implicitly (R-SCA-01)
auth --> edge : consentStatus received + scaRedirect
edge --> fin : 201 Created
fin --> tpp : 201 Created, ASPSP-SCA-Approach REDIRECT

tpp --> psu : redirect to scaRedirect
psu -> ciam : opens the bank login screen (SCR-CIAM-LOGIN)
ciam -> psuapi : resolveRedirectSession
psuapi -> auth : resolve, once (INV-AUT-03)
auth --> psuapi : live session, purpose = consent
psu -> ciam : authenticates
ciam -> app : ask an enrolled device to confirm
note right of ciam
  How the CIAM reaches the app is
  unknown (Q-15).
end note
app -> psuapi : getScaPrompt (RM-SCA-PROMPT)
psu -> app : confirms identity (OTP, SCR-APP-OTP)
app -> ciam : SCA result
ciam -> psuapi : recordScaResult (digest of the subject)
app -> psuapi : getConsentApproval (RM-CONSENT-APPROVAL)
app -> psu : consent confirmation panel (SCR-APP-CONSENT-CONFIRM)
psu -> app : confirms the items
app -> psuapi : decideConsentApproval
psuapi -> auth : record the decision
auth -> auth : check digest against what was shown (INV-AUT-05)
auth -> consent : authorisation finalised
consent -> consent : consentStatus valid (EVT-CONSENT-AUTHORISED)
ciam --> psu : outcome page (SCR-CIAM-OUTCOME) and back to the TPP
note over ciam
  The waiting and outcome pages are
  proposed, not stated (Q-18).
end note

tpp -> fin : GET /v1/consents/{id}/status
fin -> edge : forward
edge -> consent : read status
consent --> tpp : consentStatus valid
@enduml
