@startuml authorisation-screen-flow
' The screens a PSU meets while authorising a TPP request, across the two surfaces SRC-ADR names.
' PROPOSAL generated by AI. Screen ids are defined in docs/journeys/service-blueprint.md.
title PSU authorisation — screen flow across the browser and the enrolled device

state "Browser" as browser {
  state "SCR-TPP-CONSENT\nconsent screen (TPP)" as tppConsent
  state "SCR-CIAM-LOGIN\nbank login screen" as login
  state "SCR-CIAM-AWAIT-DEVICE\ncontinue on your device" as await
  state "SCR-CIAM-OUTCOME\noutcome and return" as outcome
  state "SCR-CIAM-UNAVAILABLE\nno longer available" as unavailable
  state "SCR-TPP-RESULT\nresult (TPP)" as tppResult
}

state "Enrolled device" as device {
  state "SCR-APP-OTP / SCR-APP-QR /\nSCR-APP-BIOMETRIC" as sca
  state "SCR-APP-CONSENT-CONFIRM\nconsent confirmation panel" as confirm
  state "no payment surface" as gap
}

[*] --> tppConsent
tppConsent --> login : scaRedirect
login --> await : authenticated
login --> unavailable : session unknown, expired or used
await --> sca : the CIAM asks the device
sca --> confirm : identity confirmed, purpose = consent
sca --> gap : identity confirmed, purpose = payment
confirm --> outcome : items confirmed or declined
gap --> outcome : confirmed with nothing shown
outcome --> tppResult : back to the TPP
unavailable --> tppResult : back to the nok URI
tppResult --> [*]

note right of gap #FFDDDD
  There is no payment confirmation panel.
  SRC-ADR names none, and this flow does
  not invent one. Q-17, C-09, UX-09.
end note

note bottom of await
  The three CIAM pages between login and
  return are proposed, not stated. Q-18.
end note
@enduml
