// Process model — AIS consent lifecycle, from the TPP's request to the end of access.
// PROPOSAL generated by AI. Sources: SRC-IG §6.1.1, §6.3, §6.4, §6.5, §7, §14.15, §14.16;
// SRC-ADR (Finologee masters the consent state; CIAM login in the browser; OTP / QR / biometric
// then the consent confirmation panel on the enrolled device).
// Commands, policies and read models make this a process model; aggregates make the software
// design visible where the walking skeleton needs it.
// Screen ids (+SCR-...) and read-model ids (+RM-...) are defined in service-blueprint.md.
eventstorm "AIS consent lifecycle" {

  lane "TPP (AISP)" {
    actor "AISP" @1
    command "Request a consent on dedicated accounts" @1
    event "Consent requested" @2
    command "Read the consent status" @13
    command "Read the consent object" @13
    command "Read account data" @15
    command "Delete the consent" @18
    event "Consent deletion requested" @18
  }

  lane "Consent" {
    aggregate "Consent" @2
    policy "Whenever a consent is requested, validate the access lists, the frequency and the \
            validity before creating anything" @2
    event "Consent request refused as malformed" @2 {
      note "Which code — 400 FORMAT_ERROR or 401 CONSENT_INVALID — is open (Q-19)."
    }
    event "Consent record created" @3 {
      note "consentStatus = received. SRC-ADR puts the master record at Finologee; the gateway \
            holds the enforcing projection (A-16, D-01)."
    }
    event "Requested validity shortened by the bank" @3 {
      note "validUntil is what the bank granted, never later than requested (SRC-IG §6.3.1.1)."
    }
    hotspot "Nobody has stated the bank's maximum consent validity, nor whether any TPP gets \
             more than four reads a day" @3 +"ask compliance" +Q-11
    readmodel "Consent as the TPP asked for it" @4 +RM-CONSENT-APPROVAL
    policy "Whenever an authorisation for a consent is finalised, make the consent valid" @12
    event "Consent became valid" @12 +EVT-CONSENT-AUTHORISED
    policy "Whenever a recurring consent becomes valid, end the PSU's former recurring consent \
            with the same TPP" @12
    event "Former recurring consent ended" @12
    hotspot "Does the former consent become expired (§6.3.1.1) or terminatedByTpp (§4.14.2)?" @12 +"ask compliance" +Q-20
    policy "Whenever an authorisation for a consent fails, reject the consent" @12
    event "Consent rejected" @12
    readmodel "Consents due to expire" @19 +RM-CONSENTS-DUE-TO-EXPIRE
    policy "Whenever a consent passes its validUntil, expire it" @19
    event "Consent expired" @19 +EVT-CONSENT-ENDED
    event "Consent terminated by the TPP" @19
    readmodel "What this TPP may access for this PSU" @20 +RM-PSU-TPP-ACCESS
    hotspot "revokedByPsu is a revocation towards the ASPSP (§14.15), and the only consent \
             screen belongs to the TPP, so this read model has no PSU-facing surface" @20 +"ask compliance" +D-09
  }

  lane "Transaction Authorisation" {
    aggregate "Authorisation" @4
    policy "Whenever a consent record is created and no further TPP data is needed, start the \
            authorisation implicitly and return scaRedirect" @4 {
      note "Implicit start, SRC-IG §4.6 and §6.1.1.1."
    }
    event "Authorisation sub-resource created" @4 {
      note "scaStatus = received (SRC-IG §14.16)."
    }
    readmodel "Redirect session behind the scaRedirect link" @5 +RM-REDIRECT-SESSION
    command "Resolve the redirect session" @5
    event "Redirect session resolved" @5
    event "Redirect session refused as unknown, expired or already used" @5
    ui "Request no longer available" @5 +SCR-CIAM-UNAVAILABLE
    event "PSU identified" @7 {
      note "scaStatus = psuIdentified, then psuAuthenticated after the login screen."
    }
    readmodel "What to ask the PSU to confirm" @8 +RM-SCA-PROMPT
    command "Record the SCA result" @10
    policy "Whenever the SCA result arrives, check it against the subject the PSU confirmed" @10
    event "SCA result bound to the confirmed subject" @10
    event "SCA result refused because it does not match what was confirmed" @10
    command "Record the consent decision" @11
    event "Consent items confirmed by the PSU" @11
    event "Consent items declined by the PSU" @11
    event "Authorisation finalised" @11
    event "Authorisation failed" @11
    readmodel "Outcome of this authorisation" @12 +RM-AUTHORISATION-OUTCOME
    readmodel "Authorisations past their SCA window" @12 +RM-SCA-DEADLINES
    policy "Whenever the SCA window closes without a result, fail the authorisation" @12
    hotspot "How long the SCA window lasts is not stated" @12 +"ask product" +Q-24
    hotspot "Whether the bank requires the authorisation confirmation call (§7.6), which adds \
             an unconfirmed state before finalised, is not decided" @11 +"ask architecture" +Q-29
  }

  lane "Identity and SCA (Transmit CIAM)" {
    system "Transmit CIAM" @6
    ui "Login screen" @6 +SCR-CIAM-LOGIN
    command "Authenticate the PSU" @6
    event "PSU authenticated by the CIAM" @6
    readmodel "Enrolled devices and their SCA methods" @7 +RM-SCA-CONTEXT
    policy "Whenever a PSU is authenticated for an authorisation, ask an enrolled device to \
            confirm" @7
    event "Enrolled device asked to confirm" @7
    event "No enrolled device found" @7
    hotspot "What a PSU with no enrolled device is offered — enrol now, or another method — \
             is not decided" @7 +"ask product" +Q-37
    ui "Continue on your enrolled device" @8 +SCR-CIAM-AWAIT-DEVICE
    ui "Outcome and return to the TPP" @12 +SCR-CIAM-OUTCOME
    hotspot "The ADR names no bank page between the login screen and the return to the TPP; \
             the waiting, outcome and unavailable pages are proposed" @8 +"ask product" +Q-18
  }

  lane "Mobile app on the enrolled device" {
    ui "OTP screen" @9 +SCR-APP-OTP
    command "Confirm identity with the chosen method" @9
    event "Identity confirmed on the enrolled device" @9
    event "Identity confirmation rejected by the PSU" @9
    ui "Consent confirmation panel" @11 +SCR-APP-CONSENT-CONFIRM
    command "Confirm the items of the consent" @11
    hotspot "Whether the PSU may deselect accounts or access types on the panel, and what \
             happens when the consent names an account the PSU does not hold, is not \
             decided" @11 +"ask product" +Q-34
  }

  lane "Account Information" {
    aggregate "Account Resource Map" @15
    aggregate "Daily Access Allowance" @16
    readmodel "May this TPP read this account now?" @15 +RM-ACCESS-DECISION
    policy "Whenever account data is requested, decide it against the consent before reading \
            anything from core banking" @15
    event "Read refused because the consent is not valid" @15
    event "Account list delivered" @16
    event "Account data delivered to the TPP" @17 +EVT-ACCOUNT-DATA-DELIVERED
    policy "Whenever a read happens without PSU involvement, count it against frequencyPerDay" @17
    event "Daily access limit reached" @17 {
      note "HTTP 429 ACCESS_EXCEEDED (SRC-IG §14.11.3)."
    }
    hotspot "The bank must refuse a read the moment a consent is revoked, but the master record \
             is at Finologee; how quickly a revocation reaches the enforcing projection is \
             undecided" @17 +"ask architecture" +D-01
  }

  lane "Core banking (DCP)" {
    system "DCP Digital Client Platform" @16
    command "Read accounts, balances and transactions" @16
    event "Core banking answered" @16
    hotspot "The read needs a PingFederate token, and who exchanges the CIAM token for it is \
             not decided" @16 +"ask iam" +D-02
  }
}
