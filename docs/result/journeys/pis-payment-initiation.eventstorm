// Process model — single SEPA credit transfer, from the PISP's request to a final status.
// PROPOSAL generated by AI. Sources: SRC-IG §5.1, §5.3.1, §5.4, §4.14.1, §14.13, §14.16;
// SRC-ADR (CIAM login in the browser, then confirmation on the enrolled device).
// The wall is deliberately honest about one hole: the ADR names a consent confirmation panel and
// nothing for a payment, so the card where the PSU sees the amount and payee is a hotspot rather
// than a ui card. See Q-17 and C-09.
eventstorm "PIS single payment initiation" {

  lane "TPP (PISP)" {
    actor "PISP" @1
    command "Initiate a SEPA credit transfer" @1
    event "Payment initiation submitted" @2
    command "Read the payment status" @15
    command "Read the payment initiation" @15
  }

  lane "Payment Initiation" {
    aggregate "Payment Initiation" @2
    policy "Whenever a payment initiation arrives, validate the payment product, the amount and \
            the accounts before creating anything" @2
    event "Payment initiation refused as malformed" @2
    hotspot "Whether Verification of Payee runs before authorisation, and what the PSU is asked \
             to confirm when the name does not match, is not decided" @2 +"ask compliance" +Q-39
    event "Payment initiation received" @3 {
      note "transactionStatus = RCVD (SRC-IG §5.3.1)."
    }
    readmodel "Amount, payee and debtor account of this payment" @7 +RM-PAYMENT-APPROVAL
    policy "Whenever an authorisation for a payment is finalised, submit the payment to core \
            banking" @12
    event "Payment authorised by the PSU" @12 +EVT-PAYMENT-AUTHORISED
    event "Payment accepted after technical checks" @13 {
      note "transactionStatus = ACTC (SRC-IG §4.14.1)."
    }
    event "Payment rejected" @14 {
      note "transactionStatus = RJCT."
    }
    policy "Whenever the SCA window closes without a finalised authorisation, reject the \
            payment" @14
    readmodel "Authorisations past their SCA window" @14 +RM-SCA-DEADLINES
    event "Payment reached its final status" @15 +EVT-PAYMENT-FINAL-STATUS-REACHED
    hotspot "Which end status the bank can report depends on whether DCP books in batch or in \
             real time, which nobody has stated" @15 +"ask core banking" +Q-31
  }

  lane "Transaction Authorisation" {
    aggregate "Authorisation" @4
    policy "Whenever a payment initiation is received and no further TPP data is needed, start \
            the authorisation implicitly and return scaRedirect" @4
    event "Authorisation sub-resource created" @4
    readmodel "Redirect session behind the scaRedirect link" @5 +RM-REDIRECT-SESSION
    event "Redirect session resolved" @5
    ui "Request no longer available" @5 +SCR-CIAM-UNAVAILABLE
    readmodel "What to ask the PSU to confirm" @8 +RM-SCA-PROMPT
    command "Record the SCA result" @11
    policy "Whenever the SCA result arrives, check it against the subject the PSU confirmed" @11
    event "SCA result bound to the confirmed subject" @11
    event "Authorisation finalised" @11
    event "Authorisation failed" @11
    readmodel "Outcome of this authorisation" @12 +RM-AUTHORISATION-OUTCOME
    hotspot "Dynamic linking requires the SCA to be bound to the amount and the payee. The \
             gateway can compute that binding, but nothing shows those values to the PSU, so \
             there is nothing to bind to" @7 +"ask compliance" +Q-17
  }

  lane "Identity and SCA (Transmit CIAM)" {
    system "Transmit CIAM" @6
    ui "Login screen" @6 +SCR-CIAM-LOGIN
    event "PSU authenticated by the CIAM" @6
    readmodel "Enrolled devices and their SCA methods" @7 +RM-SCA-CONTEXT
    event "Enrolled device asked to confirm" @8
    ui "Continue on your enrolled device" @9 +SCR-CIAM-AWAIT-DEVICE
    ui "Outcome and return to the TPP" @12 +SCR-CIAM-OUTCOME
    hotspot "Redirect is drawn, but nothing in the payment journey needs the browser after the \
             login screen; the decoupled approach (§5.1.7) would drop it entirely" @9 +"ask architecture" +Q-09
  }

  lane "Mobile app on the enrolled device" {
    ui "OTP screen" @10 +SCR-APP-OTP
    ui "Biometric screen" @10 +SCR-APP-BIOMETRIC
    command "Confirm identity with the chosen method" @10
    event "Identity confirmed on the enrolled device" @10
    event "Identity confirmation rejected by the PSU" @10
    hotspot "There is no payment confirmation panel. The PSU confirms identity and is never \
             shown what is being paid" @10 +"ask product" +Q-17
    hotspot "Whether fees and currency conversion are shown before the PSU confirms is not \
             decided" @10 +"ask compliance" +Q-46
  }

  lane "Core banking (DCP)" {
    system "DCP Digital Client Platform" @13
    command "Submit the payment for execution" @13
    event "Payment accepted by core banking" @13
    event "Payment refused by core banking" @14
    event "Payment booked on the debtor account" @14
    hotspot "The submission needs a PingFederate token and DCP's payment interface is \
             unknown" @13 +"ask core banking" +Q-05
  }
}
