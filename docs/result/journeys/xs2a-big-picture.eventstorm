// Big Picture — access to account through a TPP (PSD2 XS2A)
// PROPOSAL generated by AI. Not a workshop record: no room has seen this wall.
// Sources: SRC-IG (NextGenPSD2 IG v1.3.16) and SRC-ADR (docs/context/adr.md @ 7c44c2d) — see
// problem-analysis.md. Each hotspot carries the ledger id of what is unsettled: +Q-xx for an
// open question, +D-xx for a decision nobody has taken
// (docs/traceability/questions-and-assumptions.md, docs/system/README.md §4).
// Pivotal events carry their stable id as a tag (+EVT-...); they cut the story-map backbone.
eventstorm "PSD2 access to account — Big Picture" {

  lane "Account holder (PSU)" {
    actor "Account holder" @1
    event "Access to accounts granted on the TPP's consent screen" @1
    event "PSU redirected to the bank" @7
    event "PSU returned to the TPP" @11
    event "Payment requested at the TPP" @17
    event "PSU told the payment outcome" @23
  }

  lane "TPP (AISP / PISP)" {
    actor "AISP or PISP" @1
    ui "Consent screen, managed by the TPP" @1 +SCR-TPP-CONSENT
    event "TPP certificate presented" @2
    event "Consent requested" @4
    event "Consent status read" @11
    ui "Result shown to the PSU by the TPP" @11 +SCR-TPP-RESULT
    event "Account list read" @12
    event "Balances and transactions read" @13
    event "Consent deleted by the TPP" @15
    hotspot "The TPP only learns of a revocation on its next read, and the standard names \
             no message code for a revoked consent" @16 +"ask architecture" +Q-22
    event "Payment initiation submitted" @18
    event "Payment status read" @23
    event "Payment cancellation requested" @24 +"outside MVP"
    event "Funds confirmation requested" @25 +"outside MVP"
  }

  lane "PSD2 gateway (Finologee)" {
    system "Finologee PSD2 gateway" @2
    event "TPP identified from its certificate" @3 +pivotal +EVT-TPP-IDENTIFIED {
      note "QWAC over mTLS carries the TPP roles (SRC-IG §3, §4.9). The legal owner of the \
            certificate, not the brand in OU, owns the consents it creates."
    }
    event "TPP refused because its certificate lacks the role" @3
    hotspot "Nobody has decided whether Finologee or the bank validates the QWAC, the TPP \
             roles and the NCA register status" @3 +"ask architecture" +Q-08
    context "TPP Access" @3
    event "Consent record created at the gateway" @4 {
      note "SRC-ADR: Finologee manages the consent state. The record the bank enforces against \
            is a projection of this one (A-16)."
    }
    hotspot "Finologee masters the consent state, but SRC-IG holds the ASPSP answerable for \
             consentStatus, for the access decision on every read and for ACCESS_EXCEEDED. \
             Which copy decides a read is not stated" @4 +"ask architecture" +D-01
    event "Consent record revoked or expired at the gateway" @15
    hotspot "Whether the gateway publishes revocation and expiry as events the bank can \
             subscribe to, and whether the bank can export the audit trail it owes \
             supervisors, is unknown" @15 +"ask architecture" +Q-45
  }

  lane "ASPSP XS2A gateway (bank)" {
    event "Consent received" @5 {
      note "consentStatus = received (SRC-IG §14.15)."
    }
    context "Consent" @5
    event "SCA approach chosen for the request" @6
    hotspot "Which SCA approaches the bank offers is not decided. Redirect is drawn, but every \
             confirmation already happens on the enrolled device, which is the decoupled \
             approach (§5.1.7)" @6 +"ask architecture" +"ask product" +Q-09
    opportunity "Confirm the consent item by item on the enrolled device, which is exactly what \
                 the Detailed Consent model asks an ASPSP to display during SCA" @6
    context "Transaction Authorisation" @9
    event "Consent authorised by the PSU" @10 +pivotal +EVT-CONSENT-AUTHORISED {
      note "consentStatus = valid; the authorisation sub-resource reaches scaStatus = finalised."
    }
    event "Former recurring consent of the same TPP ended" @10
    hotspot "The standard says the former recurring consent 'expires' (§6.3.1.1) and also that \
             'terminatedByTpp' applies to that side effect (§4.14.2)" @10 +"ask compliance" +Q-20
    event "Consent authorisation failed" @10
    context "Account Information" @12
    event "Account list delivered" @12
    event "Account data delivered to the TPP" @13 +pivotal +EVT-ACCOUNT-DATA-DELIVERED
    event "Daily access limit reached" @14 {
      note "More reads without PSU involvement than frequencyPerDay: HTTP 429 ACCESS_EXCEEDED \
            (SRC-IG §14.11.3)."
    }
    event "Consent expired" @15
    event "Consent ended" @16 +pivotal +EVT-CONSENT-ENDED {
      note "One of expired, revokedByPsu, terminatedByTpp (SRC-IG §4.14.2). As the context is \
            drawn, revokedByPsu has no way in: see the hotspot beside this card."
    }
    hotspot "The TPP manages the consent screen where the PSU 'grants or revokes', but \
             revokedByPsu is a revocation towards the ASPSP (§14.15) and no bank surface \
             offers one" @16 +"ask compliance" +D-09
    context "Payment Initiation" @18
    event "Payment initiation received" @18 {
      note "transactionStatus = RCVD (SRC-IG §5.3.1 example)."
    }
    hotspot "Whether Verification of Payee runs before authorisation, and with which \
             confirmation step, is not decided; [oFA-VOP] was not supplied" @18 +"ask compliance" +Q-39
    event "Payment authorised by the PSU" @20 +pivotal +EVT-PAYMENT-AUTHORISED
    event "Payment authorisation failed or timed out" @20 {
      note "If SCA is not completed in time the payment must become RJCT (SRC-IG §5.4)."
    }
    event "Payment accepted after technical checks" @21 {
      note "transactionStatus = ACTC (SRC-IG §4.14.1)."
    }
    event "Payment rejected" @22
    hotspot "Which end status the bank reports (ACTC, ACCP, ACSC) depends on DCP's booking \
             behaviour, which nobody has stated" @22 +"ask core banking" +Q-31
    event "Payment reached its final status" @23 +pivotal +EVT-PAYMENT-FINAL-STATUS-REACHED
    event "Payment cancelled" @24 +"outside MVP"
    hotspot "Cancellation is optional in the standard; nobody has said whether the bank offers \
             it or requires a cancellation authorisation" @24 +"ask product" +Q-40
    event "Funds availability answered" @25 +"outside MVP"
    hotspot "Funds confirmation is Mandatory (§4.11.6) but its PIIS consent is defined outside \
             the supplied document" @25 +"ask compliance" +Q-21
  }

  lane "Identity and SCA (Transmit CIAM, PingFederate IDP)" {
    system "Transmit CIAM" @7
    system "PingFederate IDP" @7
    context "Customer Identity and SCA" @7
    ui "Login screen in the web browser" @7 +SCR-CIAM-LOGIN
    event "PSU authenticated by the CIAM" @7 {
      note "SRC-ADR: the login screen authenticates the PSU against the CIAM, in the browser."
    }
    hotspot "The SCA journey is described as one journey managed by the mobile app and \
             presented on the enrolled device, yet its first step is a browser login screen" @7 +"ask iam" +Q-12
    event "SCA requested on an enrolled device" @8 {
      note "The CIAM asks the app to present the OTP, QR or biometric screen (SRC-ADR). How it \
            reaches the device is unknown (Q-15)."
    }
    hotspot "Which factor category each step contributes, and whether the browser login and \
             the device step are independent under [EBA-RTS], is unknown" @8 +"ask iam" +Q-14
    event "SCA result bound to what the PSU confirmed" @9
    hotspot "Transmit and PingFederate are both token issuers; who signs the assertion the \
             ASPSP gateway trusts is not decided" @9 +"ask iam" +Q-16
    event "Transmit token exchanged for a PingFederate token" @12 {
      note "SRC-ADR: DCP services require a PingFederate token, so an exchange is required."
    }
    hotspot "Whether PingFederate supports the exchange the ADR requires, who calls it and \
             what it costs on the hot path is unknown" @12 +"ask iam" +D-02
  }

  lane "Mobile app on the enrolled device" {
    context "Mobile Banking" @8
    ui "OTP screen" @8 +SCR-APP-OTP
    ui "QR code screen" @8 +SCR-APP-QR
    ui "Biometric screen" @8 +SCR-APP-BIOMETRIC
    event "Identity confirmed on the enrolled device" @8 {
      note "One of OTP, QR code or biometrics (SRC-ADR). Device enrolment is a precondition \
            (A-14, Q-36)."
    }
    ui "Consent confirmation panel" @9 +SCR-APP-CONSENT-CONFIRM
    readmodel "What this TPP is asking for" @9 +RM-CONSENT-APPROVAL
    event "Items of the consent confirmed on the enrolled device" @9
    readmodel "Amount and payee of the payment" @19 +RM-PAYMENT-APPROVAL
    hotspot "The device journey ends in a consent confirmation panel and the ADR names nothing \
             for a payment, so no surface shows the amount and payee that dynamic linking \
             requires" @19 +"ask compliance" +Q-17
  }

  lane "Core banking (DCP)" {
    system "DCP Digital Client Platform" @12
    context "Core Banking" @12
    hotspot "DCP is named as the core banking platform and requires a PingFederate token, but \
             no interface for accounts, balances, transactions or payments is known" @12 +"ask core banking" +Q-05
    event "Payment booked on the debtor account" @22
  }
}
