// EXMAP-PIS-STATUS — PROPOSAL generated by AI. Not yet discussed by a Three Amigos session.
// Sources: SRC-IG §5.4 (Get Transaction Status), §4.14.1 (status information for PIS),
// §14.13 (ISO 20022 transaction status), §4.11 (resource ownership).
examplemap "Read the payment status" {
  delivery "Walking skeleton" release
  delivery "MVP" release

  story "Read the payment status" @"Walking skeleton" +STORY-PIS-STATUS {
    as   "PISP"
    want "to read the ISO 20022 transaction status of the payment"
    so   "I can tell the merchant and the PSU what happened"
    question "Which end status does the bank report once DCP has the payment — ACTC, ACCP, ACFC \
              or ACSC? It depends on whether DCP books in batch or in real time" +"ask core banking" +Q-31
  }

  rule "The status is one of the ISO 20022 codes the specification lists" +R-PST-01 {
    note "SRC-IG §14.13. The flow diagrams of §5.1.8-5.1.10 use ACCT and REJT, which are not in \
          that table; the code list wins (C-03, W-SPEC-01)."
    example "A freshly created payment reports RCVD" @"Walking skeleton" {
      given "a payment initiation created one second ago"
      when  "the PISP reads the payment status"
      then  "transactionStatus is RCVD"
    }
    example "A payment accepted after technical validation reports ACTC" @"MVP" {
      given "a payment whose authorisation is finalised and which passed the bank's checks"
      when  "the PISP reads the payment status"
      then  "transactionStatus is ACTC"
    }
  }

  rule "Only the TPP that created the payment may read its status" +R-PST-02 {
    note "SRC-IG §4.11."
    example "Another TPP reading the status learns nothing about the payment" @"MVP" +edge-case {
      given "payment 1234-wertiq-983 created by PSDES-BDE-3DFD21"
      given "a second TPP PSDFR-ACPR-12345 with the PISP role"
      when  "the second TPP reads the status of 1234-wertiq-983"
      then  "the transaction status is not disclosed"
    }
  }

  rule "A payment whose SCA window closes without confirmation is rejected" +R-PST-03 {
    note "SRC-IG §5.4: if SCA is not completed the payment has to be rejected."
    example "An unconfirmed payment reports RJCT after the window" @"MVP" +edge-case {
      given "a payment whose PSU never confirmed on the enrolled device"
      given "an SCA window that has closed"
      when  "the PISP reads the payment status"
      then  "transactionStatus is RJCT"
    }
    question "How long is that window?" +"ask product" +Q-24
  }

  rule "A final status does not change again" +R-PST-04 {
    note "SRC-IG §14.13: RJCT and CANC are end states; ACSC reports completed settlement."
    example "A rejected payment stays rejected" @"MVP" {
      given "a payment at RJCT"
      when  "the PISP reads the status an hour later"
      then  "transactionStatus is RJCT"
    }
    example "A rejected payment cannot be authorised afterwards" @"MVP" +edge-case {
      given "a payment at RJCT"
      when  "an SCA result arrives for its authorisation"
      then  "the payment stays at RJCT"
    }
  }
}
