// EXMAP-CONSENT-DEDICATED — PROPOSAL generated by AI. Not yet discussed by a Three Amigos session.
// Sources: SRC-IG §6.3.1.1, §6 "Consent Models", §9, §14.11.3, §14.17. IBANs are the
// specification's own test data (A-09).
examplemap "Request a consent on dedicated accounts" {
  delivery "Walking skeleton" release
  delivery "MVP" release

  story "Request a consent on dedicated accounts" @"Walking skeleton" +STORY-CONSENT-DEDICATED {
    as   "AISP"
    want "to ask for access to named accounts, with the access types, validity and daily frequency I need"
    so   "my PSU is asked to confirm exactly the access my service uses"
    question "Which HTTP code and message code refuse a malformed consent definition: \
              400 FORMAT_ERROR or 401 CONSENT_INVALID?" +"ask architecture" +Q-19
    question "Finologee masters the consent record. Is the resource created at the gateway and \
              projected to the bank, or created by the bank and pushed to the gateway?" +"ask architecture" +D-01
  }

  rule "Every access list used names at least one account" +R-CNS-01 {
    note "SRC-IG §6.3.1.1 note and §14.17: an empty array asks for a bank-offered consent, and \
          then every used list must be empty."
    example "Balances and transactions on one IBAN are accepted" @"Walking skeleton" {
      given "access.balances = [DE40100100103307118608]"
      given "access.transactions = [DE40100100103307118608]"
      given "recurringIndicator true, validUntil 2026-11-01, frequencyPerDay 4"
      when  "the AISP posts the consent"
      then  "the response is 201 Created with consentStatus received"
      then  "the response carries a consentId and a Location header"
    }
    example "A named balances list next to an empty transactions list is refused" @"MVP" +edge-case {
      given "access.balances = [DE40100100103307118608]"
      given "access.transactions = []"
      when  "the AISP posts the consent"
      then  "no consent resource is created"
    }
    question "All lists empty asks for a bank-offered consent, which is not proposed for the \
              MVP — which refusal does the TPP get?" +"ask product" +Q-10
  }

  rule "frequencyPerDay is at least 1, and at most 4 unless bilaterally agreed" +R-CNS-03 {
    note "SRC-IG §6.3.1.1 frequencyPerDay."
    example "Four reads a day are accepted" @"Walking skeleton" {
      given "a recurring consent request with frequencyPerDay 4"
      when  "the AISP posts the consent"
      then  "the response is 201 Created"
    }
    example "Five reads a day are refused without a bilateral agreement" @"MVP" +edge-case {
      given "a recurring consent request with frequencyPerDay 5"
      given "no bilateral agreement with the TPP"
      when  "the AISP posts the consent"
      then  "no consent resource is created"
    }
    example "Zero reads a day are refused" @"MVP" +edge-case {
      given "a consent request with frequencyPerDay 0"
      when  "the AISP posts the consent"
      then  "no consent resource is created"
    }
    question "Will the bank offer any bilateral agreement above four reads a day?" +"ask product" +Q-11
  }

  rule "A one-off consent reads once" +R-CNS-04 {
    note "SRC-IG §6.3.1.1: 'For a one-off access, this attribute is set to 1'; §6: a one-off \
          access may be denied after a first read or after an ASPSP-defined time, 20 minutes in \
          the specification's example."
    example "A one-off consent with frequencyPerDay 1 is accepted" @"MVP" {
      given "recurringIndicator false and frequencyPerDay 1"
      when  "the AISP posts the consent"
      then  "the response is 201 Created"
    }
    question "A one-off consent sent with frequencyPerDay 4: refuse it, or store 1?" +"ask architecture" +Q-19
    question "How long after authorisation is a one-off consent usable?" +"ask product" +Q-13
  }

  rule "validUntil is what the bank grants; 9999-12-31 asks for the maximum" +R-CNS-05 {
    note "SRC-IG §6.3.1.1 validUntil: future dates might get adjusted by the ASPSP, and the \
          adjusted date is what the GET Consent Request returns."
    example "A request for the maximum validity shows the bank's own end date" @"MVP" {
      given "a recurring consent request with validUntil 9999-12-31"
      when  "the consent is authorised and the AISP reads GET /v1/consents/123cons456"
      then  "validUntil is the bank's maximum end date, not 9999-12-31"
    }
    example "The confirmation panel shows the granted date, not the requested one" @"MVP" +edge-case {
      given "a consent requesting validUntil 9999-12-31 which the bank shortens to 2027-03-31"
      when  "the consent confirmation panel is presented on the enrolled device"
      then  "the panel shows 2027-03-31"
    }
    question "What is the bank's maximum consent validity? [EBA-FR] is cited but was not \
              supplied" +"ask compliance" +Q-11
  }

  rule "A combined AIS and PIS session is refused while sessions are not offered" +R-CNS-07 {
    note "SRC-IG §9 and §14.11.3 SESSIONS_NOT_SUPPORTED. Assumes sessions are out of the MVP (A-11)."
    example "combinedServiceIndicator true is refused" @"MVP" +edge-case {
      given "a consent request with combinedServiceIndicator true"
      when  "the AISP posts the consent"
      then  "the response is 400 with code SESSIONS_NOT_SUPPORTED"
    }
  }
}
