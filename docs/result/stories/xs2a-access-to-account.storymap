// Story map — PSD2 XS2A access to account
// PROPOSAL generated by AI. The two delivery bands are *proposed* slices, not agreed ones:
// product owns release commitments (docs/ai/20-review-and-delivery-policy.md).
// Backbone = the runs between the pivotal events of docs/journeys/xs2a-big-picture.eventstorm;
// each activity carries the pivotal event that closes it as a tag (+EVT-...).
// Stable story ids are tags (+STORY-...). No #ticket and no ~status is written: the ticketing
// system owns both, and none has been issued.
// Two stories are unscheduled for a reason worth reading before the plan is approved:
// STORY-PSU-REVOKE, because no bank surface offers a revocation towards the ASPSP (D-09), and
// STORY-PIS-PAYMENT-CONFIRM, because nothing shows a payment's amount and payee (Q-17).
storymap "PSD2 XS2A access to account" {

  delivery "Walking skeleton" release {
    note "WS-01 — docs/delivery/walking-skeleton.md. Proves the technical path end to end; \
          limited business value."
  }
  delivery "MVP" release {
    note "MVP-01 — docs/delivery/mvp.md. Smallest coherent slice covering the mandatory AIS and \
          single-payment PIS endpoints of SRC-IG §4.11, except funds confirmation (Q-21)."
  }

  activity "Reach the bank as a licensed TPP" +EVT-TPP-IDENTIFIED +ACTV-REACH-BANK {
    persona "AISP"
    persona "PISP"

    step "Connect with a qualified certificate" {
      story "Identify the TPP from its certificate" @"Walking skeleton" +skeleton +STORY-TPP-IDENTIFY {
        as   "AISP"
        want "the bank to recognise me and my PSD2 roles from my QWAC on the TLS connection"
        so   "I can act for my PSUs under my own licence without a separate bank-specific login"
        note "SRC-IG §3, §4.9. Example map: EXMAP-TPP-IDENTIFY."
      }
      story "Refuse services the TPP's roles do not cover" @"MVP" +STORY-TPP-ROLE-CHECK {
        as   "PISP"
        want "a ROLE_INVALID answer when I call a service my certificate does not cover"
        so   "I can tell a licensing problem apart from a technical fault"
      }
      story "Keep each TPP's resources to itself" @"MVP" +STORY-TPP-RESOURCE-ISOLATION {
        as   "AISP"
        want "no other TPP to read or change the consents and payments I created"
        so   "my PSUs' data cannot be reached through another provider's certificate"
        note "SRC-IG §4.11: methods may only apply to resources created by the same TPP."
      }
    }
    step "Sign requests" {
      story "Verify application-layer signatures" +STORY-TPP-SIGNATURE +"ask architecture" {
        as   "PISP"
        want "to know whether the bank requires a QSealC signature on my requests"
        so   "I sign when it is required and do not waste effort when it is not"
        note "Optional for the ASPSP (SRC-IG §4.2). Q-08."
      }
    }
    step "Learn what this bank supports" {
      story "Publish the bank's XS2A profile" @"MVP" +STORY-XS2A-PROFILE {
        as   "AISP"
        want "to read which payment products, SCA approaches, consent models and options this bank supports"
        so   "I can integrate without trial and error"
        note "The specification defers many choices to 'the ASPSP documentation'. \
              Seed: docs/system/api/openapi/xs2a-profile.yaml."
      }
    }
  }

  activity "Grant account access" +EVT-CONSENT-AUTHORISED +ACTV-GRANT-ACCESS {
    persona "Account holder"
    persona "AISP"

    step "Ask for access" {
      story "Request a consent on dedicated accounts" @"Walking skeleton" +skeleton +STORY-CONSENT-DEDICATED {
        as   "AISP"
        want "to ask for access to named accounts, with the access types, validity and daily frequency I need"
        so   "my PSU is asked to confirm exactly the access my service uses"
        note "Mandatory in SRC-IG §4.11.4. Example map: EXMAP-CONSENT-DEDICATED."
      }
      story "Request a consent on the list of available accounts" +STORY-CONSENT-AVAILABLE-ACCOUNTS +"ask product" {
        as   "AISP"
        want "to ask only for the list of my PSU's available accounts"
        so   "I can let the PSU choose accounts before asking for detailed access"
        note "Optional (SRC-IG §6.3.1.2). Q-10."
      }
      story "Let the bank choose the accounts with the PSU" +STORY-CONSENT-BANK-OFFERED +"ask product" {
        as   "AISP"
        want "to send empty access lists and let the PSU pick accounts at the bank"
        so   "I do not need to know account numbers in advance"
        note "Optional (SRC-IG §6.3.1.2). Q-10. Note that the bank would then have to offer a \
              selection surface, which the ADR does not name."
      }
      story "Request access to all accounts for all AIS" +STORY-CONSENT-GLOBAL +"ask product" {
        as   "AISP"
        want "to ask for allPsd2 access to all accounts"
        so   "a PSU who wants full aggregation confirms once"
        note "Optional (SRC-IG §6.3.1.2). Q-10."
      }
      story "Include the account owner name" +STORY-CONSENT-OWNER-NAME +"ask product" {
        as   "AISP"
        want "to ask for the owner name of the accounts"
        so   "I can verify the account belongs to my PSU"
        note "SRC-IG §6 'Account Owner Name Delivery', §14.18. Q-28."
      }
    }

    step "Authenticate and confirm at the bank" {
      story "Log in at the bank and confirm the consent on my enrolled device" @"Walking skeleton" +skeleton +STORY-SCA-DEVICE {
        as   "Account holder"
        want "to log in on the bank's login screen and then confirm the request on my enrolled device"
        so   "I never give my bank credentials to the TPP, and only my own device can complete the approval"
        note "SRC-ADR SCA journey: CIAM login in the browser, then OTP, QR code or biometrics, \
              then the consent confirmation panel. Example map: EXMAP-SCA-DEVICE."
      }
      story "See exactly what a TPP will access before I confirm" @"MVP" +STORY-SCA-CONSENT-DETAILS {
        as   "Account holder"
        want "to see the TPP's name, the accounts, the kind of access, the end date and how often it may read"
        so   "I confirm only what I understand"
        note "SRC-IG §6 'Detailed Consent': the ASPSP displays the consent details during SCA — \
              which is what the consent confirmation panel is (A-15). H-02."
      }
      story "Choose how I confirm on my device" @"MVP" +STORY-SCA-METHOD-CHOICE {
        as   "Account holder"
        want "to confirm with the method that suits me — a one-time password, a QR code or biometrics"
        so   "I am not blocked when one method is unavailable to me"
        note "SRC-ADR lists the three methods. Which are offered and in which order is a CIAM \
              configuration (Q-14)."
      }
      story "See the outcome and get back to the TPP" @"MVP" +STORY-SCA-OUTCOME +"ask product" {
        as   "Account holder"
        want "to see whether my confirmation worked and be taken back to the TPP in one step"
        so   "I know what I agreed to and can finish what I started at the TPP"
        note "SCR-CIAM-OUTCOME. The ADR names no such page, so it is proposed (Q-18)."
      }
      story "Be told when an approval request is no longer valid" @"MVP" +STORY-SCA-REQUEST-UNAVAILABLE {
        as   "Account holder"
        want "a clear page when the link I followed has expired or was already used"
        so   "I do not retry a request that cannot succeed"
        note "SCR-CIAM-UNAVAILABLE. Q-18."
      }
      story "Offer something to a PSU with no enrolled device" +STORY-SCA-NO-DEVICE +"ask product" {
        as   "Account holder"
        want "a way forward when I have no device enrolled with the bank"
        so   "I am not stuck between the TPP and a bank that cannot reach me"
        note "Q-37. Enrolment itself is STORY-DEVICE-ENROLMENT."
      }
      story "Enrol a device for strong authentication" +STORY-DEVICE-ENROLMENT +"ask iam" {
        as   "Account holder"
        want "to register my phone with the bank so it can be used to confirm"
        so   "TPP requests can reach me at all"
        note "A bank-wide CIAM capability assumed to exist (A-14, Q-36)."
      }
      story "Offer the decoupled SCA approach" +STORY-SCA-DECOUPLED +"ask architecture" {
        as   "AISP"
        want "the bank to push the confirmation to the PSU's app without redirecting the browser"
        so   "my PSU stays in my application throughout"
        note "SRC-IG §5.1.7. Everything the PSU confirms already happens on the device, so this \
              is the shape the ADR is closest to. D-03, Q-09."
      }
      story "Offer the embedded SCA approach" +STORY-SCA-EMBEDDED +"ask architecture" {
        as   "AISP"
        want "to carry the SCA dialogue inside my own application"
        so   "my PSU never leaves my user interface"
        note "SRC-IG §5.1.8-5.1.10. Not compatible with the ADR's device journey as written. D-03."
      }
      story "Confirm the authorisation with a confirmation code" +STORY-SCA-CONFIRMATION +"ask architecture" {
        as   "AISP"
        want "to post the confirmation code the bank gave my PSU's browser"
        so   "the bank can rule out session fixation on the redirect"
        note "SRC-IG §7.6. Q-29."
      }
      story "Authorise with several PSUs" +STORY-SCA-MULTILEVEL +"ask product" {
        as   "AISP"
        want "a consent to be authorised by every PSU the account requires"
        so   "corporate accounts can be reached"
        note "SRC-IG §6.3.4. Q-41, A-05."
      }
    }

    step "Follow the authorisation" {
      story "Read the consent status" @"Walking skeleton" +STORY-CONSENT-STATUS {
        as   "AISP"
        want "to read whether the consent has become valid"
        so   "I know when I may start reading account data"
        note "SRC-IG §6.3.2."
      }
      story "Read the consent as the bank stored it" @"MVP" +STORY-CONSENT-READ {
        as   "AISP"
        want "to read the access, the validity and the frequency the bank actually granted"
        so   "I request only what was granted and show my PSU the truth"
        note "SRC-IG §6.3.3. The bank may shorten validUntil (R-CNS-05)."
      }
      story "Follow the SCA status of an authorisation" @"MVP" +STORY-SCA-STATUS {
        as   "AISP"
        want "to read the scaStatus of the authorisation sub-resource"
        so   "I can tell my PSU whether to keep waiting"
        note "SRC-IG §7.4, §7.5, §14.16."
      }
    }
  }

  activity "Use the account data" +EVT-ACCOUNT-DATA-DELIVERED +ACTV-USE-DATA {
    persona "Account holder"
    persona "AISP"

    step "Read accounts" {
      story "Read the list of accessible accounts" @"Walking skeleton" +skeleton +STORY-READ-ACCOUNT-LIST {
        as   "AISP"
        want "to read the accounts my consent covers, with their resource identifiers"
        so   "I can address balances and transactions afterwards"
        note "SRC-IG §6.5.1. Example map: EXMAP-READ-ACCOUNT-LIST."
      }
      story "Read the details of one account" @"MVP" +STORY-READ-ACCOUNT-DETAILS {
        as   "AISP"
        want "to read one account's details by its resource identifier"
        so   "I can show my PSU the account they connected"
        note "SRC-IG §6.5.2."
      }
      story "Read card accounts" +STORY-READ-CARD-ACCOUNTS {
        as   "AISP"
        want "to read card accounts and their transactions"
        so   "I can aggregate card spending as well as payment accounts"
        note "SRC-IG §6.6. Separate endpoints because the data is separated in the backend."
      }
    }
    step "Read money" {
      story "Read balances" @"MVP" +STORY-READ-BALANCES {
        as   "AISP"
        want "to read the balances my consent covers"
        so   "I can show my PSU what they have"
        note "SRC-IG §6.5.3."
      }
      story "Read transactions" @"MVP" +STORY-READ-TRANSACTIONS {
        as   "AISP"
        want "to read booked and pending transactions for a period"
        so   "I can categorise my PSU's spending"
        note "SRC-IG §6.5.4."
      }
      story "Read the details of one transaction" +STORY-READ-TRANSACTION-DETAILS {
        as   "AISP"
        want "to read one transaction in full"
        so   "I can explain an entry my PSU asks about"
        note "SRC-IG §6.5.5."
      }
    }
    step "Stay within what was granted" {
      story "Refuse reads beyond the agreed daily frequency" @"MVP" +STORY-ENFORCE-FREQUENCY {
        as   "Account holder"
        want "the bank to refuse a TPP that reads my data more often than I agreed"
        so   "the limit I confirmed means something"
        note "SRC-IG §6, §14.11.3 ACCESS_EXCEEDED. Example map: EXMAP-ENFORCE-FREQUENCY."
      }
    }
    step "Answer a funds request" {
      story "Answer a confirmation of funds request" +STORY-PIIS-CONFIRM-FUNDS +"ask compliance" {
        as   "AISP"
        want "the bank to answer whether funds are available for a card payment"
        so   "a card issuer can decide an authorisation"
        note "Mandatory endpoint (SRC-IG §4.11.6) whose PIIS consent is defined outside the \
              supplied document. Q-21, C-02. A PIISP journey, not modelled here."
      }
    }
  }

  activity "End the access" +EVT-CONSENT-ENDED +ACTV-END-ACCESS {
    persona "Account holder"
    persona "AISP"

    step "The TPP ends it" {
      story "Delete the consent" @"Walking skeleton" +skeleton +STORY-CONSENT-DELETE {
        as   "AISP"
        want "to delete a consent my PSU no longer wants"
        so   "the access stops and my PSU sees that it stopped"
        note "SRC-IG §6.4; consentStatus becomes terminatedByTpp. Example map: EXMAP-CONSENT-END."
      }
    }
    step "Time ends it" {
      story "Expire a consent when its validity runs out" @"MVP" +STORY-CONSENT-EXPIRY {
        as   "Account holder"
        want "access to stop by itself on the date I confirmed"
        so   "I do not have to remember to withdraw it"
        note "SRC-IG §4.14.2, §14.15."
      }
    }
    step "The PSU ends it at the bank" {
      story "Withdraw a TPP's access at the bank" +STORY-PSU-REVOKE +"ask compliance" {
        as   "Account holder"
        want "to withdraw a provider's access from the bank itself, not only from the provider"
        so   "I can stop access even when I no longer trust or no longer use that provider"
        note "UNSCHEDULED ON PURPOSE. consentStatus revokedByPsu is defined as a revocation \
              towards the ASPSP (SRC-IG §14.15), and SRC-ADR gives the only consent screen to \
              the TPP. No bank surface exists to build this on. D-09, C-07, H-05."
      }
      story "Export the consent audit trail" +STORY-CONSENT-AUDIT +"ask compliance" {
        as   "Account holder"
        want "the bank to be able to show who accessed what and when"
        so   "a dispute about my account data can be settled"
        note "SRC-ADR names auditing as part of consent lifecycle management, but Finologee \
              masters the record. Q-45."
      }
    }
  }

  activity "Authorise a payment" +EVT-PAYMENT-AUTHORISED +ACTV-AUTHORISE-PAYMENT {
    persona "Account holder"
    persona "PISP"

    step "Initiate" {
      story "Initiate a SEPA credit transfer" @"Walking skeleton" +skeleton +STORY-PIS-INITIATE-SCT {
        as   "PISP"
        want "to submit a single SEPA credit transfer for my PSU"
        so   "my PSU can pay from their bank account without entering card details"
        note "SRC-IG §5.3.1. Example map: EXMAP-PIS-INITIATE-SCT."
      }
      story "Initiate an instant SEPA credit transfer" +STORY-PIS-INITIATE-INSTANT +"ask product" {
        as   "PISP"
        want "to submit an instant credit transfer"
        so   "the payee is paid within seconds"
        note "SRC-IG §5.3.1 payment products. Q-23."
      }
      story "Initiate a payment as a pain.001 message" +STORY-PIS-PAIN001 +"ask product" {
        as   "PISP"
        want "to submit the payment instruction as XML"
        so   "I reuse the format my corporate customers already produce"
        note "SRC-IG §5.3.2. Q-23, A-06."
      }
      story "Initiate a bulk payment" +STORY-PIS-BULK {
        as   "PISP"
        want "to submit several payments in one initiation"
        so   "a payroll run needs one authorisation"
        note "SRC-IG §5.3.3."
      }
      story "Initiate a standing order" +STORY-PIS-PERIODIC {
        as   "PISP"
        want "to set up a recurring payment"
        so   "my PSU does not repeat the instruction every month"
        note "SRC-IG §5.3.4."
      }
      story "Group several transactions into one signing basket" +STORY-SIGNING-BASKET {
        as   "PISP"
        want "to group payments and consents so one SCA authorises them all"
        so   "my PSU confirms once instead of many times"
        note "SRC-IG §8. Optional for the ASPSP."
      }
      story "Confirm the payee's name before authorisation" +STORY-PIS-VOP +"ask compliance" {
        as   "Account holder"
        want "to be told when the payee name does not match the account I am paying"
        so   "I do not pay the wrong person"
        note "Verification of Payee; SRC-IG §14.6 creditorNameConfirmation, §14.13 RVCM/RVNC/RCVC. Q-39."
      }
    }
    step "Confirm at the bank" {
      story "Log in at the bank and confirm the payment on my enrolled device" @"Walking skeleton" +skeleton +STORY-PIS-SCA-DEVICE {
        as   "Account holder"
        want "to log in on the bank's login screen and confirm the payment on my enrolled device"
        so   "only I can release a payment from my account"
        note "SRC-ADR SCA journey. What the device shows for a payment is open (Q-17)."
      }
      story "See the amount and payee before I confirm a payment" +STORY-PIS-PAYMENT-CONFIRM +"ask compliance" {
        as   "Account holder"
        want "to see how much is being paid and to whom, on the surface where I confirm"
        so   "I am not signing something I cannot see"
        note "UNSCHEDULED ON PURPOSE. Dynamic linking requires it (SRC-IG §5.1), and SRC-ADR \
              names a consent confirmation panel but nothing for a payment. Q-17, C-09, UX-09. \
              This is a gap in the supplied context, not a backlog item somebody forgot."
      }
    }
  }

  activity "Follow the payment" +EVT-PAYMENT-FINAL-STATUS-REACHED +ACTV-FOLLOW-PAYMENT {
    persona "Account holder"
    persona "PISP"

    step "Read the status" {
      story "Read the payment status" @"Walking skeleton" +skeleton +STORY-PIS-STATUS {
        as   "PISP"
        want "to read the ISO 20022 transaction status of the payment"
        so   "I can tell the merchant and the PSU what happened"
        note "SRC-IG §5.4, §14.13. Example map: EXMAP-PIS-STATUS."
      }
      story "Read the payment initiation back" @"MVP" +STORY-PIS-READ-PAYMENT {
        as   "PISP"
        want "to read the payment as the bank stored it"
        so   "I can reconcile what I sent with what was accepted"
        note "SRC-IG §5.6."
      }
      story "Reject a payment whose SCA window closed" @"MVP" +STORY-PIS-SCA-TIMEOUT {
        as   "PISP"
        want "a payment to reach RJCT when my PSU never confirmed it"
        so   "I stop waiting and can offer another payment method"
        note "SRC-IG §5.4. The window length is open (Q-24)."
      }
    }
    step "Change of mind" {
      story "Cancel a payment initiation" +STORY-PIS-CANCEL +"ask product" {
        as   "PISP"
        want "to cancel a payment that has not been executed"
        so   "my PSU is not charged for an order that fell through"
        note "Optional in SRC-IG §5.7. Q-40."
      }
      story "Be notified of a status change" +STORY-PIS-NOTIFY +"ask product" {
        as   "PISP"
        want "the bank to push status changes to my endpoint"
        so   "I stop polling"
        note "TPP-Notification-URI; [XS2A-RSNS] was not supplied. Q-42."
      }
    }
  }
}
