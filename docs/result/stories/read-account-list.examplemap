// EXMAP-READ-ACCOUNT-LIST — PROPOSAL generated by AI. Not yet discussed by a Three Amigos session.
// Sources: SRC-IG §6 (available vs accessible accounts), §6.3.1.1 note, §6.5.1, §14.11.1,
// §14.20. IBANs are the specification's own test data (A-09).
examplemap "Read the list of accessible accounts" {
  delivery "Walking skeleton" release
  delivery "MVP" release

  story "Read the list of accessible accounts" @"Walking skeleton" +STORY-READ-ACCOUNT-LIST {
    as   "AISP"
    want "to read the accounts my consent covers, with their resource identifiers"
    so   "I can address balances and transactions afterwards"
    question "Is a resourceId stable across different consents of the same TPP, or only within \
              one consent?" +"ask architecture" +Q-30
  }

  rule "Accounts are addressed by a resourceId, never by an IBAN in the path" +R-ACC-01 {
    note "SRC-IG §14.20: the ASPSP may tokenise the account identification; §4.11.2 addresses \
          /accounts/{account-id}. Keeping core identifiers out of URLs is INV-ACC-01."
    example "The account list returns a resourceId that addresses the balances endpoint" @"Walking skeleton" {
      given "a valid consent for balances on DE40100100103307118608"
      when  "the AISP reads GET /v1/accounts"
      then  "the account carries a resourceId that is not the IBAN"
      then  "the balances link uses that resourceId"
    }
  }

  rule "A transactions or balances access also gives the account list" +R-ACC-02 {
    note "SRC-IG §6.3.1.1 note: a transactions or balances access right implicitly supports the \
          generic /accounts endpoint."
    example "Transactions access alone shows the account in the list" @"MVP" {
      given "a valid consent with access.transactions = [DE40100100103307118608] and no access.accounts"
      when  "the AISP reads GET /v1/accounts"
      then  "the list contains the account DE40100100103307118608"
    }
    example "An account outside the consent is not listed" @"MVP" +edge-case {
      given "a PSU holding DE40100100103307118608 and DE02100100109307118603"
      given "a valid consent naming only DE40100100103307118608"
      when  "the AISP reads GET /v1/accounts"
      then  "the list contains only DE40100100103307118608"
    }
  }

  rule "Only a valid consent authorises a read" +R-ACC-03 {
    note "SRC-IG §14.15 (only 'valid' allows GET account data calls) and §14.11.1 \
          CONSENT_INVALID, CONSENT_EXPIRED, CONSENT_UNKNOWN."
    example "A read with a consent still at received is refused" @"Walking skeleton" +edge-case {
      given "a consent whose authorisation has not been finalised"
      when  "the AISP reads GET /v1/accounts with that Consent-ID"
      then  "no account data is returned"
    }
    example "A read with an expired consent is refused" @"MVP" +edge-case {
      given "a consent whose validUntil passed yesterday"
      when  "the AISP reads GET /v1/accounts with that Consent-ID"
      then  "the response is 401 with code CONSENT_EXPIRED"
    }
    question "Which code does a read get when the consent was revoked rather than expired, and \
              how fast must the bank know, given that Finologee masters the record?" +"ask architecture" +Q-22
  }

  rule "Available accounts and accessible accounts are different lists" +R-ACC-04 {
    note "SRC-IG §6: available = every account open to XS2A; accessible = those the consent \
          covers. The read is syntactically identical and differs only by the Consent-ID."
    example "A consent on one of two accounts makes only that one accessible" @"MVP" {
      given "a PSU holding DE40100100103307118608 and DE02100100109307118603"
      given "a consent granting transactions and balances on DE40100100103307118608"
      when  "the AISP reads GET /v1/accounts"
      then  "the list contains one account"
    }
    question "Does the bank offer the availableAccounts consent at all, and with which level of \
              detail?" +"ask product" +Q-10
  }
}
