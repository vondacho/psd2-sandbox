// EXMAP-SCA-DEVICE — PROPOSAL generated by AI. Not yet discussed by a Three Amigos session.
// Sources: SRC-IG §6.1.1.1 (redirect, implicit start), §4.6, §4.15, §7.5, §14.15, §14.16;
// SRC-ADR SCA journey (CIAM login in the browser, then OTP / QR / biometrics, then the consent
// confirmation panel on the enrolled device).
// The panel is read as the ASPSP "displaying the consent details when performing the SCA" of the
// Detailed Consent model (A-15). That reading is an assumption, not a fact, and R-SCA-02 is
// where it would break first.
examplemap "Log in at the bank and confirm the consent on my enrolled device" {
  delivery "Walking skeleton" release
  delivery "MVP" release

  story "Log in at the bank and confirm the consent on my enrolled device" @"Walking skeleton" +STORY-SCA-DEVICE {
    as   "Account holder"
    want "to log in on the bank's login screen and then confirm the request on my enrolled device"
    so   "I never give my bank credentials to the TPP, and only my own device can complete the approval"
    question "Which factor does the browser login contribute and which does the device step, and \
              are they independent under [EBA-RTS]?" +"ask iam" +Q-14
    question "The ADR calls the whole journey app-managed yet puts the login screen in the \
              browser. Which system renders that screen?" +"ask iam" +Q-12
  }

  rule "The bank starts the authorisation itself and hands the TPP a redirect link" +R-SCA-01 {
    note "SRC-IG §4.6 and §6.1.1.1: the ASPSP may create the authorisation sub-resource \
          implicitly and steer the TPP by the scaRedirect hyperlink (§4.15, §14.6)."
    example "A consent request comes back with a redirect link and no further TPP data" @"Walking skeleton" {
      given "an AISP that sent TPP-Redirect-Preferred true and a TPP-Redirect-URI"
      when  "the AISP posts a consent on dedicated accounts"
      then  "the response is 201 with header ASPSP-SCA-Approach REDIRECT"
      then  "the response carries a scaRedirect link and an authorisation sub-resource"
    }
    question "Does the bank offer redirect only, or also decoupled — which is what the device \
              journey already is?" +"ask architecture" +Q-09
  }

  rule "The panel shows the consent the PSU is confirming, and the SCA binds to what it showed" +R-SCA-02 {
    note "SRC-IG §6 'Detailed Consent': the ASPSP displays the consent details to the PSU when \
          performing the SCA. A-15 reads the ADR's consent confirmation panel as exactly that."
    example "The panel names the TPP, the accounts and the access types" @"Walking skeleton" {
      given "a consent from Sandbox AISP Ltd for balances and transactions on DE40100100103307118608"
      given "a PSU authenticated on the bank login screen with one enrolled device"
      when  "the consent confirmation panel is presented on that device"
      then  "the panel names Sandbox AISP Ltd"
      then  "the panel lists DE40100100103307118608 with balances and transactions"
    }
    example "A consent changed after the panel was shown cannot be confirmed" @"MVP" +edge-case {
      given "a consent confirmation panel showing two accounts"
      given "the underlying consent record is replaced before the PSU confirms"
      when  "the PSU confirms on the device"
      then  "the confirmation is refused because it does not match what was shown"
      then  "the authorisation does not reach finalised"
    }
    question "May the PSU deselect an account or an access type on the panel, and what is stored \
              if they do?" +"ask product" +Q-34
  }

  rule "The consent becomes valid only when the authorisation is finalised" +R-SCA-03 {
    note "SRC-IG §14.15 and §14.16: consentStatus received -> valid; scaStatus received -> \
          psuAuthenticated -> finalised."
    example "The TPP sees received until the PSU has confirmed on the device" @"Walking skeleton" {
      given "a consent whose authorisation is at scaStatus psuAuthenticated"
      when  "the AISP reads the consent status"
      then  "consentStatus is received"
    }
    example "The consent becomes valid after the items are confirmed" @"Walking skeleton" {
      given "a consent whose PSU confirmed identity and then the items on the panel"
      when  "the AISP reads the consent status"
      then  "consentStatus is valid"
      then  "the scaStatus of the authorisation is finalised"
    }
  }

  rule "A decline ends the authorisation and the consent, and says so to both sides" +R-SCA-04 {
    note "SRC-IG §14.15 rejected: 'no successful authorisation has taken place'; §14.16 failed."
    example "Declining the items rejects the consent" @"MVP" {
      given "a consent whose PSU confirmed identity on the device"
      when  "the PSU declines the items on the consent confirmation panel"
      then  "the scaStatus of the authorisation is failed"
      then  "consentStatus is rejected"
      then  "the browser offers a way back to the TPP"
    }
    example "Rejecting the identity step never reaches the panel" @"MVP" +edge-case {
      given "a PSU authenticated on the login screen"
      when  "the PSU rejects the request on the OTP screen"
      then  "the consent confirmation panel is not presented"
      then  "consentStatus is rejected"
    }
  }

  rule "A redirect link works once, and only inside its window" +R-SCA-05 {
    note "Protects against replay and session fixation; SRC-IG §7.6.2 sets requirements on the \
          PSU browser request, and §7.6 defines the optional confirmation code."
    example "Following the same redirect link twice shows the unavailable page" @"MVP" +edge-case {
      given "a scaRedirect link already followed to completion"
      when  "the PSU opens the same link again"
      then  "the request-no-longer-available page is shown"
      then  "no second authorisation is started"
    }
    example "A redirect link followed after the SCA window shows the unavailable page" @"MVP" +edge-case {
      given "a scaRedirect link whose SCA window has closed"
      when  "the PSU opens it"
      then  "the request-no-longer-available page is shown"
    }
    question "How long is the SCA window?" +"ask product" +Q-24
    question "Does the bank require the confirmation call of §7.6, which inserts unconfirmed \
              before finalised?" +"ask architecture" +Q-29
  }
}
