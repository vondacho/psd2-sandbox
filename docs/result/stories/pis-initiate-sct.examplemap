// EXMAP-PIS-INITIATE-SCT — PROPOSAL generated by AI. Not yet discussed by a Three Amigos session.
// Sources: SRC-IG §5.1.1, §5.3.1, §4.14.1, §14.13, §14.11.1. SRC-ADR SCA journey.
// R-PIS-05 is the rule this proposal cannot write examples for: the ADR names no surface where a
// payment's amount and payee are shown. The rule stays, its examples are named and not written
// out, and the question stays red (Q-17).
examplemap "Initiate a SEPA credit transfer" {
  delivery "Walking skeleton" release
  delivery "MVP" release

  story "Initiate a SEPA credit transfer" @"Walking skeleton" +STORY-PIS-INITIATE-SCT {
    as   "PISP"
    want "to submit a single SEPA credit transfer for my PSU"
    so   "my PSU can pay from their bank account without entering card details"
    question "Which payment products does the bank offer beyond sepa-credit-transfers?" +"ask product" +Q-23
  }

  rule "An accepted initiation becomes a resource with transactionStatus RCVD" +R-PIS-01 {
    note "SRC-IG §5.3.1: HTTP 201, Location header, transactionStatus RCVD, ASPSP-SCA-Approach."
    example "A single credit transfer of 123 EUR is accepted" @"Walking skeleton" {
      given "instructedAmount 123.50 EUR"
      given "debtorAccount DE40100100103307118608 and creditorAccount DE02100100109307118603"
      given "creditorName Merchant Inc"
      when  "the PISP posts the payment to /v1/payments/sepa-credit-transfers"
      then  "the response is 201 Created with transactionStatus RCVD"
      then  "the response carries a paymentId, a Location header and a scaRedirect link"
    }
  }

  rule "The payment product in the path must match the payment in the body" +R-PIS-02 {
    note "SRC-IG §4.11.1 and §14.11.1 SERVICE_INVALID, PRODUCT_INVALID."
    example "An instant transfer posted to the sepa-credit-transfers endpoint is refused" @"MVP" +edge-case {
      given "a payment body describing an instant credit transfer"
      when  "the PISP posts it to /v1/payments/sepa-credit-transfers"
      then  "no payment initiation resource is created"
    }
    question "Which code applies — 400 SERVICE_INVALID, 400 PRODUCT_INVALID or 405?" +"ask architecture" +Q-19
  }

  rule "A payment names a debtor account the PSU may pay from" +R-PIS-03 {
    note "SRC-IG §5.3.1 debtorAccount; §14.11.2 PAYMENT_FAILED. The bank can only check this \
          once the PSU is identified, which is after the redirect."
    example "A payment from an account the authenticated PSU does not hold fails" @"MVP" +edge-case {
      given "a payment with debtorAccount DE02100100109307118603"
      given "a PSU who holds only DE40100100103307118608"
      when  "the PSU has authenticated and the authorisation is evaluated"
      then  "the payment does not reach an authorised state"
      then  "transactionStatus becomes RJCT"
    }
  }

  rule "A payment initiation never changes after it is created" +R-PIS-04 {
    note "SRC-IG §5.6: the payment is read back as submitted. Immutability is what makes the \
          SCA binding meaningful (INV-PAY-01, INV-AUT-05)."
    example "Reading the payment back returns the amount that was submitted" @"MVP" {
      given "a payment initiation 1234-wertiq-983 of 123.50 EUR"
      when  "the PISP reads GET /v1/payments/sepa-credit-transfers/1234-wertiq-983"
      then  "instructedAmount is 123.50 EUR"
    }
  }

  rule "The PSU sees the amount and the payee on the surface where the payment is confirmed" +R-PIS-05 {
    note "Dynamic linking: SRC-IG §5.1 and the RTS behind it require the PSU to be shown what is \
          being authorised, and the SCA to be bound to it. SRC-ADR names a consent confirmation \
          panel and nothing for a payment (C-09). No example below is written out, because \
          writing one would decide Q-17 on the bank's behalf."
    example "The amount and payee are shown before the PSU confirms"
    example "A payment whose amount changed after it was shown cannot be confirmed"
    question "Where does the PSU see a payment's amount and payee before confirming — a payment \
              panel beside the consent one, the TPP's screen plus a bank-side digest, or another \
              bank surface?" +"ask compliance" +Q-17
    question "Are fees and currency conversion shown at the same time?" +"ask compliance" +Q-46
  }
}
