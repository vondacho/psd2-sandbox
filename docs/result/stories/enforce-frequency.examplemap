// EXMAP-ENFORCE-FREQUENCY — PROPOSAL generated by AI. Not yet discussed by a Three Amigos session.
// Sources: SRC-IG §6 ("the frequency of the access is checked by the ASPSP per account that has
// been accessed and per PSU that has given consent"), §6.3.1.1 frequencyPerDay, §14.11.3
// ACCESS_EXCEEDED. The counter is a bank-side aggregate even though Finologee masters the
// consent record (A-16, D-01).
examplemap "Refuse reads beyond the agreed daily frequency" {
  delivery "Walking skeleton" release
  delivery "MVP" release

  story "Refuse reads beyond the agreed daily frequency" @"MVP" +STORY-ENFORCE-FREQUENCY {
    as   "Account holder"
    want "the bank to refuse a TPP that reads my data more often than I agreed"
    so   "the limit I confirmed means something"
    question "Which clock bounds a day — the ASPSP's local calendar day, or a rolling 24 hours \
              from the first read?" +"ask architecture"
  }

  rule "Unattended reads are counted per account and per PSU, against frequencyPerDay" +R-FRQ-01 {
    note "SRC-IG §6: checked per account accessed and per PSU that gave the consent."
    example "The fifth unattended read of the day is refused on a consent of four" @"MVP" +edge-case {
      given "a valid recurring consent with frequencyPerDay 4 on DE40100100103307118608"
      given "four reads already made today without the PSU present"
      when  "the AISP reads the balances again without the PSU present"
      then  "the response is 429 with code ACCESS_EXCEEDED"
    }
    example "A consent on two accounts counts each account separately" @"MVP" {
      given "a valid recurring consent with frequencyPerDay 2 on DE40100100103307118608 and DE02100100109307118603"
      given "two unattended reads already made today on DE40100100103307118608"
      when  "the AISP reads the balances of DE02100100109307118603 without the PSU present"
      then  "the balances are returned"
    }
  }

  rule "A read the PSU is present for does not consume the daily allowance" +R-FRQ-02 {
    note "SRC-IG §6.3.1.1: frequencyPerDay is 'the requested maximum frequency for an access \
          without PSU involvement per day'. The TPP signals presence in the request."
    example "A PSU-initiated read on an exhausted allowance is served" @"MVP" +edge-case {
      given "a valid consent with frequencyPerDay 4 whose allowance is used up today"
      when  "the AISP reads the transactions with the PSU present"
      then  "the transactions are returned"
    }
    question "Does the bank trust the TPP's statement that the PSU is present, and does it log \
              that claim for audit?" +"ask compliance"
  }

  rule "The allowance resets, and a refusal never changes the consent" +R-FRQ-03 {
    note "SRC-IG §14.15: exceeding the frequency is not one of the consent's end states."
    example "The allowance is available again the next day" @"MVP" {
      given "a valid consent with frequencyPerDay 4 refused with ACCESS_EXCEEDED yesterday"
      when  "the AISP reads the balances today without the PSU present"
      then  "the balances are returned"
    }
    example "A refused read leaves the consent valid" @"MVP" {
      given "a valid consent refused with ACCESS_EXCEEDED"
      when  "the AISP reads the consent status"
      then  "consentStatus is valid"
    }
  }
}
