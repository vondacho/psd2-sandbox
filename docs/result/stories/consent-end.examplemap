// EXMAP-CONSENT-END — PROPOSAL generated by AI. Not yet discussed by a Three Amigos session.
// Sources: SRC-IG §6.4 (DELETE), §6.3.1.1 (recurring side effect), §4.14.2 and §14.15
// (consentStatus end states). SRC-ADR: the consent screen is the TPP's, and Finologee masters
// the consent record.
// The red card on the story is the point of this map: revokedByPsu has no path in as the
// context is written. It is not answered here.
examplemap "Delete the consent" {
  delivery "Walking skeleton" release
  delivery "MVP" release

  story "Delete the consent" @"Walking skeleton" +STORY-CONSENT-DELETE {
    as   "AISP"
    want "to delete a consent my PSU no longer wants"
    so   "the access stops and my PSU sees that it stopped"
    question "revokedByPsu is defined as a revocation towards the ASPSP (§14.15), and the only \
              consent screen belongs to the TPP. Where does a PSU withdraw access at the \
              bank?" +"ask compliance" +D-09
    question "How quickly must an ending at Finologee reach the bank's enforcing projection, and \
              what happens to a read in between?" +"ask architecture" +D-01
  }

  rule "A TPP deletion ends the consent and stops the access" +R-REV-01 {
    note "SRC-IG §6.4: DELETE /v1/consents/{consentId} returns 204 No Content; §14.15 \
          terminatedByTpp."
    example "Deleting a valid consent returns 204 and ends it" @"Walking skeleton" {
      given "a valid consent 123cons456 created by PSDES-BDE-3DFD21"
      when  "the AISP deletes /v1/consents/123cons456"
      then  "the response is 204 No Content"
      then  "consentStatus is terminatedByTpp"
    }
    example "Deleting a consent that is already terminated changes nothing" @"MVP" +edge-case {
      given "a consent 123cons456 already at terminatedByTpp"
      when  "the AISP deletes it again"
      then  "consentStatus is still terminatedByTpp"
    }
  }

  rule "No read succeeds once the consent has ended, whichever way it ended" +R-REV-02 {
    note "SRC-IG §14.15: only 'valid' allows GET account data calls. Which message code applies \
          to a revoked consent is not stated, which is Q-22."
    example "A read after a TPP deletion is refused" @"Walking skeleton" +edge-case {
      given "a consent at terminatedByTpp"
      when  "the AISP reads GET /v1/accounts with that Consent-ID"
      then  "no account data is returned"
    }
    example "A read on the next call after an ending at the gateway is refused" @"MVP" +edge-case {
      given "a valid consent whose record was ended at Finologee one second ago"
      when  "the AISP reads GET /v1/accounts with that Consent-ID"
      then  "no account data is returned"
    }
    question "Which HTTP and message code does the TPP get for a consent the PSU ended, as \
              opposed to one that expired?" +"ask architecture" +Q-22
  }

  rule "A consent ends by itself when its validity runs out" +R-REV-03 {
    note "SRC-IG §4.14.2, §14.15 expired; §6.3.1.1 validUntil includes the mentioned date."
    example "A consent is still usable on its validUntil date" @"MVP" {
      given "a valid consent with validUntil 2026-11-01"
      when  "the AISP reads the balances on 2026-11-01"
      then  "the balances are returned"
    }
    example "The same consent is refused the following day" @"MVP" +edge-case {
      given "a consent with validUntil 2026-11-01"
      when  "the AISP reads the balances on 2026-11-02"
      then  "the response is 401 with code CONSENT_EXPIRED"
      then  "consentStatus is expired"
    }
  }

  rule "Authorising a new recurring consent ends the former one of the same TPP and PSU" +R-CNS-06 {
    note "SRC-IG §6.3.1.1 side effects. The end state is contradicted between §6.3.1.1 and \
          §4.14.2, which is C-01."
    example "The second recurring consent replaces the first" @"MVP" {
      given "consent A, recurring and valid, for PSU-1234 and TPP PSDES-BDE-3DFD21"
      given "consent B, recurring, for the same PSU and the same TPP"
      when  "the PSU confirms consent B on the enrolled device"
      then  "consent B is valid"
      then  "account reads with consent A are refused"
    }
    example "A one-off consent leaves the recurring consent alone" @"MVP" +edge-case {
      given "consent A, recurring and valid, for PSU-1234 and TPP PSDES-BDE-3DFD21"
      given "consent C, one-off, for the same PSU and the same TPP"
      when  "the PSU confirms consent C on the enrolled device"
      then  "consent A is still valid"
    }
    question "Does consent A become expired (§6.3.1.1) or terminatedByTpp (§4.14.2)?" +"ask compliance" +Q-20
  }
}
