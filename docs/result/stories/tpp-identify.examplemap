// EXMAP-TPP-IDENTIFY — PROPOSAL generated by AI. Not yet discussed by a Three Amigos session.
// Sources: SRC-IG §3 (transport), §4.9 (TPP identification), §4.11 (resource ownership),
// §14.11.1 (certificate and role error codes). SRC-ADR: Finologee authenticates the TPP.
// Test data are the specification's own example values plus invented labels (A-09).
examplemap "Identify the TPP from its certificate" {
  delivery "Walking skeleton" release
  delivery "MVP" release

  story "Identify the TPP from its certificate" @"Walking skeleton" +STORY-TPP-IDENTIFY {
    as   "AISP"
    want "the bank to recognise me and my PSD2 roles from my QWAC on the TLS connection"
    so   "I can act for my PSUs under my own licence without a separate bank-specific login"
    question "Does the bank check the NCA register in addition to the certificate, and who \
              performs that check — Finologee or the gateway?" +"ask architecture" +Q-08
  }

  rule "No request reaches the resource model without a valid QWAC" +R-TPP-01 {
    note "SRC-IG §3: TLS with client authentication using a qualified website authentication \
          certificate. §14.11.1 lists CERTIFICATE_INVALID, _EXPIRED, _BLOCKED, _REVOKED, _MISSING."
    example "A consent request over mTLS with a valid QWAC is accepted" @"Walking skeleton" {
      given "a TPP with organizationIdentifier PSDES-BDE-3DFD21 and role PSP_AI"
      given "a valid, unexpired QWAC presented on the TLS connection"
      when  "the TPP posts a consent on dedicated accounts"
      then  "the request reaches the XS2A resource model"
      then  "the consent records PSDES-BDE-3DFD21 as its owner"
    }
    example "An expired certificate is refused before any resource is created" @"MVP" +edge-case {
      given "a TPP whose QWAC expired yesterday"
      when  "the TPP posts a consent on dedicated accounts"
      then  "the response is 401 with code CERTIFICATE_EXPIRED"
      then  "no consent resource is created"
    }
  }

  rule "The PSD2 roles in the certificate decide which services the TPP may call" +R-TPP-02 {
    note "SRC-IG §4.9; §14.11.1 ROLE_INVALID, HTTP 401."
    example "A certificate with only the AISP role may not initiate a payment" @"MVP" +edge-case {
      given "a TPP with role PSP_AI only"
      when  "the TPP posts a SEPA credit transfer"
      then  "the response is 401 with code ROLE_INVALID"
      then  "no payment initiation resource is created"
    }
    example "A certificate with the PISP role may initiate a payment" @"MVP" {
      given "a TPP with role PSP_PI"
      when  "the TPP posts a SEPA credit transfer"
      then  "a payment initiation resource is created"
    }
  }

  rule "A TPP may only address the resources it created" +R-TPP-03 {
    note "SRC-IG §4.11: the methods may only be applied to resources created by the same TPP."
    example "Another TPP cannot read a consent it did not create" @"MVP" +edge-case {
      given "consent 123cons456 created by PSDES-BDE-3DFD21"
      given "a second TPP PSDFR-ACPR-12345 with a valid QWAC and the AISP role"
      when  "the second TPP reads GET /v1/consents/123cons456"
      then  "the consent content is not disclosed"
    }
    question "Is the refusal 403 RESOURCE_UNKNOWN or 404, given that the resource is in the path \
              (§14.11.1)?" +"ask architecture" +Q-19
  }

  rule "The owner of a resource is the legal holder of the certificate, not the brand" +R-TPP-04 {
    note "SRC-IG §4.9: TPP-Brand-Logging-Information is for logging only; the organizationIdentifier \
          identifies the TPP."
    example "Two brands of one licensed TPP share their resources" @"MVP" {
      given "consent 123cons456 created with organizationIdentifier PSDES-BDE-3DFD21 and brand Budget Buddy"
      when  "the same organizationIdentifier reads the consent while logging brand Money Mate"
      then  "the consent is readable"
    }
    question "Is the TPP's brand shown to the PSU on the consent confirmation panel, and from \
              which source?" +"ask product" +Q-33
  }
}
