// AIS consent lifecycle — process model with software-design cards
// PROPOSAL generated by AI. Zooms into Big Picture columns 3–15 (EVT-CONSENT-AUTHORISED,
// EVT-CONSENT-ENDED). Drawn for the redirect SCA approach with an implicit start of the
// authorisation (SRC-IG §6.1.1.1), which is what SRC-ADR implies and D-03 proposes.
// Screens: the IDP owns the login screen, the consent screen grants and revokes access, and the
// CIAM asks the bank app for the SCA screen on an enrolled device (SRC-ADR).
// Aggregates match docs/domain/consent/consent.ddm and
// docs/domain/transaction-authorisation/transaction-authorisation.ddm; readmodel and ui cards
// carry the RM- and SCR- ids defined in docs/journeys/service-blueprint.md.
eventstorm "AIS consent lifecycle — process and system design" {

  lane "AISP" {
    actor "AISP" @1
    command "Create consent" @1 {
      note "POST /v1/consents with access, recurringIndicator, validUntil, frequencyPerDay, \
            combinedServiceIndicator (SRC-IG §6.3.1.1)."
    }
    event "PSU sent to the SCA redirect link" @5
    event "PSU returned to the TPP" @12
    command "Read consent status" @13
    readmodel "Consent status" @13 +RM-TPP-CONSENT-STATUS
    command "Delete consent" @15
  }

  lane "ASPSP gateway — Consent" {
    aggregate "Consent" @2
    event "Consent received" @2
    event "Consent request refused" @2 {
      note "400 FORMAT_ERROR when a dedicated-account access list is empty, or \
            frequencyPerDay < 1 (SRC-IG §6.3.1.1, §14.11.1)."
    }
    policy "Whenever a consent is received and the TPP did not prefer an explicit start, \
            start its authorisation" @3
    hotspot "Nobody has confirmed which SCA approaches TPPs are offered; this wall shows \
             redirect" @3 +"ask architecture" +"ask product" +Q-03
    policy "Whenever the authorisation of a consent is finalised, make the consent valid" @10
    command "Validate consent" @10
    aggregate "Consent" @10
    event "Consent authorised by the PSU" @10 +EVT-CONSENT-AUTHORISED
    policy "Whenever the authorisation of a consent fails, reject the consent" @10
    event "Consent rejected" @10
    policy "Whenever a recurring consent becomes valid, end the former recurring consent \
            of the same TPP and PSU" @11
    event "Former recurring consent ended" @11
    hotspot "Is the former consent 'expired' (§6.3.1.1) or 'terminatedByTpp' (§4.14.2)?" @11 +"ask compliance" +Q-08
    readmodel "Consents due to expire" @14 +RM-CONSENTS-DUE-TO-EXPIRE
    policy "Whenever validUntil has passed, or a one-off consent has been used, expire the consent" @14
    event "Consent expired" @14
    event "Consent revoked by the PSU" @15
    event "Consent terminated by the TPP" @15
    event "Consent ended" @16 +EVT-CONSENT-ENDED
    readmodel "Access decision for an account read" @16 +RM-ACCESS-DECISION {
      note "Read by Account Information on every read: a revoked, expired or terminated consent \
            refuses the TPP's next read (H-03)."
    }
  }

  lane "ASPSP gateway — Transaction Authorisation" {
    command "Start authorisation" @4
    aggregate "Authorisation" @4
    event "Authorisation started" @4 {
      note "scaStatus = received; the response carries scaRedirect, scaStatus and status links."
    }
    readmodel "Redirect session" @5 +RM-REDIRECT-SESSION
    hotspot "Does the bank require the confirmation call, so that an authorisation passes \
             through 'unconfirmed' before 'finalised' (§7.6)?" @9 +"ask architecture" +Q-34
    command "Record SCA result" @9
    aggregate "Authorisation" @9
    event "Authorisation finalised" @9
    event "Authorisation failed" @9
    readmodel "Authorisation outcome" @10 +RM-AUTHORISATION-OUTCOME
    readmodel "SCA deadlines" @10 +RM-SCA-DEADLINES
    policy "Whenever the SCA window closes without a result, fail the authorisation" @10
    hotspot "How long is the SCA window for a consent?" @10 +"ask product" +Q-29
  }

  lane "Consent screen (ASPSP gateway or Finologee)" {
    ui "Request no longer available" @5 +SCR-CONSENT-UNAVAILABLE
    readmodel "Consent details for approval" @7 +RM-CONSENT-APPROVAL {
      note "TPP legal name (and brand, if the bank uses OU — SRC-IG §4.9), accounts, access types, \
            validUntil, frequencyPerDay. Shown so the PSU approves what the TPP asked for."
    }
    ui "Grant access" @7 +SCR-CONSENT-ACCESS
    hotspot "Can the PSU deselect accounts or access types before approving?" @7 +"ask product" +Q-36
    hotspot "What does the PSU see when the TPP names an account the PSU does not hold?" @7 +"ask product" +Q-35
    actor "Account holder" @8
    command "Approve consent" @8
    command "Decline consent" @8
    ui "Confirm in your bank app" @8 +SCR-CONSENT-AWAIT-APP
    ui "No enrolled device" @8 +SCR-CONSENT-NO-DEVICE
    hotspot "What is offered to a PSU with no enrolled device: enrol now, or another SCA method?" @8 +"ask product" +Q-21
    ui "Outcome and return to the TPP" @10 +SCR-CONSENT-OUTCOME
    hotspot "Show an outcome on the consent screen before returning to the TPP, or return at once?" @10 +"ask product" +Q-39
    readmodel "This TPP's access" @15 +RM-PSU-TPP-ACCESS
    ui "Manage this provider's access" @15 +SCR-CONSENT-MANAGE
    ui "Withdraw access confirmation" @15 +SCR-CONSENT-REVOKE-CONFIRM
    command "Revoke access" @15
    hotspot "How does the PSU reach the consent screen to revoke, and is that 'towards the ASPSP'?" @15 +"ask product" +Q-43
  }

  lane "Mobile app (SCA screen)" {
    readmodel "SCA prompt" @8 +RM-SCA-PROMPT
    ui "SCA screen" @8 +SCR-APP-SCA
    command "Confirm identity" @8
    command "Reject the request" @8
  }

  lane "Identity and SCA (Ping Federate, Transmit)" {
    system "Ping Federate" @6
    ui "Login screen" @6 +SCR-IDP-LOGIN
    command "Authenticate PSU" @6
    event "PSU authenticated" @7
    system "Transmit" @8
    readmodel "SCA context" @8 +RM-SCA-CONTEXT {
      note "Enrolled devices and methods; the CIAM decides which device is asked (SRC-ADR 7ed3eb1)."
    }
    command "Request SCA on an enrolled device" @8
    hotspot "Who signs the SCA assertion the gateway trusts, and which factor category does \
             each step contribute?" @8 +"ask iam" +Q-07
  }
}
