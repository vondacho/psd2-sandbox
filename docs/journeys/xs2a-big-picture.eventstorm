// Big Picture — access to account through a TPP (PSD2 XS2A)
// PROPOSAL generated by AI on 2026-09-19. Not a workshop record: no room has seen this wall.
// Sources: SRC-IG (NextGenPSD2 IG v1.3.16), SRC-ADR, SRC-Q, SRC-TERM — see problem-analysis.md.
// Every hotspot is an open question in docs/traceability/questions-and-assumptions.md (tag +Q-xx).
// Pivotal events carry their stable id as a tag (+EVT-...); they cut the story-map backbone.
// Iteration 3 (SRC-ADR 87c72b8): the mobile app carries only the last SCA factor; granting and
// revoking access happens on a consent screen (ASPSP gateway or Finologee). The hotspot "overview
// in the mobile app" (Q-26) and its opportunity were closed by that ADR and removed.
eventstorm "PSD2 access to account — Big Picture" {

  lane "Account holder (PSU)" {
    actor "Account holder" @3
    event "Account access requested at the TPP" @3
    event "PSU redirected to the bank" @6
    event "PSU returned to the TPP" @10
    event "Payment requested at the TPP" @16
    event "PSU told the payment outcome" @22
  }

  lane "TPP (AISP / PISP)" {
    actor "AISP or PISP" @1
    event "TPP certificate presented" @1
    event "Consent requested" @4
    event "Account list read" @11
    event "Balances and transactions read" @12
    event "Consent deleted by the TPP" @14
    hotspot "The TPP only learns of a revocation on its next read, and the \
             standard names no message code for a revoked consent" @15 +"ask architecture" +Q-09
    event "Payment initiation submitted" @17
    event "Payment status read" @22
    event "Payment cancellation requested" @23 +"outside MVP"
    event "Funds confirmation requested" @24 +"outside MVP"
  }

  lane "PSD2 gateway (Finologee)" {
    system "Finologee PSD2 gateway" @1
    event "TPP identified from its certificate" @2 +pivotal +EVT-TPP-IDENTIFIED {
      note "QWAC over mTLS carries the TPP roles (SRC-IG §3, §4.9). The legal owner of the \
            certificate, not the brand in OU, owns consents."
    }
    event "TPP refused because its certificate lacks the role" @2
    hotspot "Nobody has decided whether Finologee or the bank validates the QWAC, \
             the TPP roles and the NCA register status" @2 +"ask architecture" +Q-05
    context "TPP Access" @2
    hotspot "Does the TPP call the bank with a Finologee-issued token, or is that token \
             exchanged for a bank-issued (Ping) token first?" @10 +"ask architecture" +Q-02
  }

  lane "ASPSP gateway (bank)" {
    event "Consent received" @4 {
      note "consentStatus = received (SRC-IG §14.15)."
    }
    hotspot "Which system holds the consent and provides the consent screen — the \
             ASPSP gateway (with IDP/CIAM) or Finologee — is not decided" @4 +"ask architecture" +Q-01
    context "Consent" @4
    event "SCA approach chosen for the request" @5
    hotspot "Which SCA approaches the bank offers (redirect, OAuth2, decoupled, \
             embedded) is not decided" @5 +"ask architecture" +"ask product" +Q-03
    opportunity "Approve on the bank's (or Finologee's) consent screen and confirm in the \
                 bank app, so the PSU never types bank credentials into a TPP" @5
    context "Transaction Authorisation" @9
    event "Consent authorised by the PSU" @9 +pivotal +EVT-CONSENT-AUTHORISED {
      note "consentStatus = valid; the authorisation sub-resource reaches scaStatus = finalised."
    }
    event "Former recurring consent of the same TPP ended" @9
    hotspot "The standard says the former recurring consent 'expires' (§6.3.1.1) and \
             also that 'terminatedByTpp' applies to that side effect (§4.14.2)" @9 +"ask compliance" +Q-08
    event "Consent authorisation failed" @9
    context "Account Information" @11
    event "Account list delivered" @11
    event "Account data delivered to the TPP" @12 +pivotal +EVT-ACCOUNT-DATA-DELIVERED
    event "Daily access limit reached" @13 {
      note "More reads without PSU involvement than frequencyPerDay: HTTP 429 ACCESS_EXCEEDED \
            (SRC-IG §14.11.3)."
    }
    event "Consent expired" @14
    event "Consent ended" @15 +pivotal +EVT-CONSENT-ENDED {
      note "One of expired, revokedByPsu, terminatedByTpp (SRC-IG §4.14.2)."
    }
    context "Payment Initiation" @17
    event "Payment initiation received" @17 {
      note "transactionStatus = RCVD (SRC-IG §5.3.1 example)."
    }
    hotspot "Whether Verification of Payee runs before authorisation, and with which \
             confirmation step, is not decided; [oFA-VOP] was not supplied" @17 +"ask compliance" +Q-16
    event "Payment authorised by the PSU" @19 +pivotal +EVT-PAYMENT-AUTHORISED
    event "Payment authorisation failed or timed out" @19 {
      note "If SCA is not completed in time the payment must become RJCT (SRC-IG §5.4)."
    }
    event "Payment accepted after technical checks" @20 {
      note "transactionStatus = ACTC (SRC-IG §4.14.1)."
    }
    event "Payment rejected" @21
    hotspot "Which end status the bank reports (ACTC, ACCP, ACSC) depends on its \
             booking type, which nobody has stated" @21 +"ask core banking" +Q-28
    event "Payment reached its final status" @22 +pivotal +EVT-PAYMENT-FINAL-STATUS-REACHED
    event "Payment cancelled" @23 +"outside MVP"
    hotspot "Cancellation is optional in the standard; nobody has said whether the \
             bank offers it or requires a cancellation authorisation" @23 +"ask product" +Q-15
    event "Funds availability answered" @24 +"outside MVP"
    hotspot "Funds confirmation is Mandatory (§4.11.6) but its PIIS consent is defined \
             outside the supplied document" @24 +"ask compliance" +Q-14
  }

  lane "Identity and SCA (Ping Federate, Transmit)" {
    system "Ping Federate" @7
    system "Transmit" @7
    context "Customer Identity and SCA" @7
    event "PSU authenticated" @7
    hotspot "Ping and Transmit both authenticate; nobody has said which one runs the \
             SCA journey, the dynamic linking and the OAuth authorisation server" @7 +"ask iam" +Q-07
    event "PSU authenticated with the amount and payee linked" @18
  }

  lane "Consent screen (ASPSP gateway or Finologee)" {
    hotspot "Is the consent screen a page the TPP redirects to, or a component embedded \
             in the TPP web application?" @5 +"ask architecture" +Q-44
    event "Consent details approved on the consent screen" @8
    event "Access revoked by the PSU on the consent screen" @14
    hotspot "How does the PSU reach the consent screen to revoke, and is a revocation \
             there made towards the ASPSP (§14.15)?" @14 +"ask product" +Q-43
    event "Payment approved on the consent screen" @18
    hotspot "Does a payment go through the consent screen at all? The ADR names only \
             access consent" @18 +"ask product" +Q-46
  }

  lane "Mobile app (last factor only)" {
    context "Mobile Banking" @8
    event "Last authentication factor confirmed in the mobile app" @8
    hotspot "Which factors come before the app's last factor, and how is the app \
             triggered (push, QR code, app link)?" @8 +"ask iam" +Q-45
    event "Payment confirmed with the last factor in the mobile app" @18
  }

  lane "Core banking" {
    system "Core banking" @11
    context "Core Banking" @11
    hotspot "No core-banking interface for accounts, balances, transactions or \
             payments is known" @11 +"ask core banking" +Q-06
    event "Payment booked on the debtor account" @21
  }
}
