// PIS single SEPA credit transfer — process model with software-design cards
// PROPOSAL generated by AI on 2026-09-19. Zooms into Big Picture columns 16–22
// (EVT-PAYMENT-AUTHORISED, EVT-PAYMENT-FINAL-STATUS-REACHED). Redirect SCA, implicit start
// (SRC-IG §5.1.3), as the proposed default of D-03.
// Aggregates match docs/domain/payment-initiation/payment-initiation.ddm and
// docs/domain/transaction-authorisation/transaction-authorisation.ddm.
// Iteration 2: readmodel and ui cards carry the RM-/SCR- ids defined in
// docs/journeys/service-blueprint.md.
// Iteration 4 (SRC-ADR 7ed3eb1): the payment is approved on the bank app SCA screen, where amount
// and payee are shown; the browser carries only the login screen and the waiting/outcome pages
// (Q-46, Q-48 — both proposals awaiting confirmation).
eventstorm "PIS single payment — process and system design" {

  lane "PISP" {
    actor "PISP" @1
    command "Initiate payment" @1 {
      note "POST /v1/payments/sepa-credit-transfers with instructedAmount, debtorAccount, \
            creditorName, creditorAccount, remittanceInformationUnstructured; PSU-IP-Address \
            is mandatory (SRC-IG §5.3.1)."
    }
    event "PSU sent to the SCA redirect link" @5
    event "PSU returned to the TPP" @10
    command "Read payment status" @11
    readmodel "Payment status" @11 +RM-TPP-PAYMENT-STATUS
  }

  lane "ASPSP gateway — Payment Initiation" {
    aggregate "Payment Initiation" @2
    event "Payment initiation received" @2 {
      note "201 Created, transactionStatus = RCVD, Location header, _links (SRC-IG §5.3.1)."
    }
    event "Payment initiation refused" @2 {
      note "e.g. 404 PRODUCT_UNKNOWN, 403 PRODUCT_INVALID, 400 FORMAT_ERROR, 401 ROLE_INVALID \
            (SRC-IG §14.11)."
    }
    hotspot "Whether Verification of Payee runs here, and whether it withholds the \
             authorisation links (creditorNameConfirmation, §14.6), is not decided" @2 +"ask compliance" +Q-16
    policy "Whenever a payment initiation is received and the TPP did not prefer an explicit \
            start, start its authorisation" @3
    policy "Whenever the authorisation of a payment is finalised, submit the payment for \
            execution" @9
    command "Submit payment for execution" @9
    aggregate "Payment Initiation" @9
    event "Payment authorised by the PSU" @9 +EVT-PAYMENT-AUTHORISED
    readmodel "SCA deadlines" @10 +RM-SCA-DEADLINES
    policy "Whenever the SCA window closes without a finalised authorisation, reject the \
            payment" @10
    hotspot "How long is the SCA window before a payment becomes RJCT (§5.4)?" @10 +"ask product" +Q-29
    event "Payment rejected" @10
    event "Payment accepted after technical checks" @12 {
      note "transactionStatus = ACTC."
    }
    policy "Whenever core banking reports the booking outcome, record the payment status" @13
    event "Payment reached its final status" @14 +EVT-PAYMENT-FINAL-STATUS-REACHED
    hotspot "Is ACTC the last status the bank reports, or ACSC after booking (§4.14.1)?" @14 +"ask core banking" +Q-28
  }

  lane "ASPSP gateway — Transaction Authorisation" {
    command "Start authorisation" @4
    aggregate "Authorisation" @4
    event "Authorisation started" @4
    command "Record SCA result" @8
    aggregate "Authorisation" @8
    event "Authorisation finalised" @8
    event "Authorisation failed" @8
    readmodel "Authorisation outcome" @9 +RM-AUTHORISATION-OUTCOME
  }

  lane "Bank web journey (login and waiting pages)" {
    ui "Login screen" @6 +SCR-IDP-LOGIN
    ui "Confirm in your bank app" @7 +SCR-CONSENT-AWAIT-APP
    hotspot "Where does a payment redirect land in the browser? The ADR defines the consent \
             screen for access consent only" @7 +"ask architecture" +Q-48
    ui "Outcome and return to the TPP" @9 +SCR-CONSENT-OUTCOME
  }

  lane "Mobile app (SCA screen)" {
    readmodel "Payment details for approval" @7 +RM-PAYMENT-APPROVAL {
      note "Amount, currency, payee name and account, debtor account. The PSU approves exactly \
            these values on the SCA screen — the basis of dynamic linking (SRC-IG §5.1.9)."
    }
    readmodel "SCA prompt with amount and payee" @7 +RM-SCA-PROMPT
    ui "SCA screen" @7 +SCR-APP-SCA
    actor "Account holder" @7
    command "Confirm identity and consent" @7
    command "Reject the payment" @7
    hotspot "Are fees and currency conversion shown on the SCA screen?" @7 +"ask product" +Q-41
    hotspot "Nobody has confirmed that a payment needs no browser approval page" @7 +"ask compliance" +Q-46
  }

  lane "Identity and SCA (Ping Federate, Transmit)" {
    system "Ping Federate" @6
    command "Authenticate PSU" @6
    event "PSU authenticated by the IDP" @6
    system "Transmit" @7
    readmodel "SCA context" @7 +RM-SCA-CONTEXT
    command "Request SCA on an enrolled device with the amount and payee linked" @7
    event "SCA result bound to the amount and payee" @8
  }

  lane "Core banking" {
    system "Core banking" @12
    event "Payment accepted by core banking" @12
    event "Payment booked on the debtor account" @13
    hotspot "No core-banking payment interface is known" @12 +"ask core banking" +Q-06
  }
}
