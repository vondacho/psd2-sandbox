// EXMAP-PIS-INITIATE-SCT — PROPOSAL generated by AI on 2026-09-19. Not yet discussed.
// Examples derive from SRC-IG §5.3.1 (request example: 123.50 EUR, DE40100100103307118608 to
// Merchant123 DE02100100109307118603, "Ref Number Merchant"), §7.1, §14.11.
examplemap "Initiate a SEPA credit transfer" {
  delivery "Walking skeleton" release
  delivery "MVP" release

  story "Initiate a SEPA credit transfer" @"Walking skeleton" +STORY-PIS-INITIATE-SCT {
    as   "PISP"
    want "to submit a SEPA credit transfer for my PSU and get a payment resource back"
    so   "my PSU can pay a merchant straight from the bank account"
    question "Is debtorAccount required, or may the PSU choose the account at the bank?" +"ask product"
    question "Are future-dated payments (requestedExecutionDate) part of the MVP?" +"ask product" +Q-13
    question "Does Verification of Payee run on this call (RVCM/RVNC/RCVC, creditorNameConfirmation)?" +"ask compliance" +Q-16
  }

  rule "A valid SEPA credit transfer creates a payment resource in status RCVD with steering links" +R-PIS-01 {
    example "The spec's example payment is accepted" @"Walking skeleton" {
      given "instructedAmount 123.50 EUR from debtorAccount DE40100100103307118608"
      given "creditorName Merchant123 and creditorAccount DE02100100109307118603"
      given "remittanceInformationUnstructured Ref Number Merchant and PSU-IP-Address 192.168.8.78"
      when  "the PISP posts POST /v1/payments/sepa-credit-transfers"
      then  "the response is 201 Created with transactionStatus RCVD and a paymentId"
      then  "the header ASPSP-SCA-Approach is REDIRECT"
      then  "_links contains scaRedirect, self, status and scaStatus"
    }
  }

  rule "PSU-IP-Address is mandatory on a payment initiation" +R-PIS-02 {
    note "SRC-IG §5.3.1 request header PSU-IP-Address: Mandatory."
    example "A payment without PSU-IP-Address is refused" @"MVP" +edge-case {
      given "the example payment of 123.50 EUR without a PSU-IP-Address header"
      when  "the PISP posts it"
      then  "the response is 400 with code FORMAT_ERROR"
      then  "no payment resource is created"
    }
  }

  rule "Only payment products the bank offers are accepted" +R-PIS-03 {
    note "SRC-IG §14.11.2 PRODUCT_UNKNOWN, PRODUCT_INVALID."
    example "An unsupported product is unknown" @"MVP" +edge-case {
      given "the bank offers sepa-credit-transfers only"
      when  "the PISP posts the example payment to /v1/payments/target-2-payments"
      then  "the response is 404 with code PRODUCT_UNKNOWN"
    }
    question "Which products besides sepa-credit-transfers does the MVP offer?" +"ask product" +Q-13
  }

  rule "Later calls must name the product the payment was created under" +R-PIS-04 {
    note "SRC-IG §7.1 / §5.4: 'It shall be checked by the ASPSP, if the payment-product is matching'."
    example "The status under a different product is not served" @"MVP" +edge-case {
      given "payment 1234-wertiq-983 created under sepa-credit-transfers"
      when  "the PISP reads GET /v1/payments/instant-sepa-credit-transfers/1234-wertiq-983/status"
      then  "no status is returned"
    }
    question "Which code answers a product mismatch — 404 RESOURCE_UNKNOWN, 403, or 400?" +"ask architecture"
  }

  rule "The PSU approves exactly the amount and payee that were submitted" +R-PIS-05 {
    note "Dynamic linking; SRC-IG §5.1.9 mentions it, the RTS article was not supplied."
    question "On which surface does the PSU see the amount and payee? SRC-ADR gives the consent \
              screen no payment page and describes the SCA screen as confirming identity" +"ask compliance" +Q-46
    example "The amount and payee are shown before the PSU confirms" @"Walking skeleton" {
      given "payment 1234-wertiq-983 of 123.50 EUR to Merchant123, DE02100100109307118603"
      when  "the PSU reaches the surface on which the payment is confirmed"
      then  "that surface shows 123.50 EUR, Merchant123 and DE02100100109307118603"
    }
  }
}
