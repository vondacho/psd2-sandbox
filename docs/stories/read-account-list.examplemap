// EXMAP-READ-ACCOUNT-LIST — PROPOSAL generated by AI on 2026-09-19. Not yet discussed.
// Examples derive from SRC-IG §6 (available vs accessible accounts), §6.5.1, §14.11.1, §14.20.
// resourceId 3dc3d5b3-7023-4848-9853-f5400a64e80f is the spec's own example value.
examplemap "Read the accounts a consent covers" {
  delivery "Walking skeleton" release
  delivery "MVP" release

  story "Read the accounts a consent covers" @"Walking skeleton" +STORY-READ-ACCOUNT-LIST {
    as   "AISP"
    want "to list the accounts my consent covers, with a resourceId for each"
    so   "I can address each account without handling raw account numbers in URLs"
    question "Is a resourceId stable across different consents of the same TPP, or only within one?" +"ask architecture" +Q-25
  }

  rule "The list contains only the accounts the consent covers" +R-ACC-01 {
    note "SRC-IG §6 example: available IBAN1 and IBAN2, consent on IBAN1, accessible = IBAN1."
    example "Only the consented IBAN is listed" @"Walking skeleton" {
      given "PSU PSU-1234 holds DE40100100103307118608 and DE02100100109307118603"
      given "a valid consent with balances and transactions on DE40100100103307118608 only"
      when  "the AISP reads GET /v1/accounts with that Consent-ID"
      then  "the response is 200 with one account, DE40100100103307118608"
      then  "the account carries a resourceId and links to balances and transactions"
    }
    example "Balances-only access gives no transactions link" @"MVP" +edge-case {
      given "a valid consent with balances on DE40100100103307118608 and nothing else"
      when  "the AISP reads GET /v1/accounts"
      then  "the account has a balances link"
      then  "the account has no transactions link"
    }
  }

  rule "No accessible account is still a 200 with an empty list" +R-ACC-02 {
    note "SRC-IG §6.5.1 response body 'accounts'."
    example "The only consented account was closed" @"MVP" +edge-case {
      given "a valid consent on DE40100100103307118608"
      given "DE40100100103307118608 has been closed"
      when  "the AISP reads GET /v1/accounts"
      then  "the response is 200 with an empty accounts array"
    }
    question "Should a closed account be listed with status deleted instead of dropped (§14.20 status)?" +"ask product"
  }

  rule "Paths use the resourceId, never the IBAN, and it stays constant for the consent's life" +R-ACC-03 {
    note "SRC-IG §4.11.2 remark (tokenisation), §6.5.2 account-id."
    example "The same resourceId comes back on every read" @"MVP" {
      given "a valid consent on DE40100100103307118608"
      given "the first GET /v1/accounts returned resourceId 3dc3d5b3-7023-4848-9853-f5400a64e80f"
      when  "the AISP reads GET /v1/accounts again the next day"
      then  "DE40100100103307118608 has resourceId 3dc3d5b3-7023-4848-9853-f5400a64e80f"
    }
  }

  rule "Reading requires the Consent-ID of a valid consent of this TPP" +R-ACC-04 {
    note "SRC-IG §6.5.1 Consent-ID mandatory; codes §14.11.1."
    example "A consent still waiting for authorisation cannot be used" @"Walking skeleton" +edge-case {
      given "consent 123cons456 in status received"
      when  "the AISP reads GET /v1/accounts with Consent-ID 123cons456"
      then  "the response is 401 with code CONSENT_INVALID"
    }
    example "An expired consent cannot be used" @"MVP" +edge-case {
      given "consent 123cons456 in status expired"
      when  "the AISP reads GET /v1/accounts with Consent-ID 123cons456"
      then  "the response is 401 with code CONSENT_EXPIRED"
    }
    example "An unknown Consent-ID header is refused" @"MVP" +edge-case {
      given "no consent 999cons999 exists for this TPP"
      when  "the AISP reads GET /v1/accounts with Consent-ID 999cons999"
      then  "the response is 400 with code CONSENT_UNKNOWN"
    }
  }
}
