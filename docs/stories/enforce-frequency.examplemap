// EXMAP-ENFORCE-FREQUENCY — PROPOSAL generated by AI on 2026-09-19. Not yet discussed.
// SRC-IG §6 ("frequency… checked per account… and per PSU"), §6.3.1.1 frequencyPerDay
// ("access without PSU involvement"), §6.5.1 PSU-IP-Address ("if and only if… actively
// initiated by the PSU"), §14.11.3 ACCESS_EXCEEDED.
examplemap "Enforce the daily access frequency" {
  delivery "MVP" release

  story "Enforce the daily access frequency" @"MVP" +STORY-ENFORCE-FREQUENCY {
    as   "AISP"
    want "a clear ACCESS_EXCEEDED answer once I have used today's reads without my PSU"
    so   "I can schedule reads within my consent instead of being blocked silently"
    question "Is 'per day' the bank's calendar day in its local time zone, or a rolling 24 hours?" +"ask compliance"
    question "Does GET /v1/accounts?withBalance count as a read of every listed account?" +"ask compliance"
  }

  rule "Unattended reads per account per day do not exceed frequencyPerDay" +R-FRQ-01 {
    example "The fifth unattended balance read of the day is refused" @"MVP" +edge-case {
      given "a valid consent 123cons456 with frequencyPerDay 4 on DE40100100103307118608 (resourceId 3dc3d5b3-7023-4848-9853-f5400a64e80f)"
      given "four balance reads of that account today without PSU-IP-Address"
      when  "the AISP reads GET /v1/accounts/3dc3d5b3-7023-4848-9853-f5400a64e80f/balances without PSU-IP-Address"
      then  "the response is 429 with code ACCESS_EXCEEDED"
    }
    example "The fourth unattended balance read of the day is served" @"MVP" {
      given "a valid consent 123cons456 with frequencyPerDay 4 on DE40100100103307118608"
      given "three balance reads of that account today without PSU-IP-Address"
      when  "the AISP reads the balances without PSU-IP-Address"
      then  "the response is 200"
    }
  }

  rule "Reads the PSU actively started do not count against the frequency" +R-FRQ-02 +inferred {
    note "Inferred, not stated: frequencyPerDay limits access 'without PSU involvement', and \
          PSU-IP-Address is present exactly when the PSU actively initiated the read. Needs confirmation."
    example "A PSU-initiated read after the limit is served" @"MVP" +edge-case {
      given "four unattended balance reads of DE40100100103307118608 today under consent 123cons456 with frequencyPerDay 4"
      when  "the AISP reads the balances with PSU-IP-Address 192.168.8.78"
      then  "the response is 200"
    }
    question "Is this inference right, and how does the bank tell a genuine PSU-initiated read from a \
              TPP that always sends an IP address?" +"ask compliance"
  }

  rule "The count is kept per account" +R-FRQ-03 {
    example "Exhausting one account leaves the other readable" @"MVP" {
      given "a valid consent with frequencyPerDay 4 on DE40100100103307118608 and DE02100100109307118603"
      given "four unattended balance reads of DE40100100103307118608 today"
      when  "the AISP reads the balances of DE02100100109307118603 without PSU-IP-Address"
      then  "the response is 200"
    }
  }
}
