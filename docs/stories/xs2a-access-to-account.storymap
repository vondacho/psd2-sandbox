// Story map — PSD2 XS2A access to account
// PROPOSAL generated by AI on 2026-09-19. The two delivery bands are *proposed* slices,
// not agreed ones: product owns release commitments (docs/ai/20-review-and-delivery-policy.md).
// Backbone = runs between the pivotal events of docs/journeys/xs2a-big-picture.eventstorm;
// each activity carries the pivotal event that closes it as a tag (+EVT-...).
// Stable story ids are tags (+STORY-...). No #ticket and no ~status is written: the ticketing
// system owns both, and none has been issued.
// Activity "Confirm available funds" is deliberately empty in both bands — see Q-14.
storymap "PSD2 XS2A access to account" {

  delivery "Walking skeleton" release {
    note "WS-01 — docs/delivery/walking-skeleton.md. Proves the technical path end to end; \
          limited business value."
  }
  delivery "MVP" release {
    note "MVP-01 — docs/delivery/mvp.md. Smallest coherent slice covering the mandatory \
          AIS and single-payment PIS endpoints of SRC-IG §4.11 (except funds confirmation, Q-14)."
  }

  activity "Reach the bank as a licensed TPP" +EVT-TPP-IDENTIFIED +ACTV-REACH-BANK {
    persona "AISP"
    persona "PISP"

    step "Connect with a qualified certificate" {
      story "Identify the TPP from its certificate" @"Walking skeleton" +skeleton +STORY-TPP-IDENTIFY {
        as   "AISP"
        want "the bank to recognise me and my PSD2 roles from my QWAC on the TLS connection"
        so   "I can act for my PSUs under my own licence without a separate bank-specific login"
        note "SRC-IG §3, §4.9. Example map: EXMAP-TPP-IDENTIFY."
      }
      story "Refuse services the TPP's roles do not cover" @"MVP" +STORY-TPP-ROLE-CHECK {
        as   "PISP"
        want "a ROLE_INVALID answer when I call a service my certificate does not cover"
        so   "I can tell a licensing problem apart from a technical fault"
      }
      story "Keep each TPP's resources to itself" @"MVP" +STORY-TPP-RESOURCE-ISOLATION {
        as   "AISP"
        want "no other TPP to read or change the consents and payments I created"
        so   "my PSUs' data cannot be reached through another provider's certificate"
        note "SRC-IG §4.11: methods may only apply to resources created by the same TPP."
      }
    }
    step "Sign requests" {
      story "Verify application-layer signatures" +STORY-TPP-SIGNATURE +"ask architecture" {
        as   "PISP"
        want "to know whether the bank requires a QSealC signature on my requests"
        so   "I sign when it is required and do not waste effort when it is not"
        note "Optional for the ASPSP (SRC-IG §4.2). Q-05."
      }
    }
    step "Learn what this bank supports" {
      story "Publish the bank's XS2A profile" @"MVP" +STORY-XS2A-PROFILE {
        as   "AISP"
        want "to read which payment products, SCA approaches, consent models and options this bank supports"
        so   "I can integrate without trial and error"
        note "The spec defers many choices to 'the ASPSP documentation'. \
              Seed: docs/system/api/openapi/xs2a-profile.yaml."
      }
    }
  }

  activity "Grant account access" +EVT-CONSENT-AUTHORISED +ACTV-GRANT-ACCESS {
    persona "Account holder"
    persona "AISP"

    step "Ask for access" {
      story "Request a consent on dedicated accounts" @"Walking skeleton" +skeleton +STORY-CONSENT-DEDICATED {
        as   "AISP"
        want "to ask for access to named accounts, with the access types, validity and daily frequency I need"
        so   "my PSU is asked to approve exactly the access my service uses"
        note "Mandatory in SRC-IG §4.11.4. Example map: EXMAP-CONSENT-DEDICATED."
      }
      story "Request a consent on the list of available accounts" +STORY-CONSENT-AVAILABLE-ACCOUNTS +"ask product" {
        as   "AISP"
        want "to ask only for the list of my PSU's available accounts"
        so   "I can let the PSU choose accounts before asking for detailed access"
        note "Optional (SRC-IG §6.3.1.2). Q-10."
      }
      story "Let the bank choose the accounts with the PSU" +STORY-CONSENT-BANK-OFFERED +"ask product" {
        as   "AISP"
        want "to send empty access lists and let the PSU pick accounts at the bank"
        so   "I do not need to know account numbers in advance"
        note "Optional; not for embedded SCA (SRC-IG §6.3.1.2). Q-10."
      }
      story "Request access to all accounts for all AIS" +STORY-CONSENT-GLOBAL +"ask product" {
        as   "AISP"
        want "to ask for allPsd2 access to all accounts"
        so   "a PSU who wants full aggregation approves once"
        note "Optional (SRC-IG §6.3.1.2). Q-10."
      }
      story "Include the account owner name" +STORY-CONSENT-OWNER-NAME +"ask product" {
        as   "AISP"
        want "to ask for the owner name of the accounts"
        so   "I can verify the account belongs to my PSU"
        note "SRC-IG §6 'Account Owner Name Delivery', §14.18. Q-33."
      }
    }
    step "Authorise at the bank" {
      story "Approve a TPP's request in my bank app after a redirect" @"Walking skeleton" +skeleton +STORY-SCA-REDIRECT-APP {
        as   "Account holder"
        want "to be taken from the TPP to my bank app, authenticate there and approve the request"
        so   "I never give my bank credentials to the TPP"
        note "Default proposal for D-03 (redirect, app-to-app). Example map: EXMAP-SCA-REDIRECT-APP."
      }
      story "See exactly what a TPP will access before I approve" @"MVP" +STORY-SCA-CONSENT-DETAILS {
        as   "Account holder"
        want "to see the TPP's name, the accounts, the kind of access, the end date and how often it may read"
        so   "I approve only what I understand"
        note "SRC-IG §6 'Detailed Consent': the ASPSP displays the consent details during SCA. H-02."
      }
      story "Approve through a push to my bank app" +STORY-SCA-DECOUPLED +"ask architecture" {
        as   "Account holder"
        want "to get a push in my bank app while I stay in the TPP's app"
        so   "I do not have to switch between apps"
        note "Decoupled SCA approach (SRC-IG §6.1.1.3). D-03 / Q-03."
      }
      story "Authorise through the TPP's own screens" +STORY-SCA-EMBEDDED +"ask architecture" {
        as   "AISP"
        want "to collect the PSU's credentials and OTP in my own interface"
        so   "the PSU never leaves my app"
        note "Embedded SCA approach (SRC-IG §6.1.1.4–5). Not proposed: credentials would pass through \
              the TPP. D-03."
      }
      story "Confirm the authorisation with a confirmation code" +STORY-SCA-CONFIRMATION +"ask architecture" {
        as   "AISP"
        want "to send the confirmation code I received on the redirect back to the bank"
        so   "the bank can bind the redirect to my session and resist session fixation"
        note "SRC-IG §7.6. Q-34."
      }
      story "Collect several approvals for one consent" +STORY-SCA-MULTILEVEL {
        as   "AISP"
        want "several PSUs of a corporate to authorise one consent"
        so   "four-eyes rules of corporate customers are met"
        note "Multilevel SCA (SRC-IG §6.3.4). Q-17."
      }
    }
    step "Learn the result" {
      story "Read the consent status after the redirect" @"Walking skeleton" +skeleton +STORY-CONSENT-STATUS {
        as   "AISP"
        want "to read whether the consent is valid, rejected or still received"
        so   "I know whether I may start reading account data"
      }
      story "Read the full consent" @"MVP" +STORY-CONSENT-READ {
        as   "AISP"
        want "to read the consent as the bank stored it, including an adjusted validUntil"
        so   "I plan my reads within what the bank actually granted"
        note "SRC-IG §6.3.3; validUntil may be adjusted by the ASPSP (§6.3.1.1)."
      }
      story "Follow an authorisation's SCA status" @"MVP" +STORY-SCA-STATUS {
        as   "AISP"
        want "to read the scaStatus of each authorisation and list the authorisations of a consent"
        so   "I can tell a PSU still authenticating apart from a failed attempt"
        note "Mandatory GET …/authorisations and …/authorisations/{id} (SRC-IG §7.4, §7.5)."
      }
    }
  }

  activity "Use account data" +EVT-ACCOUNT-DATA-DELIVERED +ACTV-USE-DATA {
    persona "AISP"

    step "List accounts" {
      story "Read the accounts a consent covers" @"Walking skeleton" +skeleton +STORY-READ-ACCOUNT-LIST {
        as   "AISP"
        want "to list the accounts my consent covers, with a resourceId for each"
        so   "I can address each account without handling raw account numbers in URLs"
        note "Example map: EXMAP-READ-ACCOUNT-LIST."
      }
      story "Read one account's details" @"MVP" +STORY-READ-ACCOUNT-DETAILS {
        as   "AISP"
        want "to read the details of one consented account"
        so   "I can show the PSU the account's name, currency and product"
      }
    }
    step "Read balances" {
      story "Read the balances of a consented account" @"MVP" +STORY-READ-BALANCES {
        as   "AISP"
        want "to read the balances of an account my consent covers for balances"
        so   "my PSU sees what is available"
      }
    }
    step "Read transactions" {
      story "Read the transactions of a consented account" @"MVP" +STORY-READ-TRANSACTIONS {
        as   "AISP"
        want "to read booked and pending transactions between two dates"
        so   "my PSU's budget reflects what really happened on the account"
        note "Mandatory (SRC-IG §4.11.2, §6.5.4)."
      }
      story "Read one transaction's details" +STORY-READ-TRANSACTION-DETAILS {
        as   "AISP"
        want "to read the details of one transaction"
        so   "I can show remittance and counterparty data"
        note "Optional (SRC-IG §6.5.5)."
      }
      story "Read card account data" +STORY-READ-CARD-ACCOUNTS {
        as   "AISP"
        want "to read card accounts, balances and card transactions"
        so   "my PSU's credit card spending is included"
        note "Endpoint optional (SRC-IG §4.11.3)."
      }
    }
    step "Stay within the consented frequency" {
      story "Enforce the daily access frequency" @"MVP" +STORY-ENFORCE-FREQUENCY {
        as   "AISP"
        want "a clear ACCESS_EXCEEDED answer once I have used today's reads without my PSU"
        so   "I can schedule reads within my consent instead of being blocked silently"
        note "Example map: EXMAP-ENFORCE-FREQUENCY."
      }
    }
  }

  activity "End account access" +EVT-CONSENT-ENDED +ACTV-END-ACCESS {
    persona "Account holder"
    persona "AISP"

    step "TPP ends access" {
      story "Delete a consent I no longer need" @"Walking skeleton" +skeleton +STORY-CONSENT-DELETE {
        as   "AISP"
        want "to delete a consent when my PSU leaves my service"
        so   "the bank stops granting me access I should no longer have"
        note "SRC-IG §6.4: 204 No Content; consentStatus becomes terminatedByTpp."
      }
    }
    step "PSU withdraws access" {
      story "See which TPPs can access my accounts" @"MVP" +STORY-PSU-ACCESS-OVERVIEW +"ask product" {
        as   "Account holder"
        want "to see in my bank app every TPP that can access my accounts, and until when"
        so   "I stay in control of who sees my data"
        note "Claim in SRC-ADR; depends on D-01. Q-26."
      }
      story "Withdraw a TPP's access from my bank app" @"MVP" +STORY-PSU-REVOKE +"ask product" {
        as   "Account holder"
        want "to withdraw a TPP's access from my bank app"
        so   "the TPP cannot read my accounts any more"
        note "consentStatus revokedByPsu (SRC-IG §4.14.2). Example map: EXMAP-PSU-REVOKE."
      }
    }
    step "Access runs out" {
      story "End access when a consent expires" @"MVP" +STORY-CONSENT-EXPIRY {
        as   "AISP"
        want "a CONSENT_EXPIRED answer once validUntil has passed or a one-off consent has been used"
        so   "I know to ask my PSU for a new consent"
      }
    }
  }

  activity "Authorise a payment" +EVT-PAYMENT-AUTHORISED +ACTV-AUTHORISE-PAYMENT {
    persona "Account holder"
    persona "PISP"

    step "Submit the payment" {
      story "Initiate a SEPA credit transfer" @"Walking skeleton" +skeleton +STORY-PIS-INITIATE-SCT {
        as   "PISP"
        want "to submit a SEPA credit transfer for my PSU and get a payment resource back"
        so   "my PSU can pay a merchant straight from the bank account"
        note "Example map: EXMAP-PIS-INITIATE-SCT."
      }
      story "Initiate an instant SEPA credit transfer" +STORY-PIS-INITIATE-INSTANT +"ask product" {
        as   "PISP"
        want "to submit an instant SEPA credit transfer"
        so   "the merchant is paid within seconds"
        note "Q-13."
      }
      story "Submit a payment as a pain.001 message" +STORY-PIS-PAIN001 {
        as   "PISP"
        want "to post an ISO 20022 pain.001 document"
        so   "I reuse the XML my corporate customers already produce"
        note "SRC-IG §5.3.2. Q-13."
      }
      story "Initiate a bulk payment" +STORY-PIS-BULK {
        as   "PISP"
        want "to submit several payments as one bulk"
        so   "payroll-style batches need one authorisation"
        note "Optional (SRC-IG §5.3.3)."
      }
      story "Set up a standing order" +STORY-PIS-PERIODIC {
        as   "PISP"
        want "to initiate a periodic payment"
        so   "my PSU's recurring rent is paid automatically"
        note "Optional (SRC-IG §5.3.4)."
      }
      story "Check the payee's name before the payment" +STORY-PIS-VOP +"ask compliance" {
        as   "Account holder"
        want "to be warned when the payee name does not match the account"
        so   "I do not pay a fraudster"
        note "SRC-IG v1.3.15 change log, §14.6 creditorNameConfirmation, §14.13 RVCM/RVNC/RCVC. Q-16."
      }
    }
    step "Authorise at the bank" {
      story "Approve a payment in my bank app with the amount and payee shown" @"Walking skeleton" +skeleton +STORY-PIS-SCA-REDIRECT-APP {
        as   "Account holder"
        want "to see the amount and the payee in my bank app and approve exactly that payment"
        so   "my approval cannot be reused for a different payment"
        note "Dynamic linking; SRC-IG §5.1.9 mentions it, the RTS text was not supplied."
      }
      story "Authorise several transactions at once" +STORY-SIGNING-BASKET {
        as   "PISP"
        want "to group payments in a signing basket and authorise them with one SCA"
        so   "my PSU authenticates once for many payments"
        note "Optional (SRC-IG §8)."
      }
    }
  }

  activity "Follow the payment to its outcome" +EVT-PAYMENT-FINAL-STATUS-REACHED +ACTV-FOLLOW-PAYMENT {
    persona "PISP"
    persona "Account holder"

    step "Check the status" {
      story "Read the payment status" @"Walking skeleton" +skeleton +STORY-PIS-STATUS {
        as   "PISP"
        want "to read the transaction status of the payment I initiated"
        so   "I can tell the merchant and my PSU whether the payment went through"
        note "Example map: EXMAP-PIS-STATUS."
      }
      story "Read the payment I initiated" @"MVP" +STORY-PIS-READ-PAYMENT {
        as   "PISP"
        want "to read back the payment resource"
        so   "I can reconcile what the bank holds with what I sent"
        note "Mandatory (SRC-IG §5.6)."
      }
      story "Reject a payment the PSU never authorised in time" @"MVP" +STORY-PIS-SCA-TIMEOUT {
        as   "Account holder"
        want "an abandoned payment to be rejected rather than left open"
        so   "nobody can finish authorising it later without me"
        note "SRC-IG §5.4: RJCT if SCA not completed within the required timeframe. Q-29."
      }
    }
    step "Cancel" {
      story "Cancel a payment before execution" +STORY-PIS-CANCEL +"ask product" {
        as   "PISP"
        want "to cancel a future-dated payment my PSU no longer wants"
        so   "the PSU is not charged"
        note "Optional (SRC-IG §5.7). Q-15."
      }
    }
    step "Be notified" {
      story "Be notified of status changes" +STORY-PIS-NOTIFY {
        as   "PISP"
        want "the bank to call my notification URI when the status changes"
        so   "I do not have to poll"
        note "[XS2A-RSNS] not supplied. Q-24."
      }
    }
  }

  activity "Confirm available funds" +ACTV-CONFIRM-FUNDS {
    persona "Card issuer (PIISP)"

    step "Ask whether funds are available" {
      story "Confirm funds for a card payment" +STORY-PIIS-CONFIRM-FUNDS +"ask compliance" {
        as   "Card issuer (PIISP)"
        want "to ask whether an amount is available on my cardholder's account"
        so   "I can accept or decline the card payment"
        note "POST /funds-confirmations is Mandatory (SRC-IG §4.11.6), but its PIIS consent is \
              defined outside the supplied document. Left empty in both bands on purpose: Q-14."
      }
    }
  }
}
