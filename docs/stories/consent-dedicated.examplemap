// EXMAP-CONSENT-DEDICATED — PROPOSAL generated by AI on 2026-09-19. Not yet discussed by a
// Three Amigos session. Examples derive from SRC-IG §6.3.1.1, §14.17 and the §6.3.1.1 request
// example (IBANs DE40100100103307118608, DE02100100109307118603 are the spec's test data).
examplemap "Request a consent on dedicated accounts" {
  delivery "Walking skeleton" release
  delivery "MVP" release

  story "Request a consent on dedicated accounts" @"Walking skeleton" +STORY-CONSENT-DEDICATED {
    as   "AISP"
    want "to ask for access to named accounts, with the access types, validity and daily frequency I need"
    so   "my PSU is asked to approve exactly the access my service uses"
    question "Which HTTP code and message code refuse a malformed consent definition: \
              400 FORMAT_ERROR or 401 CONSENT_INVALID (§14.11.3)?" +"ask architecture"
  }

  rule "Every access list used names at least one account" +R-CNS-01 {
    note "SRC-IG §6.3.1.1 note; §14.17: an empty array means 'bank-offered', and then all used lists must be empty."
    example "Balances and transactions on one IBAN are accepted" @"Walking skeleton" {
      given "access.balances = [DE40100100103307118608]"
      given "access.transactions = [DE40100100103307118608]"
      given "recurringIndicator true, validUntil 2017-11-01, frequencyPerDay 4"
      when  "the AISP posts the consent"
      then  "the response is 201 Created with consentStatus received"
      then  "the response carries a consentId and a Location header"
    }
    example "A named balances list next to an empty transactions list is refused" @"MVP" +edge-case {
      given "access.balances = [DE40100100103307118608]"
      given "access.transactions = []"
      when  "the AISP posts the consent"
      then  "no consent resource is created"
    }
    question "All lists empty asks for a bank-offered consent, which is not proposed for the MVP — \
              which refusal does the TPP get?" +"ask product" +Q-10
  }

  rule "A balances or transactions access also grants the account list" +R-CNS-02 {
    note "SRC-IG §6.3.1.1 note."
    example "Transactions access alone shows the account in the list" @"MVP" {
      given "a valid consent with access.transactions = [DE40100100103307118608] and no access.accounts"
      when  "the AISP reads GET /v1/accounts"
      then  "the list contains the account DE40100100103307118608"
    }
  }

  rule "frequencyPerDay is at least 1 and at most 4 unless bilaterally agreed" +R-CNS-03 {
    note "SRC-IG §6.3.1.1 frequencyPerDay."
    example "Four reads a day are accepted" @"Walking skeleton" {
      given "a recurring consent request with frequencyPerDay 4"
      when  "the AISP posts the consent"
      then  "the response is 201 Created"
    }
    example "Five reads a day are refused without a bilateral agreement" @"MVP" +edge-case {
      given "a recurring consent request with frequencyPerDay 5"
      given "no bilateral agreement with the TPP"
      when  "the AISP posts the consent"
      then  "no consent resource is created"
    }
    example "Zero reads a day are refused" @"MVP" +edge-case {
      given "a consent request with frequencyPerDay 0"
      when  "the AISP posts the consent"
      then  "no consent resource is created"
    }
    question "Will the bank offer any bilateral agreement above 4 reads a day?" +"ask product" +Q-11
  }

  rule "A one-off consent reads once" +R-CNS-04 {
    note "SRC-IG §6.3.1.1: 'For a one-off access, this attribute is set to 1'; §6 one-off access may be \
          denied after a first read or after an ASPSP-defined time (e.g. 20 minutes)."
    example "A one-off consent with frequencyPerDay 1 is accepted" @"MVP" {
      given "recurringIndicator false and frequencyPerDay 1"
      when  "the AISP posts the consent"
      then  "the response is 201 Created"
    }
    question "A one-off consent sent with frequencyPerDay 4: refuse it, or store 1?" +"ask architecture"
    question "How long after authorisation is a one-off consent usable?" +"ask product" +Q-12
  }

  rule "validUntil may be shortened by the bank; 9999-12-31 asks for the maximum" +R-CNS-05 {
    note "SRC-IG §6.3.1.1 validUntil."
    example "A request for the maximum validity shows the bank's own end date" @"MVP" {
      given "a recurring consent request with validUntil 9999-12-31"
      when  "the consent is authorised and the AISP reads GET /v1/consents/{consentId}"
      then  "validUntil is the bank's maximum end date, not 9999-12-31"
    }
    question "What is the bank's maximum consent validity? [EBA-FR] is cited but was not supplied" +"ask compliance" +Q-11
  }

  rule "Authorising a new recurring consent ends the former recurring consent of the same TPP and PSU" +R-CNS-06 {
    note "SRC-IG §6.3.1.1 side effects."
    example "The second recurring consent replaces the first" @"MVP" {
      given "consent A, recurring and valid, for PSU PSU-1234 and TPP PSDES-BDE-3DFD21"
      given "consent B, recurring, for the same PSU and TPP"
      when  "the PSU authorises consent B"
      then  "consent B is valid"
      then  "account reads with consent A are refused"
    }
    example "A one-off consent leaves the recurring consent alone" @"MVP" +edge-case {
      given "consent A, recurring and valid, for PSU PSU-1234 and TPP PSDES-BDE-3DFD21"
      given "consent C, one-off, for the same PSU and TPP"
      when  "the PSU authorises consent C"
      then  "consent A is still valid"
    }
    question "Does consent A become 'expired' (§6.3.1.1) or 'terminatedByTpp' (§4.14.2)?" +"ask compliance" +Q-08
  }

  rule "A combined AIS/PIS session is refused while sessions are not offered" +R-CNS-07 {
    note "SRC-IG §9, §14.11.3 SESSIONS_NOT_SUPPORTED. Assumes sessions are out of the MVP (A-11)."
    example "combinedServiceIndicator true is refused" @"MVP" +edge-case {
      given "a consent request with combinedServiceIndicator true"
      when  "the AISP posts the consent"
      then  "the response is 400 with code SESSIONS_NOT_SUPPORTED"
    }
  }
}
