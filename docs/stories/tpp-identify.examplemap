// EXMAP-TPP-IDENTIFY — PROPOSAL generated by AI on 2026-09-19. No Three Amigos session has
// discussed this map. Every example is derived from a statement in SRC-IG (cited in a note);
// none is accepted until product, QA and development review it (gate G3).
// Rule ids are tags (+R-...). Test data (organizationIdentifier, IBANs) are the spec's own examples.
examplemap "Identify the TPP from its certificate" {
  delivery "Walking skeleton" release
  delivery "MVP" release

  story "Identify the TPP from its certificate" @"Walking skeleton" +STORY-TPP-IDENTIFY {
    as   "AISP"
    want "the bank to recognise me and my PSD2 roles from my QWAC on the TLS connection"
    so   "I can act for my PSUs under my own licence without a separate bank-specific login"
    question "Is an unusable QWAC refused at the TLS handshake, or with HTTP 401 and a \
              CERTIFICATE_* code? §4.13.1 allows omitting headers before functional processing" +"ask architecture"
    question "Does anyone check the TPP's current authorisation in the NCA / EBA register, and \
              is that Finologee or the bank?" +"ask architecture" +Q-05
  }

  rule "A request is served only over mutual TLS with a qualified website certificate" +R-TPP-01 {
    note "SRC-IG §3."
    example "A TPP with a valid QWAC carrying PSP_AI is identified" @"Walking skeleton" {
      given "a QWAC for organizationIdentifier PSDES-BDE-3DFD21 with the role PSP_AI"
      when  "the TPP posts a consent over mutual TLS with that certificate"
      then  "the request is processed for TPP PSDES-BDE-3DFD21"
    }
    example "A connection without a client certificate is refused" @"Walking skeleton" +edge-case {
      given "a TLS client that presents no certificate"
      when  "it calls POST /v1/consents"
      then  "no consent resource is created"
    }
    question "Which HTTP answer, if any, does a TPP get when its QWAC has been revoked?" +"ask architecture"
  }

  rule "A TPP may use only the services its certificate roles cover" +R-TPP-02 {
    note "SRC-IG §3 (roles in certificate), §14.11.1 ROLE_INVALID."
    example "An AISP-only certificate cannot initiate a payment" @"MVP" +edge-case {
      given "a QWAC for PSDES-BDE-3DFD21 carrying only the role PSP_AI"
      when  "the TPP posts a payment to /v1/payments/sepa-credit-transfers"
      then  "the response is 401 with code ROLE_INVALID"
      then  "no payment resource is created"
    }
    example "A PISP certificate can initiate a payment" @"Walking skeleton" {
      given "a QWAC for PSDES-BDE-3DFD21 carrying the role PSP_PI"
      when  "the TPP posts a payment to /v1/payments/sepa-credit-transfers"
      then  "the response is 201 Created"
    }
  }

  rule "The legal owner of the certificate, not the brand in OU, owns consents and payments" +R-TPP-03 {
    note "SRC-IG §4.9 note."
    example "Two brand certificates of one legal TPP address the same consent" @"MVP" {
      given "consent 123cons456 created with a QWAC for PSDES-BDE-3DFD21 whose OU is BrandA"
      when  "the TPP reads consent 123cons456 with another QWAC for PSDES-BDE-3DFD21 whose OU is BrandB"
      then  "the consent is returned"
    }
    question "Will the bank show the OU brand to the PSU during SCA, or only the legal name? \
              The ASPSP may ignore OU (§4.9)" +"ask product"
  }

  rule "A TPP can only address resources it created" +R-TPP-04 {
    note "SRC-IG §4.11; codes §14.11.1."
    example "Another TPP cannot read a consent it did not create" @"MVP" +edge-case {
      given "consent 123cons456 created by PSDES-BDE-3DFD21"
      when  "TPP PSDFR-ACPR-12345 reads GET /v1/consents/123cons456"
      then  "the consent is not returned"
    }
    question "403 CONSENT_UNKNOWN (§14.11.1 'if path') or 404 (§4.12 'when in doubt… use 404')?" +"ask architecture"
  }
}
