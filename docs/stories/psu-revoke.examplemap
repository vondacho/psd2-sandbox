// EXMAP-PSU-REVOKE — PROPOSAL generated by AI on 2026-09-19. Not yet discussed.
// The story itself is a stakeholder claim (SRC-ADR consent section) whose scope is open (Q-26)
// and whose data owner depends on D-01. Examples derive from SRC-IG §4.14.2 and §14.15.
examplemap "Withdraw a TPP's access from my bank app" {
  delivery "MVP" release

  story "Withdraw a TPP's access from my bank app" @"MVP" +STORY-PSU-REVOKE +"ask product" {
    as   "Account holder"
    want "to withdraw a TPP's access from my bank app"
    so   "the TPP cannot read my accounts any more"
    question "Is revoking in the mobile app in scope for the MVP at all?" +"ask product" +Q-26
    question "Which system holds the consent the app revokes — bank, Finologee, or Ping/Transmit?" +"ask architecture" +Q-01
    question "Should the TPP be told when the PSU revokes (resource status notification is not in the \
              supplied spec)?" +"ask product" +Q-24
  }

  rule "A PSU can revoke a valid consent they granted" +R-REV-01 {
    example "The PSU revokes an AISP's access" @"MVP" {
      given "consent 123cons456, valid, granted by PSU PSU-1234 to Sandbox AISP Ltd"
      when  "PSU PSU-1234 revokes Sandbox AISP Ltd's access in the bank app on 2026-10-01"
      then  "consent 123cons456 has consentStatus revokedByPsu"
      then  "consent 123cons456 has lastActionDate 2026-10-01"
    }
    example "A PSU cannot revoke another PSU's consent" @"MVP" +edge-case {
      given "consent 123cons456, valid, granted by PSU PSU-1234"
      when  "PSU PSU-5678 looks at their TPP access in the bank app"
      then  "consent 123cons456 is not shown"
    }
    question "Can a PSU revoke a consent that is still 'received' (not yet authorised)?" +"ask product"
  }

  rule "After revocation every read with that consent is refused" +R-REV-02 {
    example "The AISP's next read fails" @"MVP" {
      given "consent 123cons456 in status revokedByPsu"
      when  "Sandbox AISP Ltd reads GET /v1/accounts with Consent-ID 123cons456"
      then  "the response is a 401"
      then  "no account data is returned"
    }
    question "Which message code: CONSENT_INVALID or CONSENT_EXPIRED? Neither names revocation" +"ask architecture" +Q-09
  }

  rule "Revocation is final" +R-REV-03 {
    example "A revoked consent cannot be authorised again" @"MVP" +edge-case {
      given "consent 123cons456 in status revokedByPsu"
      when  "Sandbox AISP Ltd posts POST /v1/consents/123cons456/authorisations"
      then  "consent 123cons456 still has consentStatus revokedByPsu"
    }
    question "What does DELETE /v1/consents/123cons456 answer on a consent the PSU already revoked?" +"ask architecture"
  }

  rule "The overview shows who can see what, and until when" +R-REV-04 {
    example "The overview lists one AISP" @"MVP" {
      given "PSU PSU-1234 has consent 123cons456 to Sandbox AISP Ltd on DE40100100103307118608 for balances and transactions until 2017-11-01"
      when  "PSU PSU-1234 opens the TPP access overview in the bank app"
      then  "the overview shows Sandbox AISP Ltd, DE40100100103307118608, balances and transactions, until 2017-11-01"
    }
  }
}
