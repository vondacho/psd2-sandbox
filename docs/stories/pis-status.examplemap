// EXMAP-PIS-STATUS — PROPOSAL generated by AI on 2026-09-19. Not yet discussed.
// SRC-IG §4.12 (status reads return 200 regardless of payment state), §4.14.1, §5.4, §14.11.2, §14.13.
examplemap "Read the payment status" {
  delivery "Walking skeleton" release
  delivery "MVP" release

  story "Read the payment status" @"Walking skeleton" +STORY-PIS-STATUS {
    as   "PISP"
    want "to read the transaction status of the payment I initiated"
    so   "I can tell the merchant and my PSU whether the payment went through"
    question "Which end status does the bank report — ACTC, ACCP, ACFC or ACSC?" +"ask core banking" +Q-28
    question "Will the bank use PDNG, and how often may a PISP poll the status?" +"ask architecture"
  }

  rule "A status read answers 200 even when the payment failed" +R-PST-01 {
    example "A rejected payment's status is read successfully" @"MVP" {
      given "payment 1234-wertiq-983 in transactionStatus RJCT"
      when  "the PISP reads GET /v1/payments/sepa-credit-transfers/1234-wertiq-983/status"
      then  "the response is 200 with transactionStatus RJCT"
    }
  }

  rule "A finalised authorisation takes the payment to at least ACTC" +R-PST-02 {
    note "SRC-IG §4.14.1: ACTC = authentication, syntactical and semantical checks successful."
    example "The approved example payment is technically accepted" @"Walking skeleton" {
      given "payment 1234-wertiq-983 of 123.50 EUR whose authorisation 123auth456 has scaStatus finalised"
      when  "the PISP reads the status"
      then  "transactionStatus is ACTC"
    }
  }

  rule "A payment whose SCA is not completed in time is rejected" +R-PST-03 {
    note "SRC-IG §5.4 remark on RJCT."
    example "An abandoned payment becomes RJCT" @"MVP" +edge-case {
      given "payment 1234-wertiq-983 in transactionStatus RCVD with authorisation 123auth456 in scaStatus received"
      given "the SCA window has passed"
      when  "the PISP reads the status"
      then  "transactionStatus is RJCT"
    }
    question "How long is the SCA window?" +"ask product" +Q-29
  }

  rule "A payment rejected for missing funds after acceptance says so" +R-PST-04 {
    note "SRC-IG §14.11.2 FUNDS_NOT_AVAILABLE, used with 200 and RJCT."
    example "Missing funds found during processing" @"MVP" +edge-case {
      given "payment 1234-wertiq-983 accepted with ACTC"
      given "core banking rejects it for insufficient funds"
      when  "the PISP reads the status"
      then  "the response is 200 with transactionStatus RJCT"
      then  "tppMessages contains code FUNDS_NOT_AVAILABLE"
    }
    question "Does the bank wait for funds (TPP-Rejection-NoFunds-Preferred false) or reject at once?" +"ask core banking"
  }
}
