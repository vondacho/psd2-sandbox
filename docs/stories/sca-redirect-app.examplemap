// EXMAP-SCA-REDIRECT-APP — PROPOSAL generated by AI on 2026-09-19. Not yet discussed.
// Assumes D-03 resolves to the redirect SCA approach with an implicit start (SRC-IG §6.1.1.1);
// if D-03 decides otherwise, this map must be re-run.
examplemap "Approve a TPP's request in my bank app after a redirect" {
  delivery "Walking skeleton" release
  delivery "MVP" release

  story "Approve a TPP's request in my bank app after a redirect" @"Walking skeleton" +STORY-SCA-REDIRECT-APP {
    as   "Account holder"
    want "to be taken from the TPP to my bank app, authenticate there and approve the request"
    so   "I never give my bank credentials to the TPP"
    question "What happens when the device that follows scaRedirect has no bank app installed?" +"ask product" +Q-21
    question "Which of Ping or Transmit runs the approval journey?" +"ask iam" +Q-07
  }

  rule "A received consent comes back with a redirect link and an implicitly created authorisation" +R-SCA-01 {
    note "SRC-IG §6.3.1.1 'Response in case of a redirect'; §4.6 implicit start."
    example "The consent response carries scaRedirect and scaStatus links" @"Walking skeleton" {
      given "the AISP posts a valid dedicated-account consent with TPP-Redirect-URI https://www.example-TPP.com/xs2a-client/v1/cb"
      when  "the bank answers"
      then  "the header ASPSP-SCA-Approach is REDIRECT"
      then  "_links contains scaRedirect, status and scaStatus"
      then  "the authorisation behind scaStatus has scaStatus received"
    }
    example "An explicit-start preference returns a startAuthorisation link instead" @"MVP" +edge-case {
      given "the AISP sends TPP-Explicit-Authorisation-Preferred true"
      when  "the bank answers"
      then  "_links contains startAuthorisation and no scaRedirect"
    }
    note "TPP-Explicit-Authorisation-Preferred may be ignored if signing baskets are not offered (§6.3.1.1)."
  }

  rule "The PSU approves exactly what the TPP asked for" +R-SCA-02 {
    note "SRC-IG §6 'Detailed Consent': the ASPSP displays the consent details during SCA."
    example "The approval screen shows the consent details" @"MVP" {
      given "consent 123cons456 from Sandbox AISP Ltd for balances and transactions on DE40100100103307118608, valid until 2017-11-01, 4 reads a day"
      when  "the PSU opens the approval screen"
      then  "the screen shows Sandbox AISP Ltd, DE40100100103307118608, balances and transactions, 2017-11-01 and 4 reads a day"
    }
    question "Is the legal name enough, or must the brand name be shown too (H-02)?" +"ask product"
  }

  rule "A finalised authorisation makes the consent valid; a failed one rejects it" +R-SCA-03 {
    note "SRC-IG §14.15, §14.16."
    example "The PSU approves" @"Walking skeleton" {
      given "consent 123cons456 in status received with authorisation 123auth567 in status received"
      when  "the PSU authenticates in the bank app and approves"
      then  "authorisation 123auth567 has scaStatus finalised"
      then  "consent 123cons456 has consentStatus valid"
      then  "the PSU is sent to https://www.example-TPP.com/xs2a-client/v1/cb"
    }
    example "The PSU declines" @"MVP" +edge-case {
      given "consent 123cons456 in status received with authorisation 123auth567 in status received"
      when  "the PSU declines in the bank app"
      then  "authorisation 123auth567 has scaStatus failed"
      then  "consent 123cons456 has consentStatus rejected"
    }
    example "The PSU fails authentication" @"MVP" +edge-case {
      given "consent 123cons456 in status received"
      when  "the PSU fails authentication in the bank app"
      then  "authorisation 123auth567 has scaStatus failed"
      then  "consent 123cons456 has consentStatus rejected"
    }
    question "How long may a consent stay 'received' before it is rejected, and does a timeout set \
              scaStatus failed?" +"ask product" +Q-29
    question "May the PSU retry after one failed authentication on the same consent?" +"ask iam"
  }

  rule "A failed PSU is sent to TPP-Nok-Redirect-URI when the TPP gave one" +R-SCA-04 {
    note "SRC-IG §6.3.1.1 TPP-Nok-Redirect-URI (may be ignored by the ASPSP)."
    example "Decline goes to the nok URI" @"MVP" +edge-case {
      given "TPP-Nok-Redirect-URI https://www.example-TPP.com/xs2a-client/v1/nok on the consent request"
      when  "the PSU declines in the bank app"
      then  "the PSU is sent to https://www.example-TPP.com/xs2a-client/v1/nok"
    }
    example "A redirect URI outside the certificate's domain is still accepted in v1.3.16" @"MVP" +edge-case {
      given "a QWAC for example-TPP.com"
      given "TPP-Redirect-URI https://other-domain.com/cb"
      when  "the AISP posts the consent"
      then  "the response is 201 Created"
    }
    note "SRC-IG §4.10: 'ASPSPs in future may reject… This is not yet valid for the current version'."
  }

  rule "A final authorisation accepts no further updates" +R-SCA-05 {
    note "SRC-IG §14.16 (finalised, failed, exempted are final), §14.11.1 SCA_INVALID and STATUS_INVALID."
    example "An update after a failed SCA is refused" @"MVP" +edge-case {
      given "authorisation 123auth567 with scaStatus failed"
      when  "the AISP sends PUT /v1/consents/123cons456/authorisations/123auth567"
      then  "the response is 400 with code SCA_INVALID"
    }
    question "Is the confirmation call (§7.6, scaStatus unconfirmed) required by the bank?" +"ask architecture" +Q-34
  }
}
