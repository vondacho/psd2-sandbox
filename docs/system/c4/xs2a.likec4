// C4 model — PSD2 XS2A access to account (LikeC4)
// PROPOSAL generated by AI on 2026-09-19. Current state = elements named in SRC-ADR.
// Proposed future state = elements tagged #proposed. Allocations nobody has decided carry
// #undecided and name the decision (D-xx) in their metadata.
// metadata.cmp = component id, metadata.ctx = owning bounded context (docs/domain/*.ddd),
// metadata.stories = stories that justify the element (docs/stories/*.storymap).
// Iteration 2: PSU-facing screens are elements of kind appScreen / webScreen nested inside
// the container that manages them; metadata.scr and metadata.readmodels use the SCR-/RM- ids
// defined in docs/journeys/service-blueprint.md.
// Iteration 3 (SRC-ADR 87c72b8): the consent screen (grant / revoke, presented in the TPP web
// application) replaces the SCA redirect entry point; its provider — ASPSP gateway or Finologee —
// is undecided (D-01), so it is modelled as a neutral system tagged #undecided. The mobile app keeps
// only the last-factor screen. Withdrawn ids: docs/system/README.md §3.2a and blueprint §7.

specification {
  element actor {
    style {
      shape person
      color green
    }
  }
  element system
  element container
  element component
  element database {
    style {
      shape storage
    }
  }
  element appScreen {
    style {
      shape mobile
      color amber
    }
  }
  element webScreen {
    style {
      shape browser
      color amber
    }
  }

  tag vendor
  tag bank
  tag external
  tag proposed
  tag undecided
  tag skeleton
  tag mvp
}

model {

  psu = actor 'Account holder (PSU)' {
    description 'Bank customer who uses a TPP and authorises its requests'
    metadata {
      actor 'ACT-PSU'
    }
  }

  tpp = system 'Third-Party Provider (AISP / PISP)' {
    #external #skeleton #mvp
    description 'Licensed TPP calling the Berlin Group XS2A interface with its eIDAS QWAC'
    metadata {
      cmp 'CMP-TPP'
      ctx 'CTX-TPP'
    }

    tppRequest = webScreen 'TPP request screen' {
      #external
      description 'The TPP explains what it will access or pay, then sends the PSU to the bank (not designed by the bank)'
      metadata {
        scr 'SCR-TPP-REQUEST'
      }
    }
    tppResult = webScreen 'TPP result screen' {
      #external
      description 'The TPP shows the outcome after the PSU returns (not designed by the bank)'
      metadata {
        scr 'SCR-TPP-RESULT'
        readmodels 'RM-TPP-CONSENT-STATUS RM-TPP-PAYMENT-STATUS'
      }
    }
  }

  trust = system 'Qualified trust services and NCA registers' {
    #external
    description 'Issue and revoke QWAC/QSealC; register TPP authorisations. Who consults them is open (Q-05)'
    metadata {
      cmp 'CMP-TRUST-SERVICES'
      decisions 'Q-05'
    }
  }

  finologee = system 'Finologee PSD2 gateway' {
    #vendor #skeleton #mvp
    description 'Chosen PSD2 gateway: intermediary between the ASPSP and TPPs; OIDC/OAuth 2.0 (SRC-ADR)'
    metadata {
      cmp 'CMP-FINOLOGEE-GW'
      ctx 'CTX-TPP-ACCESS'
      decisions 'D-01 D-02 D-05'
      stories 'STORY-TPP-IDENTIFY STORY-TPP-ROLE-CHECK'
    }
  }

  consentScreen = system 'Consent screen' {
    #undecided #proposed #skeleton #mvp
    technology 'Web frontend + backend, presented in the TPP web application (redirect or embedded: Q-44)'
    description 'Lets the PSU grant or revoke a TPP access and approve requests (SRC-ADR). Provided by the ASPSP gateway (in-house) or by Finologee — undecided (D-01)'
    metadata {
      cmp 'CMP-CONSENT-SCREEN'
      ctx 'CTX-CONSENT'
      decisions 'D-01 Q-44 Q-47'
      stories 'STORY-SCA-REDIRECT-APP STORY-PIS-SCA-REDIRECT-APP STORY-SCA-CONSENT-DETAILS STORY-SCA-OUTCOME STORY-SCA-REQUEST-UNAVAILABLE STORY-SCA-NO-APP STORY-PSU-REVOKE'
    }

    identify = webScreen 'Identify yourself' {
      #skeleton #mvp #undecided
      description 'First factor(s) before the app last factor — which and how: Q-45'
      metadata {
        scr 'SCR-CONSENT-IDENTIFY'
        readmodels 'RM-REDIRECT-SESSION RM-SCA-CONTEXT'
      }
    }
    grantAccess = webScreen 'Grant access' {
      #skeleton #mvp
      metadata {
        scr 'SCR-CONSENT-ACCESS'
        readmodels 'RM-CONSENT-APPROVAL'
      }
    }
    approvePayment = webScreen 'Approve payment' {
      #skeleton #mvp #undecided
      description 'Assumed: the ADR names only access consent (Q-46)'
      metadata {
        scr 'SCR-CONSENT-PAYMENT'
        readmodels 'RM-PAYMENT-APPROVAL'
      }
    }
    awaitApp = webScreen 'Confirm in your bank app' {
      #skeleton #mvp
      metadata {
        scr 'SCR-CONSENT-AWAIT-APP'
        readmodels 'RM-AUTHORISATION-OUTCOME'
      }
    }
    outcome = webScreen 'Outcome and return' {
      #mvp
      metadata {
        scr 'SCR-CONSENT-OUTCOME'
        readmodels 'RM-AUTHORISATION-OUTCOME'
      }
    }
    unavailable = webScreen 'Request no longer available' {
      #mvp
      metadata {
        scr 'SCR-CONSENT-UNAVAILABLE'
        readmodels 'RM-REDIRECT-SESSION RM-AUTHORISATION-OUTCOME'
      }
    }
    noApp = webScreen 'You need the bank app to confirm' {
      #undecided
      description 'Unscheduled — options open (Q-21)'
      metadata {
        scr 'SCR-CONSENT-NO-APP'
        readmodels 'RM-SCA-CONTEXT'
      }
    }
    manage = webScreen 'What this provider can see' {
      #mvp
      description 'How the PSU reaches it to revoke is open (Q-43)'
      metadata {
        scr 'SCR-CONSENT-MANAGE'
        readmodels 'RM-PSU-TPP-ACCESS'
      }
    }
    revokeConfirm = webScreen 'Withdraw access?' {
      #mvp
      metadata {
        scr 'SCR-CONSENT-REVOKE-CONFIRM'
        readmodels 'RM-PSU-TPP-ACCESS'
      }
    }
  }

  bank = system 'Bank' {
    #bank
    description 'The ASPSP'

    gateway = container 'ASPSP gateway' {
      #bank #proposed #skeleton #mvp
      technology 'Built in house (SRC-ADR); proposed as one deployable, modular by bounded context (D-06)'
      description 'Implements the XS2A resource model behind the PSD2 gateway'
      metadata {
        cmp 'CMP-ASPSP-GW'
        decisions 'D-05 D-06'
      }

      edge = component 'XS2A API adapter' {
        #proposed #skeleton #mvp
        description 'Anticorruption layer between the Finologee integration contract and the XS2A resource model; X-Request-ID, error mapping (tppMessages)'
        metadata {
          cmp 'CMP-XS2A-ADAPTER'
          ctx 'CTX-TPP-ACCESS'
          stories 'STORY-TPP-IDENTIFY STORY-TPP-RESOURCE-ISOLATION STORY-XS2A-PROFILE'
          interfaces 'API-XS2A-PROFILE'
        }
      }

      consentModule = component 'Consent module' {
        #proposed #undecided #skeleton #mvp
        description 'AIS consent resources and lifecycle; this-TPP access and revoke for the consent screen'
        metadata {
          cmp 'CMP-CONSENT'
          ctx 'CTX-CONSENT'
          decisions 'D-01'
          stories 'STORY-TPP-RESOURCE-ISOLATION STORY-CONSENT-DEDICATED STORY-CONSENT-STATUS STORY-CONSENT-READ STORY-CONSENT-DELETE STORY-CONSENT-EXPIRY STORY-PSU-REVOKE STORY-PSU-ACCESS-OVERVIEW'
        }
      }

      authorisationModule = component 'Authorisation module' {
        #proposed #skeleton #mvp
        description 'Authorisation sub-resources, scaStatus, SCA approach, redirect session, link to Identity and SCA'
        metadata {
          cmp 'CMP-AUTHORISATION'
          ctx 'CTX-TXN-AUTHORISATION'
          decisions 'D-03'
          stories 'STORY-SCA-REDIRECT-APP STORY-SCA-STATUS STORY-PIS-SCA-REDIRECT-APP'
        }
      }

      paymentModule = component 'Payment initiation module' {
        #proposed #skeleton #mvp
        description 'Payment initiation resources and transactionStatus'
        metadata {
          cmp 'CMP-PAYMENT'
          ctx 'CTX-PAYMENT-INITIATION'
          stories 'STORY-TPP-RESOURCE-ISOLATION STORY-PIS-INITIATE-SCT STORY-PIS-STATUS STORY-PIS-READ-PAYMENT STORY-PIS-SCA-TIMEOUT'
        }
      }

      accountModule = component 'Account information module' {
        #proposed #skeleton #mvp
        description 'Consented account list, details, balances, transactions; resourceId map; daily access allowance'
        metadata {
          cmp 'CMP-ACCOUNT-INFO'
          ctx 'CTX-ACCOUNT-INFORMATION'
          stories 'STORY-READ-ACCOUNT-LIST STORY-READ-ACCOUNT-DETAILS STORY-READ-BALANCES STORY-READ-TRANSACTIONS STORY-ENFORCE-FREQUENCY'
        }
      }

      coreAdapter = component 'Core banking adapter' {
        #proposed #skeleton #mvp
        description 'Anticorruption layer to core banking; a stub in the walking skeleton until Q-06 is answered'
        metadata {
          cmp 'CMP-CORE-ADAPTER'
          ctx 'CTX-ACCOUNT-INFORMATION'
          decisions 'Q-06'
          stories 'STORY-READ-BALANCES STORY-READ-TRANSACTIONS STORY-READ-ACCOUNT-DETAILS STORY-READ-ACCOUNT-LIST STORY-PIS-INITIATE-SCT'
        }
      }

      psuChannel = component 'PSU channel API' {
        #proposed #skeleton #mvp
        description 'Backend of the consent screen if D-01 goes in-house; in any case serves the app last-factor prompt (API-PSU-CHANNEL)'
        metadata {
          cmp 'CMP-PSU-CHANNEL-API'
          ctx 'CTX-TXN-AUTHORISATION'
          decisions 'D-01 D-10'
          readmodels 'RM-CONSENT-APPROVAL RM-PAYMENT-APPROVAL RM-AUTHORISATION-OUTCOME RM-PSU-TPP-ACCESS RM-REDIRECT-SESSION RM-LAST-FACTOR-PROMPT'
          interfaces 'API-PSU-CHANNEL'
          stories 'STORY-SCA-REDIRECT-APP STORY-PIS-SCA-REDIRECT-APP STORY-SCA-CONSENT-DETAILS STORY-SCA-OUTCOME STORY-SCA-REQUEST-UNAVAILABLE STORY-PSU-REVOKE'
        }
      }

      outbox = component 'Domain event outbox' {
        #proposed #undecided #mvp
        description 'Publishes consent, authorisation and payment status changes (AsyncAPI xs2a-domain-events)'
        metadata {
          cmp 'CMP-EVENT-OUTBOX'
          decisions 'D-04'
          interfaces 'API-XS2A-EVENTS'
        }
      }

      store = database 'XS2A resource store' {
        #proposed #skeleton #mvp
        description 'Consents, authorisations, payment initiations, resource maps, access allowances'
        metadata {
          cmp 'CMP-XS2A-STORE'
        }
      }
    }

    mobileApp = container 'Mobile banking app' {
      #bank #skeleton #mvp
      description 'Own mobile app; in the PSD2 journey it only carries the last SCA authentication factor (SRC-ADR 87c72b8)'
      metadata {
        cmp 'CMP-MOBILE-APP'
        ctx 'CTX-MOBILE-BANKING'
        decisions 'D-10 Q-45'
        stories 'STORY-SCA-REDIRECT-APP STORY-PIS-SCA-REDIRECT-APP'
      }

      lastFactor = appScreen 'Confirm it is you' {
        #skeleton #mvp
        description 'Biometric / PIN on the registered device; shows what is being confirmed (amount and payee for payments: Q-46)'
        metadata {
          scr 'SCR-APP-LAST-FACTOR'
          readmodels 'RM-LAST-FACTOR-PROMPT'
        }
      }
    }

    ping = container 'Ping Federate' {
      #vendor #skeleton #mvp
      description 'Bank IDP and internal access-token issuer (SRC-ADR, SRC-Q)'
      metadata {
        cmp 'CMP-PING'
        ctx 'CTX-CUSTOMER-IDENTITY'
        decisions 'D-02 Q-07'
      }
    }

    transmit = container 'Transmit' {
      #vendor #skeleton #mvp
      description 'CIAM: authentication journeys and device management (SRC-ADR)'
      metadata {
        cmp 'CMP-TRANSMIT'
        ctx 'CTX-CUSTOMER-IDENTITY'
        decisions 'Q-07'
      }
    }

    core = container 'Core banking' {
      #bank
      description 'Accounts, bookings, payment execution. Interface unknown (Q-06)'
      metadata {
        cmp 'CMP-CORE-BANKING'
        ctx 'CTX-CORE-BANKING'
      }
    }

    observability = container 'Observability platform' {
      #bank #undecided
      description 'Traces, metrics and logs for the XS2A path. Platform not named in supplied context (Q-22)'
      metadata {
        cmp 'CMP-OBSERVABILITY'
        decisions 'Q-22'
        readmodels 'RM-OPS-SCA-FUNNEL RM-OPS-XS2A-HEALTH'
      }
    }
  }

  // ---- relationships
  psu -> tpp 'uses the TPP service'
  psu -> consentScreen 'grants / revokes access, approves requests'
  psu -> bank.mobileApp 'confirms with the last factor'

  tpp -> finologee 'calls XS2A over mTLS with QWAC' {
    #skeleton
  }
  finologee -> trust 'validates certificates? (Q-05)'
  finologee -> bank.gateway.edge 'forwards identified TPP requests (contract unknown, Q-04)' {
    #skeleton #undecided
  }

  bank.gateway.edge -> bank.gateway.consentModule 'consent commands and queries'
  bank.gateway.edge -> bank.gateway.authorisationModule 'authorisation sub-resource calls'
  bank.gateway.edge -> bank.gateway.paymentModule 'payment initiation calls'
  bank.gateway.edge -> bank.gateway.accountModule 'account reads with Consent-ID'

  bank.gateway.authorisationModule -> bank.gateway.consentModule 'authorisation finalised / failed'
  bank.gateway.authorisationModule -> bank.gateway.paymentModule 'authorisation finalised / failed'
  bank.gateway.accountModule -> bank.gateway.consentModule 'is this read allowed?'
  bank.gateway.accountModule -> bank.gateway.coreAdapter 'accounts, balances, transactions'
  bank.gateway.paymentModule -> bank.gateway.coreAdapter 'submit payment, read outcome'
  bank.gateway.coreAdapter -> bank.core 'core banking interface (unknown, Q-06)'

  bank.gateway.consentModule -> bank.gateway.store 'reads/writes'
  bank.gateway.authorisationModule -> bank.gateway.store 'reads/writes'
  bank.gateway.paymentModule -> bank.gateway.store 'reads/writes'
  bank.gateway.accountModule -> bank.gateway.store 'reads/writes'
  bank.gateway.outbox -> bank.gateway.store 'reads outbox'
  bank.gateway.outbox -> bank.observability 'status-change events for audit and metrics'

  bank.gateway.authorisationModule -> bank.ping 'verify SCA result / bank token (D-02, Q-07)' {
    #undecided
  }
  bank.transmit -> bank.ping 'federation (Q-07)'
  bank.gateway -> bank.observability 'traces, metrics, logs'

  // ---- screens, read models and the consent-screen backend (iterations 2–3)
  psu -> tpp.tppRequest 'starts at the TPP'
  tpp.tppRequest -> consentScreen.identify 'scaRedirect (redirect or embedded, Q-44)'
  consentScreen.identify -> bank.transmit 'first factor(s) (Q-45)' {
    #undecided
  }
  consentScreen -> bank.gateway.psuChannel 'backend if in-house (D-01)' {
    #undecided
  }
  consentScreen -> finologee 'backend if Finologee (D-01)' {
    #undecided
  }
  consentScreen.awaitApp -> bank.mobileApp.lastFactor 'last factor on the registered device (push / QR / app link, Q-45)'
  bank.mobileApp.lastFactor -> bank.transmit 'last factor (RM-SCA-CONTEXT)'
  bank.mobileApp.lastFactor -> bank.gateway.psuChannel 'reads RM-LAST-FACTOR-PROMPT (D-10)'
  consentScreen.outcome -> tpp.tppResult 'back to TPP-Redirect-URI / Nok URI'
  consentScreen.unavailable -> tpp.tppResult 'back to TPP-Nok-Redirect-URI'
  bank.gateway.psuChannel -> bank.gateway.authorisationModule 'approval requests, decisions, redirect sessions, last-factor prompts'
  bank.gateway.psuChannel -> bank.gateway.consentModule 'consent details; this TPP access; revoke'
  bank.gateway.psuChannel -> bank.gateway.paymentModule 'payment details'
  bank.gateway.psuChannel -> bank.gateway.coreAdapter 'account labels (Q-37)'

}

views {

  view index {
    title 'System context — PSD2 XS2A'
    description 'Who talks to whom. Current-state elements come from SRC-ADR; #proposed elements are this proposal.'
    include *
    include bank.gateway, bank.mobileApp, bank.ping, bank.transmit, bank.core
    exclude bank.observability
  }

  view containers of bank {
    title 'Containers — the bank side of XS2A'
    include *
    include tpp, finologee, psu, consentScreen
  }

  view gateway of bank.gateway {
    title 'Components — ASPSP gateway (modules by bounded context)'
    include *
    include finologee, bank.core, bank.mobileApp, consentScreen, bank.ping, bank.observability
  }

  view walkingSkeleton {
    title 'WS-01 — walking skeleton path'
    description 'Elements and relationships exercised by WS-01 (docs/delivery/walking-skeleton.md)'
    include
      psu,
      tpp,
      finologee,
      bank.gateway.edge,
      bank.gateway.consentModule,
      bank.gateway.authorisationModule,
      bank.gateway.paymentModule,
      bank.gateway.accountModule,
      bank.gateway.coreAdapter,
      bank.gateway.store,
      bank.gateway.psuChannel,
      consentScreen,
      bank.mobileApp,
      bank.transmit,
      bank.ping
  }

  view psuScreens {
    title 'PSU screens and the components that manage them'
    description 'Screens (amber) nested in the element that manages them; the consent screen provider is undecided (D-01). Edges name the read model each screen needs (docs/journeys/service-blueprint.md)'
    include
      psu,
      tpp,
      tpp.*,
      consentScreen,
      consentScreen.*,
      finologee,
      bank.mobileApp,
      bank.mobileApp.*,
      bank.gateway.psuChannel,
      bank.gateway.authorisationModule,
      bank.gateway.consentModule,
      bank.gateway.paymentModule,
      bank.gateway.coreAdapter,
      bank.transmit,
      bank.ping
  }

  view mvp {
    title 'MVP-01 — elements in the MVP slice'
    include element.tag = #mvp
    include psu
  }
}
