@startuml ws-01-ais-consent-redirect
' WS-01 walking-skeleton path, AIS part. PROPOSAL generated by AI on 2026-09-19.
' Stories: STORY-TPP-IDENTIFY, STORY-CONSENT-DEDICATED, STORY-SCA-REDIRECT-APP,
'          STORY-CONSENT-STATUS, STORY-READ-ACCOUNT-LIST, STORY-CONSENT-DELETE.
' Assumes D-03 = redirect with implicit start (SRC-IG §6.1.1.1) and D-01 = consent in the ASPSP
' gateway. Where D-02 (token) is open, the Finologee -> gateway hop is shown as "identified request".
' Iteration 3 (SRC-ADR 87c72b8): approval on the consent screen (provider undecided, D-01; shown with
' the in-house backend CMP-PSU-CHANNEL-API); the mobile app carries only the last SCA factor.
title WS-01 — AIS consent with redirect SCA, then account list

actor "Account holder\n(test PSU)" as PSU
participant "Test AISP\n(CMP-TPP)" as TPP
participant "Finologee\n(CMP-FINOLOGEE-GW)" as FIN
box "ASPSP gateway (CMP-ASPSP-GW)" #F5F5F5
  participant "XS2A adapter\n(CMP-XS2A-ADAPTER)" as ADP
  participant "Consent\n(CMP-CONSENT)" as CNS
  participant "Authorisation\n(CMP-AUTHORISATION)" as AUT
  participant "Account info\n(CMP-ACCOUNT-INFO)" as ACC
  participant "Core adapter\n(stub)" as CORE
end box
participant "Consent screen\n(CMP-CONSENT-SCREEN,\nprovider D-01)" as CS
participant "Mobile app\n(CMP-MOBILE-APP,\nlast factor only)" as APP
participant "Transmit / Ping\n(CMP-TRANSMIT, CMP-PING)" as IAM

== Create consent (EXMAP-CONSENT-DEDICATED R-CNS-01) ==
TPP -> FIN : POST /v1/consents (mTLS, test QWAC PSP_AI)\nX-Request-ID, PSU-IP-Address, TPP-Redirect-URI
FIN -> FIN : identify TPP from QWAC (Q-05)
FIN -> ADP : identified request (contract unknown, Q-04)
ADP -> CNS : create consent
CNS -> CNS : check INV-CNS-02, INV-CNS-03
CNS -> AUT : start authorisation (implicit)
AUT --> CNS : authorisationId, scaStatus=received
CNS --> ADP : consentId, consentStatus=received
ADP --> FIN : 201, ASPSP-SCA-Approach: REDIRECT,\n_links: scaRedirect, status, scaStatus
FIN --> TPP : 201 Created

== Authorise (EXMAP-SCA-REDIRECT-APP R-SCA-01..03) ==
TPP -> PSU : redirect to scaRedirect (or embedded, Q-44)
PSU -> CS : open consent screen
CS -> AUT : resolve redirect session (RM-REDIRECT-SESSION)
CS -> IAM : first factor(s) (Q-45) — SCR-CONSENT-IDENTIFY
CS -> AUT : consent details (RM-CONSENT-APPROVAL) — SCR-CONSENT-ACCESS
PSU -> CS : approve
CS -> AUT : approve + subject digest
AUT -> IAM : request last factor on registered device (Q-45)
CS --> PSU : SCR-CONSENT-AWAIT-APP
IAM -> APP : push / QR / app link (Q-45)
APP -> AUT : read RM-LAST-FACTOR-PROMPT
PSU -> APP : confirm it's you (SCR-APP-LAST-FACTOR)
APP -> IAM : last factor
IAM -> AUT : SCA result bound to subject digest
AUT -> AUT : INV-AUT-01, INV-AUT-05
AUT -> CNS : authorisation finalised
CNS -> CNS : consentStatus := valid (INV-CNS-01)
CS --> PSU : SCR-CONSENT-OUTCOME, back to TPP-Redirect-URI

== Read status and accounts (R-ACC-01, R-ACC-04) ==
TPP -> FIN : GET /v1/consents/{consentId}/status
FIN -> ADP
ADP -> CNS
CNS --> TPP : 200 consentStatus=valid
TPP -> FIN : GET /v1/accounts (Consent-ID)
FIN -> ADP
ADP -> ACC : list accounts
ACC -> CNS : is read allowed? (INV-CNS-06)
ACC -> CORE : accounts of PSU (stub, Q-06)
ACC -> ACC : map to resourceIds (INV-ACC-01)
ACC --> TPP : 200 accounts[1] with resourceId and links

== End (STORY-CONSENT-DELETE) ==
TPP -> FIN : DELETE /v1/consents/{consentId}
FIN -> ADP
ADP -> CNS : terminate
CNS --> TPP : 204 No Content (consentStatus=terminatedByTpp)
@enduml
