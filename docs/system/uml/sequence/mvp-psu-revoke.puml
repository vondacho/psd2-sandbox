@startuml mvp-psu-revoke
' MVP-01: PSU withdraws a TPP's access on the consent screen, after the IDP login screen.
' PROPOSAL, AI. Entry points are a proposal (Q-43); the screen is a Bank ASPSP surface (SRC-ADR)
' and the consent state is drawn in house, which is the D-01 recommendation.
' Stories: STORY-PSU-REVOKE.
title MVP-01 — PSU withdraws a TPP's access on the consent screen (consent state in house, D-01)

actor "Account holder" as PSU
participant "AISP web application" as TPPW
participant "Consent screen\n(CMP-CONSENT-SCREEN)" as CS
participant "Ping (IDP login screen)" as IAM
participant "PSU channel API\n(CMP-PSU-CHANNEL-API)" as CH
participant "Consent module\n(CMP-CONSENT)" as CNS
participant "Event outbox\n(CMP-EVENT-OUTBOX)" as OUT
participant "AISP" as TPP
participant "Account info\n(CMP-ACCOUNT-INFO)" as ACC

PSU -> TPPW : "manage bank access"
TPPW -> CS : open consent screen (entry points: Q-43)
CS -> IAM : SCR-IDP-LOGIN — authenticate the PSU
CS -> CH : this TPP's access (RM-PSU-TPP-ACCESS)
CH -> CNS : consents of PSU for Sandbox AISP Ltd
CNS --> CS : DE40…8608, balances+transactions, until 2017-11-01
PSU -> CS : withdraw access (SCR-CONSENT-REVOKE-CONFIRM)
CS -> CH : revoke 123cons456
CH -> CNS : revoke
CNS -> CNS : valid -> revokedByPsu (INV-CNS-01), lastActionDate := today
CNS -> OUT : ConsentStatusChanged(revokedByPsu)
note right of OUT : No TPP notification in MVP (Q-24).\nEvent feeds audit and metrics only.
CS --> PSU : shown as withdrawn

TPP -> ACC : GET /v1/accounts (Consent-ID 123cons456)
ACC -> CNS : is read allowed? (RM-ACCESS-DECISION)
CNS --> ACC : no — revokedByPsu
ACC --> TPP : 401 (message code open, Q-09)
@enduml
