@startuml ws-01-pis-sct-redirect
' WS-01 walking-skeleton path, PIS part; reused unchanged by MVP-01. PROPOSAL, AI.
' Stories: STORY-PIS-INITIATE-SCT, STORY-PIS-SCA-REDIRECT-APP, STORY-PIS-STATUS.
' Redirect, implicit start (SRC-IG §5.1.3). VoP not shown (Q-16).
' SRC-ADR names no surface that shows the PSU the amount and payee before confirming, which
' dynamic linking requires. This diagram draws them on the SCA screen as ONE candidate answer to
' Q-46, marked as such; the browser leg is Q-48. Neither is settled.
title WS-01 — single SEPA credit transfer with redirect SCA

actor "Account holder\n(test PSU)" as PSU
participant "Test PISP\n(CMP-TPP)" as TPP
participant "Finologee\n(CMP-FINOLOGEE-GW)" as FIN
box "ASPSP gateway (CMP-ASPSP-GW)" #F5F5F5
  participant "XS2A adapter" as ADP
  participant "Payment\n(CMP-PAYMENT)" as PAY
  participant "Authorisation\n(CMP-AUTHORISATION)" as AUT
  participant "Core adapter\n(stub)" as CORE
end box
participant "Bank web journey\n(login, waiting, outcome)" as CS
participant "Mobile app\n(SCA screen)" as APP
participant "Ping (IDP)" as PING
participant "Transmit (CIAM)" as CIAM

TPP -> FIN : POST /v1/payments/sepa-credit-transfers\n123.50 EUR, DE40…8608 -> Merchant123 DE02…8603
FIN -> ADP : identified request
ADP -> PAY : initiate
PAY -> AUT : start authorisation (implicit)
PAY --> TPP : 201 transactionStatus=RCVD, paymentId,\n_links: scaRedirect, self, status, scaStatus

TPP -> PSU : redirect to scaRedirect
PSU -> PING : SCR-IDP-LOGIN (login screen)
PING --> CS : authenticated PSU — SCR-CONSENT-AWAIT-APP (Q-48)
AUT -> CIAM : ask for SCA, subject digest of amount and payee linked (INV-AUT-05)
CIAM -> APP : present the SCA screen
note over APP
  Q-46: which surface shows the PSU the amount
  and payee is not defined. Drawn here on the
  SCA screen as one candidate, not as a decision.
end note
APP -> AUT : read RM-SCA-PROMPT
PSU -> APP : confirm identity (SCR-APP-SCA)
APP -> CIAM : SCA result
CIAM -> PING : SCA assertion
PING -> AUT : SCA result bound to subject digest
AUT -> PAY : authorisation finalised
PAY -> CORE : submit payment (stub, Q-06)
CORE --> PAY : accepted
PAY -> PAY : transactionStatus := ACTC

alt SCA window passed without finalisation (INV-PAY-03, Q-29)
  PAY -> PAY : transactionStatus := RJCT
end

TPP -> FIN : GET /v1/payments/sepa-credit-transfers/{paymentId}/status
FIN -> ADP
ADP -> PAY
PAY --> TPP : 200 transactionStatus=ACTC
@enduml
