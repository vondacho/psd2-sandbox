@startuml authorisation-screen-flow
' Screen flow — authorise a TPP request (consent or payment). PROPOSAL, AI, 2026-09-19.
' Iteration 3 (SRC-ADR 87c72b8): approval on the consent screen (provider D-01); the mobile app
' carries only the last SCA factor, often on another device than the browser.
' Screens (SCR-*) and read models (RM-*) are defined in docs/journeys/service-blueprint.md.
title Authorise a TPP request — screens, managing component, read model

state "SCR-TPP-REQUEST\n<i>TPP</i>" as TppReq
state "Redirect token valid?" as Link <<choice>>
state "SCR-CONSENT-UNAVAILABLE\n<i>CMP-CONSENT-SCREEN · RM-REDIRECT-SESSION</i>" as Unavailable
state "SCR-CONSENT-IDENTIFY\n<i>CMP-CONSENT-SCREEN · RM-SCA-CONTEXT (factors: Q-45)</i>" as Identify
state "Purpose" as Purpose <<choice>>
state "SCR-CONSENT-ACCESS\n<i>CMP-CONSENT-SCREEN · RM-CONSENT-APPROVAL</i>" as Access
state "SCR-CONSENT-PAYMENT\n<i>CMP-CONSENT-SCREEN · RM-PAYMENT-APPROVAL (Q-46)</i>" as Payment
state "Registered app?" as HasApp <<choice>>
state "SCR-CONSENT-NO-APP\n<i>CMP-CONSENT-SCREEN — unscheduled, Q-21</i>" as NoApp #line.dashed
state "Last factor" as LF {
  state "SCR-CONSENT-AWAIT-APP\n<i>browser · CMP-CONSENT-SCREEN · RM-AUTHORISATION-OUTCOME</i>" as Await
  state "SCR-APP-LAST-FACTOR\n<i>bank app · CMP-MOBILE-APP · RM-LAST-FACTOR-PROMPT</i>" as AppLF
  Await -right-> AppLF : push / QR / app link (Q-45)
}
state "SCR-CONSENT-OUTCOME\n<i>CMP-CONSENT-SCREEN · RM-AUTHORISATION-OUTCOME</i>" as Outcome
state "SCR-TPP-RESULT\n<i>TPP · RM-TPP-CONSENT-STATUS / RM-TPP-PAYMENT-STATUS</i>" as TppResult

[*] --> TppReq
TppReq --> Link : follow scaRedirect\n(redirect or embedded, Q-44)
Link --> Identify : open, SCA window open
Link --> Unavailable : unknown / expired / used
Identify --> Purpose : identified
Identify --> Outcome : failed / cancelled
Purpose --> Access : consent
Purpose --> Payment : payment
Access --> HasApp : approve
Payment --> HasApp : approve
Access --> Outcome : decline
Payment --> Outcome : decline
HasApp --> LF : yes
HasApp --> NoApp : no
LF --> Outcome : confirmed / rejected /\ntimed out (Q-29)
Outcome --> TppResult : "Back to ⟨TPP⟩"\n(Redirect-URI or Nok-URI)
Unavailable --> TppResult : "Back to ⟨TPP⟩" (Nok-URI)
TppResult --> [*]

note right of Outcome
  Outcome screen versus immediate return is open (Q-39).
  WS-01 returns immediately; MVP-01 proposes this screen.
end note
note left of Access
  Partial approval — Q-36. Account not held — Q-35.
end note
@enduml
